// The queue drawer. Drag geometry is shared with the native input tests.
import { LineEdit, ListView } from "std-widgets.slint";
import { TrackRow } from "model.slint";
import { Theme, LayoutMetrics, PreferenceRow, LibraryButton } from "theme.slint";
import { EmptyState, ActionMenu, SongRow, Cover } from "components.slint";

// Each row tests the captured pointer against its actual bounds, including section
// headings. Coordinates are window-relative so scrolling does not shift the pointer.
export component QueueItem inherits Rectangle {
    in property <bool> live: false;
    in property <bool> reorder-enabled: true;
    in property <bool> collection-enabled: false;
    callback add-playlist();
    in property <bool> enabled: true;
    in property <TrackRow> track;
    in property <int> index;
    in property <int> current-index;
    in property <bool> heading;
    in property <bool> light-mode;
    in property <int> drag-source: -1;
    in property <bool> drag-recommended;
    in property <bool> drag-in-list;
    in property <length> drag-x;
    in property <length> drag-y;
    in property <int> drag-revision;
    in property <bool> press-active;
    in property <length> press-x;
    in property <length> press-y;
    callback select();
    callback remove();
    callback requeue(bool);
    in property <bool> can-move-up: false;
    in property <bool> can-move-down: false;
    callback move-by(int);
    callback radio();
    callback artist();
    callback hit(int, bool);
    callback hover(int, int);
    private property <bool> press-hit: root.press-active && root.index > root.current-index
        && root.press-x >= song.absolute-position.x && root.press-x < song.absolute-position.x + 44px
        && root.press-y >= song.absolute-position.y && root.press-y < song.absolute-position.y + LayoutMetrics.queue-row-height;
    changed press-hit => { if root.press-hit { root.hit(root.index, root.track.recommended); } }
    private property <int> hover-half: root.drag-in-list && root.drag-source >= 0 && root.index > root.current-index && root.track.recommended == root.drag-recommended
        && root.drag-x >= self.absolute-position.x && root.drag-x < self.absolute-position.x + self.width
        && root.drag-y >= self.absolute-position.y && root.drag-y < self.absolute-position.y + self.height
        ? (root.drag-y < song.absolute-position.y + LayoutMetrics.queue-row-height / 2 ? 0 : 1) : -1;
    private property <int> insertion-index: root.index + root.hover-half;
    private property <int> final-index: root.insertion-index - (root.insertion-index > root.drag-source ? 1 : 0);
    private property <{ revision: int, half: int }> hover-state: { revision: root.drag-revision, half: root.hover-half };
    changed hover-state => { root.hover(root.index, root.hover-half); }
    height: song.height + (root.heading ? LayoutMetrics.queue-heading-height : 0px);
    VerticalLayout {
        spacing: 0px;
        if root.heading : Text {
            height: LayoutMetrics.queue-heading-height;
            text: root.index == root.current-index ? "Now playing" : root.track.recommended ? "Autoplay" : "Up next";
            color: Theme.cover-ink;
            font-size: 10px;
            font-weight: 650;
            vertical-alignment: center;
        }
        song := SongRow {
            collection-enabled: root.collection-enabled;
            enabled: root.enabled;
            track: root.track;
            index: root.index;
            current: root.index == root.current-index;
            live: root.live;
            light-mode: root.light-mode;
            removable: true;
            draggable: root.reorder-enabled && root.index > root.current-index;
            dragging: root.drag-source == root.index;
            drag-in-progress: root.drag-source >= 0;
            show-duration: true;
            select => { root.select(); }
            remove => { root.remove(); }
            queue(next) => { root.requeue(next); }
            can-move-up: root.can-move-up;
            can-move-down: root.can-move-down;
            move-by(delta) => { root.move-by(delta); }
            radio => { root.radio(); }
            artist => { root.artist(); }
            add-playlist => { root.add-playlist(); }
        }
    }
    if root.hover-half >= 0 && root.final-index != root.drag-source : Rectangle {
        y: root.hover-half == 0 ? song.y : parent.height - 3px;
        height: 3px;
        background: Theme.accent-ink;
        border-radius: 1.5px;
    }
}

export component QueueDrawer inherits Rectangle {
    in property <bool> live: false;
    in property <string> source-name;
    in-out property <string> query;
    in property <[int]> matches;
    callback filter-changed();
    private property <bool> filter-open: false;
    private property <bool> filtering: root.query != "";
    changed query => { root.cancel-drag(); root.artwork-scroll-y = 0px; }

    in-out property <bool> related-open: false;
    in property <bool> related-enabled: false;
    in property <[TrackRow]> related-rows;
    in property <string> related-note;
    callback load-related();
    callback add-related(int);
    in property <bool> collection-enabled: false;
    callback add-playlist(int);
    in-out property <length> artwork-scroll-y;
    in-out property <length> artwork-view-height;
    in property <bool> enabled: true;
    in property <[TrackRow]> rows;
    in property <int> current-index;
    in property <bool> light-mode;
    in property <bool> autoplay-enabled;
    in property <bool> repeat-enabled;
    callback close();
    callback select(int);
    callback remove(int);
    callback requeue(int, bool);
    callback reorder(int, int);
    callback radio(int);
    callback artist(int);
    callback toggle-autoplay();
    callback toggle-repeat();
    callback shuffle();
    callback clear();
    private property <int> drag-source: -1;
    private property <bool> drag-recommended: false;
    private property <length> drag-x;
    private property <length> drag-y;
    private property <int> hover-row: -1;
    private property <int> hover-half: -1;
    private property <bool> release-pending: false;
    private property <bool> press-active: false;
    private property <length> press-x;
    private property <length> press-y;
    private property <int> drag-revision: 0;
    function cancel-drag() {
        root.drag-source = -1;
        root.release-pending = false;
        root.hover-row = -1;
        root.hover-half = -1;
        root.press-active = false;
    }
    function update-drag-pointer(x: length, y: length) {
        root.drag-x = x;
        root.drag-y = y;
        root.hover-row = -1;
        root.hover-half = -1;
        root.drag-revision += 1;
    }
    changed rows => { root.cancel-drag(); }
    changed current-index => { root.cancel-drag(); root.artwork-scroll-y = 0px; }
    changed visible => { if !root.visible { root.cancel-drag(); } }
    background: transparent;
    TouchArea { }
    changed enabled => { if !root.enabled { root.cancel-drag(); queue-menu.close(); } }
    queue-menu := ActionMenu {
        x: max(0px, root.width - self.width - 14px); y: 48px;
        light-mode: root.light-mode; separator-after: 1;
        items: [
            { title: "Shuffle upcoming", code: 4, enabled: root.enabled && root.rows.length > 1 },
            { title: root.repeat-enabled ? "Turn repeat off" : "Repeat queue", code: 5, enabled: root.enabled },
            { title: "Clear queue", code: 3, enabled: root.enabled && root.rows.length > 0 },
        ];
        chosen(code) => { if root.enabled { if code == 4 { root.shuffle(); } if code == 5 { root.toggle-repeat(); } if code == 3 { root.clear(); } } }
    }

    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        HorizontalLayout {
            height: 34px;
            spacing: 7px;
            cross-axis-alignment: center;
            VerticalLayout {
                horizontal-stretch: 1; min-width: 0px; alignment: center;
                Text { text: root.related-open ? "Related" : "Queue"; color: Theme.text; font-size: 20px; font-weight: 600; }
                if !root.related-open && root.rows.length > 0 && root.source-name != "" : Text {
                    text: "From " + root.source-name; color: Theme.muted; font-size: 11px; overflow: elide;
                }
            }
            LibraryButton { width: 66px; height: 30px; light-mode: root.light-mode; caption: root.related-open ? "Queue" : "Related"; label: root.related-open ? "Back to the queue" : "See songs related to the current track"; enabled: root.related-enabled && root.enabled; active: root.related-open; clicked => { root.cancel-drag(); root.related-open = !root.related-open; if root.related-open { root.load-related(); } } }
            if !root.related-open : LibraryButton { width: 30px; height: 30px; show-tooltip: true; light-mode: root.light-mode; active: root.filter-open || root.filtering; icon-path: "M 16 10 A 6 6 0 1 0 4 10 A 6 6 0 1 0 16 10 M 14 14 L 21 21"; label: "Search queue"; clicked => { root.filter-open = !root.filter-open; if !root.filter-open { root.query = ""; root.filter-changed(); } } }
            if !root.related-open : LibraryButton { width: 30px; height: 30px; enabled: root.enabled; caption: "..."; label: "More queue actions"; light-mode: root.light-mode; clicked => { queue-menu.show(); } }
            LibraryButton { width: 30px; height: 30px; enabled: root.enabled; caption: "×"; label: "Close queue drawer"; light-mode: root.light-mode; clicked => { root.cancel-drag(); root.close(); } }
        }
        if !root.related-open && (root.filter-open || root.filtering) : HorizontalLayout {
            height: 34px; spacing: 6px;
            LineEdit { horizontal-stretch: 1; text <=> root.query; edited => { root.filter-changed(); } placeholder-text: "Search queue"; accessible-label: "Filter queue by title, artist or album"; }
            if root.filtering : LibraryButton { width: 30px; height: 30px; caption: "×"; label: "Clear queue search"; light-mode: root.light-mode; clicked => { root.query = ""; root.filter-changed(); } }
        }
        if !root.related-open && root.filtering : Text { height: 16px; text: "Clear search to reorder songs"; color: Theme.muted; font-size: 11px; }
        if !root.related-open && root.filtering && root.matches.length == 0 : EmptyState { vertical-stretch: 1; light-mode: root.light-mode; heading: "No matching songs"; detail: "Try another title, artist or album."; }
        if root.related-open : Text { text: root.related-note; wrap: word-wrap; color: Theme.muted; font-size: 12px; accessible-live-region: polite; }
        if root.related-open : ListView {
            vertical-stretch: 1; accessible-label: "Related songs";
            for track[index] in root.related-rows : HorizontalLayout {
                height: 56px; spacing: 12px; cross-axis-alignment: center;
                Cover { width: 40px; height: 40px; artwork: track.artwork; light-mode: root.light-mode; seed: track.title; }
                VerticalLayout {
                    horizontal-stretch: 1; min-width: 0px; alignment: center;
                    Text { text: track.title; overflow: elide; color: Theme.text; font-size: 14px; }
                    Text { text: track.artist; overflow: elide; color: Theme.muted; font-size: 12px; }
                }
                LibraryButton { width: 36px; height: 34px; light-mode: root.light-mode; caption: "+"; label: "Add " + track.title + " to the queue"; enabled: root.enabled; clicked => { root.add-related(index); } }
            }
        }
        // The fixed rail owns pointer capture while ListView recycles song rows.
        if !root.related-open && root.rows.length > 0 && (!root.filtering || root.matches.length > 0) : queue-area := Rectangle {
            vertical-stretch: 1;
            private property <bool> drag-in-list: root.drag-x >= self.absolute-position.x && root.drag-x < self.absolute-position.x + queue-list.visible-width
                && root.drag-y >= self.absolute-position.y && root.drag-y < self.absolute-position.y + queue-list.visible-height;
            Timer {
                interval: 30ms;
                running: root.drag-source >= 0 && queue-area.drag-in-list && !root.release-pending;
                triggered => {
                    if root.drag-y < queue-list.absolute-position.y + 40px {
                        queue-list.content-y = min(0px, queue-list.content-y + 14px);
                    } else if root.drag-y > queue-list.absolute-position.y + queue-list.visible-height - 40px {
                        queue-list.content-y = max(min(0px, queue-list.visible-height - queue-list.content-height), queue-list.content-y - 14px);
                    }
                    root.update-drag-pointer(root.drag-x, root.drag-y);
                }
            }
            Timer {
                interval: 1ms;
                running: root.release-pending;
                triggered => {
                    let source = root.drag-source;
                    let insertion = root.hover-row + root.hover-half;
                    let target = insertion - (insertion > source ? 1 : 0);
                    let valid = source >= 0 && queue-area.drag-in-list && root.hover-row >= 0 && root.hover-half >= 0;
                    root.cancel-drag();
                    if valid && target != source { root.reorder(source, target); }
                }
            }
            queue-list := ListView {
                content-y <=> root.artwork-scroll-y;
                changed visible-height => { root.artwork-view-height = self.visible-height; }
                width: parent.width;
                height: parent.height;
                accessible-label: "Playback queue including manual choices and autoplay";
                mouse-drag-pan-enabled: false;
                horizontal-scrollbar-policy: always-off;
                for visible-index in (root.filtering ? root.matches.length : max(0, root.rows.length - max(0, root.current-index))) : QueueItem {
                    collection-enabled: root.collection-enabled;
                    width: queue-list.visible-width;
                    enabled: root.enabled;
                    index: root.filtering ? root.matches[visible-index] : visible-index + max(0, root.current-index);
                    track: root.rows[self.index];
                    reorder-enabled: !root.filtering;
                    current-index: root.current-index;
                    live: root.live;
                    light-mode: root.light-mode;
                    heading: root.filtering ? (visible-index == 0 || self.index == root.current-index + 1 || self.track.recommended != root.rows[root.matches[max(0, visible-index - 1)]].recommended) : (self.index == max(0, root.current-index) || self.index == root.current-index + 1 || self.track.recommended != root.rows[max(0, self.index - 1)].recommended);
                    drag-source: root.drag-source;
                    drag-recommended: root.drag-recommended;
                    drag-in-list: queue-area.drag-in-list;
                    drag-x: root.drag-x;
                    drag-y: root.drag-y;
                    drag-revision: root.drag-revision;
                    press-active: root.press-active;
                    press-x: root.press-x;
                    press-y: root.press-y;
                    select => { root.select(self.index); }
                    remove => { root.remove(self.index); }
                    requeue(next) => { root.requeue(self.index, next); }
                    // Moves stay within the song's own section, as with dragging.
                    can-move-up: !root.filtering && self.index - 1 > root.current-index && root.rows[self.index - 1].recommended == self.track.recommended;
                    can-move-down: !root.filtering && self.index + 1 < root.rows.length && root.rows[self.index + 1].recommended == self.track.recommended;
                    move-by(delta) => { root.cancel-drag(); root.reorder(self.index, self.index + delta); }
                    radio => { root.radio(self.index); }
                    artist => { root.artist(self.index); }
                    add-playlist => { root.add-playlist(self.index); }
                    hover(row-index, half) => {
                        if half >= 0 { root.hover-row = row-index; root.hover-half = half; }
                        else if root.hover-row == row-index { root.hover-row = -1; root.hover-half = -1; }
                    }
                    hit(row-index, recommended) => {
                        if root.press-active && root.drag-source < 0 {
                            root.drag-source = row-index;
                            root.drag-recommended = recommended;
                            root.press-active = false;
                        }
                    }
                }
            }
            rail := TouchArea {
                enabled: root.enabled && !root.filtering;
                x: 0px;
                y: 0px;
                width: min(44px, parent.width);
                height: queue-list.visible-height;
                mouse-cursor: self.pressed && root.drag-source >= 0 ? grabbing : grab;
                accessible-role: button;
                accessible-label: "Drag upcoming songs by their handles to reorder within their queue section";
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        root.cancel-drag();
                        root.press-x = self.absolute-position.x + self.mouse-x;
                        root.press-y = self.absolute-position.y + self.mouse-y;
                        root.update-drag-pointer(root.press-x, root.press-y);
                        root.press-active = true;
                    } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                        root.update-drag-pointer(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        root.release-pending = true;
                    } else if event.kind == PointerEventKind.cancel {
                        root.cancel-drag();
                    }
                }
                moved => {
                    if self.pressed { root.update-drag-pointer(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
                }
                scroll-event(event) => {
                    if root.drag-source < 0 {
                        queue-list.content-y = max(min(0px, queue-list.visible-height - queue-list.content-height), min(0px, queue-list.content-y + event.delta-y));
                    }
                    return accept;
                }
            }
        }
        if !root.related-open && root.rows.length == 0 : EmptyState { vertical-stretch: 1; light-mode: root.light-mode; heading: "Queue is empty"; detail: "Choose a song or playlist to start listening."; }
        if !root.related-open : PreferenceRow { title: "Autoplay"; checked: root.autoplay-enabled; enabled: root.enabled; light-mode: root.light-mode; toggled => { root.toggle-autoplay(); } }
    }
}
