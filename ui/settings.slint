// Settings building blocks: a category rail, grouped cards and the controls
// that sit inside them. The sheet itself lives in main.slint, where it can
// bind directly to the window's preference properties.
import { Button, CheckBox } from "std-widgets.slint";
import { ControlMotion, Theme } from "theme.slint";

export enum SettingsPage { account, playback, audio, appearance, controls, about }

export global SettingsIcons {
    out property <string> account: "M 12 2 A 10 10 0 1 0 12 22 A 10 10 0 1 0 12 2 Z M 12 6 A 3 3 0 1 0 12 12 A 3 3 0 1 0 12 6 Z M 5.5 19 C 6 13.5 18 13.5 18.5 19";
    out property <string> playback: "M 12 2 A 10 10 0 1 0 12 22 A 10 10 0 1 0 12 2 Z M 10 8 L 16 12 L 10 16 Z";
    out property <string> audio: "M 4 6 L 20 6 M 4 12 L 20 12 M 4 18 L 20 18 M 8 3.5 L 8 8.5 M 15 9.5 L 15 14.5 M 10 15.5 L 10 20.5";
    out property <string> appearance: "M 12 3 A 9 9 0 1 0 12 21 A 9 9 0 1 0 12 3 Z M 12 3 L 12 21 M 12 7 L 17 7 M 12 11 L 20 11 M 12 15 L 19 15";
    out property <string> controls: "M 2 6 L 22 6 L 22 18 L 2 18 Z M 6 10 L 7 10 M 10 10 L 11 10 M 14 10 L 15 10 M 18 10 L 18 10 M 7 14 L 17 14";
    out property <string> about: "M 12 2 A 10 10 0 1 0 12 22 A 10 10 0 1 0 12 2 Z M 12 11 L 12 17 M 12 7 L 12 7.5";
}

// One category in the rail. `compact` is the horizontal tab used when the
// window is too narrow for a side rail.
export component SettingsNavItem inherits Rectangle {
    in property <string> title;
    in property <string> icon-path;
    in property <bool> active;
    in property <bool> compact: false;
    in property <bool> badge: false;
    // Each category has its own icon tile colour, as in system settings apps.
    in property <color> tint: Theme.accent;
    callback select();
    height: root.compact ? 36px : 42px;
    min-width: root.compact ? label.preferred-width + 56px : 0px;
    border-radius: root.compact ? self.height / 2 : 10px;
    background: root.active ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: ControlMotion.feedback; easing: ease-out; }
    border-width: control.has-focus ? 2px : 0px;
    border-color: Theme.focus;
    touch := TouchArea {
        mouse-cursor: pointer;
        control := Button { width: parent.width; height: parent.height; opacity: 0; text: ""; accessible-label: root.title + " settings"; clicked => { root.select(); } }
    }
    Rectangle {
        x: root.compact ? 6px : 8px; y: (parent.height - self.height) / 2;
        width: root.compact ? 24px : 26px; height: self.width; border-radius: 7px;
        background: root.tint;
        Path {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: 16px; height: 16px; viewbox-width: 24; viewbox-height: 24;
            fill: transparent; stroke: #ffffff; stroke-width: 2.1px;
            commands: root.icon-path;
        }
    }
    label := Text {
        x: root.compact ? 38px : 44px; width: parent.width - self.x - (root.badge ? 26px : 10px); height: parent.height;
        text: root.title; vertical-alignment: center; overflow: elide;
        color: root.active ? Theme.selected-ink : Theme.text;
        font-size: 13.5px; font-weight: root.active ? 700 : 500;
    }
    if root.badge : Rectangle {
        x: parent.width - 18px; y: (parent.height - 7px) / 2;
        width: 7px; height: 7px; border-radius: 3.5px; background: Theme.accent;
    }
}

// One category's content. It eases in each time the page changes.
export component SettingsPageFade inherits Rectangle {
    private property <length> shift: ControlMotion.enabled ? 10px : 0px;
    opacity: ControlMotion.enabled ? 0 : 1;
    init => { self.opacity = 1; self.shift = 0px; }
    animate opacity { duration: ControlMotion.enabled ? 180ms : 0ms; easing: ease-out; }
    animate shift { duration: ControlMotion.enabled ? 240ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
    VerticalLayout {
        y: root.shift;
        spacing: 24px; alignment: start;
        @children
    }
}

// A titled card of related settings. Rows inside draw their own dividers.
export component SettingsGroup inherits VerticalLayout {
    in property <string> title;
    in property <string> note;
    spacing: 8px;
    if root.title != "" : Text {
        text: root.title; color: Theme.muted;
        font-size: 12px; font-weight: 700; letter-spacing: 0.3px;
    }
    Rectangle {
        background: Theme.raised;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.divider;
        VerticalLayout {
            padding-left: 16px; padding-right: 16px;
            @children
        }
    }
    if root.note != "" : Text {
        text: root.note; color: Theme.muted; font-size: 12px; wrap: word-wrap;
    }
}

// Label and description on the left, any control on the right.
export component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> separator: true;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    opacity: root.enabled ? 1 : 0.45;
    if root.separator : Rectangle { y: 0px; height: 1px; background: Theme.divider; }
    HorizontalLayout {
        padding-top: 12px; padding-bottom: 12px; spacing: 16px;
        cross-axis-alignment: center;
        VerticalLayout {
            horizontal-stretch: 1; min-width: 0px; spacing: 3px; alignment: center;
            Text { text: root.title; color: root.danger ? (Theme.light ? #b3362f : #ff8a80) : Theme.text; font-size: 14px; font-weight: 600; overflow: elide; }
            if root.detail != "" : Text { text: root.detail; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
        }
        @children
    }
}

// Title and description above a full-width control (chips, cards, menus).
export component SettingBlock inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> separator: true;
    in property <bool> enabled: true;
    opacity: root.enabled ? 1 : 0.45;
    if root.separator : Rectangle { y: 0px; height: 1px; background: Theme.divider; }
    VerticalLayout {
        padding-top: 14px; padding-bottom: 16px; spacing: 10px;
        if root.title != "" || root.detail != "" : VerticalLayout {
            spacing: 3px;
            if root.title != "" : Text { text: root.title; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; }
            if root.detail != "" : Text { text: root.detail; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
        }
        @children
    }
}

// The visual switch. A transparent native CheckBox keeps keyboard focus,
// Space-key toggling and accessibility semantics.
export component SettingSwitch inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <string> label;
    callback toggled();
    width: 44px; height: 26px; border-radius: 13px;
    background: root.checked ? Theme.accent : (Theme.light ? #d9cbc0 : #363b46);
    animate background { duration: ControlMotion.selection; easing: ease-out; }
    border-width: toggle.has-focus ? 2px : 0px;
    border-color: Theme.focus;
    Rectangle {
        x: root.checked ? 21px : 3px; y: 3px; width: 20px; height: 20px; border-radius: 10px;
        background: #fff8f6;
        drop-shadow-blur: 3px; drop-shadow-offset-y: 1px; drop-shadow-color: #00000040;
        animate x { duration: ControlMotion.selection; easing: ease-out; }
    }
    toggle := CheckBox {
        width: parent.width; height: parent.height; opacity: 0;
        enabled: root.enabled; checked: root.checked; accessible-label: root.label;
        toggled => { toggle.focus(); root.toggled(); }
    }
    public function focus-switch() { toggle.focus(); }
}

// A whole row that toggles: the label is part of the target.
export component SettingToggle inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <bool> separator: true;
    callback toggled();
    opacity: root.enabled ? 1 : 0.45;
    if root.separator : Rectangle { y: 0px; height: 1px; background: Theme.divider; }
    TouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        clicked => { switch.focus-switch(); root.toggled(); }
    }
    HorizontalLayout {
        padding-top: 12px; padding-bottom: 12px; spacing: 16px;
        cross-axis-alignment: center;
        VerticalLayout {
            horizontal-stretch: 1; min-width: 0px; spacing: 3px; alignment: center;
            Text { text: root.title; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; }
            if root.detail != "" : Text { text: root.detail; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
        }
        switch := SettingSwitch {
            checked: root.checked; enabled: root.enabled; label: root.title;
            toggled => { root.toggled(); }
        }
    }
}

// Mutually exclusive choices with a sliding selection.
export component SegmentedControl inherits Rectangle {
    in property <[string]> options;
    in property <int> selected: 0;
    in property <bool> enabled: true;
    in property <string> label;
    callback select(int);
    private property <length> segment: (self.width - 6px) / max(1, root.options.length);
    height: 36px;
    min-width: root.options.length * 52px;
    border-radius: 10px;
    background: Theme.light ? #ebe2d8 : #121419;
    border-width: 1px; border-color: Theme.divider;
    opacity: root.enabled ? 1 : 0.45;
    if root.selected >= 0 : Rectangle {
        x: 3px + root.segment * root.selected; y: 3px;
        width: root.segment; height: parent.height - 6px;
        border-radius: 8px;
        background: Theme.light ? #fffcf8 : #2b303a;
        drop-shadow-blur: 4px; drop-shadow-offset-y: 1px; drop-shadow-color: Theme.light ? #5a3a2a22 : #00000060;
        animate x { duration: ControlMotion.enabled ? 180ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
    }
    for option[index] in root.options : Rectangle {
        x: 3px + root.segment * index; y: 3px;
        width: root.segment; height: parent.height - 6px;
        border-radius: 8px;
        border-width: action.has-focus ? 2px : 0px; border-color: Theme.focus;
        Text {
            text: option; font-size: 13px;
            font-weight: index == root.selected ? 700 : 500;
            color: index == root.selected ? Theme.text : (hover.has-hover ? Theme.text : Theme.muted);
            horizontal-alignment: center; vertical-alignment: center;
        }
        hover := TouchArea {
            enabled: root.enabled; mouse-cursor: pointer;
            action := Button {
                width: parent.width; height: parent.height; opacity: 0; text: ""; enabled: root.enabled;
                accessible-label: root.label + ": " + option;
                clicked => { root.select(index); }
            }
        }
    }
}

// Theme choice with a miniature of the window in that palette.
export component ThemeCard inherits Rectangle {
    in property <string> title;
    // 0 dark, 1 light, 2 follows the system.
    in property <int> kind;
    in property <bool> selected;
    callback select();
    height: 118px;
    min-width: 96px;
    horizontal-stretch: 1;
    border-radius: 12px;
    background: touch.has-hover && !root.selected ? Theme.hover : transparent;
    border-width: action.has-focus ? 2px : root.selected ? 2px : 1px;
    border-color: action.has-focus ? Theme.focus : root.selected ? Theme.accent : Theme.outline;
    animate background { duration: ControlMotion.feedback; easing: ease-out; }
    touch := TouchArea {
        mouse-cursor: pointer;
        action := Button { width: parent.width; height: parent.height; opacity: 0; text: ""; accessible-label: root.title + " theme"; accessible-checked: root.selected; clicked => { root.select(); } }
    }
    preview := Rectangle {
        x: 8px; y: 8px; width: parent.width - 16px; height: 72px;
        border-radius: 8px; clip: true;
        for half in (root.kind == 2 ? 2 : 1) : half-art := Rectangle {
            property <bool> light: root.kind == 1 || (root.kind == 2 && half == 1);
            x: root.kind == 2 ? half * parent.width / 2 : 0px;
            width: root.kind == 2 ? parent.width / 2 : parent.width;
            height: parent.height; clip: true;
            background: self.light ? #eee5db : #13161b;
            // The miniature is drawn at full card width; the split crops it.
            Rectangle {
                x: root.kind == 2 ? -half * preview.width / 2 : 0px;
                width: preview.width; height: preview.height;
                Rectangle { x: 7px; y: 9px; width: 16px; height: 4px; border-radius: 2px; background: half-art.light ? #c9b6a9 : #3a3f4a; }
                Rectangle { x: 7px; y: 17px; width: 12px; height: 4px; border-radius: 2px; background: half-art.light ? #d6c6bb : #2c313a; }
                Rectangle { x: 7px; y: 25px; width: 14px; height: 4px; border-radius: 2px; background: half-art.light ? #d6c6bb : #2c313a; }
                Rectangle {
                    x: 30px; y: 7px; width: parent.width - 37px; height: 46px; border-radius: 5px;
                    background: half-art.light ? #f9f4ee : #191c22;
                    Rectangle { x: 6px; y: 6px; width: 18px; height: 18px; border-radius: 4px; background: half-art.light ? @linear-gradient(140deg, #f0904a 0%, #b45448 100%) : @linear-gradient(140deg, #c43f68 0%, #6a3fb5 100%); }
                    Rectangle { x: 29px; y: 8px; width: max(0px, parent.width - 40px); height: 4px; border-radius: 2px; background: half-art.light ? #392e3360 : #f2f0f160; }
                    Rectangle { x: 29px; y: 16px; width: max(0px, parent.width - 56px); height: 4px; border-radius: 2px; background: half-art.light ? #392e3330 : #f2f0f130; }
                    Rectangle { x: 6px; y: 31px; width: max(0px, parent.width - 12px); height: 4px; border-radius: 2px; background: half-art.light ? #392e3320 : #f2f0f120; }
                }
                Rectangle {
                    x: 0px; y: parent.height - 13px; width: parent.width; height: 13px;
                    background: half-art.light ? #e7ddd2 : #0e1014;
                    Rectangle { x: (parent.width - 8px) / 2; y: 3px; width: 8px; height: 8px; border-radius: 4px; background: half-art.light ? #b45448 : #c43f68; }
                }
            }
        }
    }
    Text {
        x: 12px; y: 86px; width: parent.width - 40px; height: 24px;
        text: root.title; vertical-alignment: center; overflow: elide;
        color: Theme.text; font-size: 13px; font-weight: root.selected ? 700 : 600;
    }
    if root.selected : Rectangle {
        x: parent.width - 30px; y: 88px; width: 20px; height: 20px; border-radius: 10px;
        background: Theme.accent;
        Path { x: 4px; y: 4px; width: 12px; height: 12px; viewbox-width: 24; viewbox-height: 24; fill: transparent; stroke: Theme.on-accent; stroke-width: 3px; commands: "M 4 12 L 10 18 L 20 6"; }
    }
}

// Equalizer preset with the shape of its curve.
export component EqualizerPreset inherits Rectangle {
    in property <string> title;
    in property <int> preset;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback select();
    height: 76px;
    min-width: 92px;
    horizontal-stretch: 1;
    border-radius: 10px;
    background: root.selected ? Theme.selected : touch.has-hover ? Theme.hover : (Theme.light ? #efe6dc : #171a20);
    animate background { duration: ControlMotion.feedback; easing: ease-out; }
    border-width: action.has-focus ? 2px : 1px;
    border-color: action.has-focus ? Theme.focus : root.selected ? Theme.accent : Theme.divider;
    opacity: root.enabled ? 1 : 0.45;
    touch := TouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        action := Button { width: parent.width; height: parent.height; opacity: 0; text: ""; enabled: root.enabled; accessible-label: root.title + " equalizer preset"; accessible-checked: root.selected; clicked => { root.select(); } }
    }
    Rectangle { x: 12px; y: 27px; width: parent.width - 24px; height: 1px; background: Theme.divider; }
    Path {
        x: 12px; y: 12px; width: parent.width - 24px; height: 30px;
        viewbox-width: 120; viewbox-height: 24;
        fill: transparent; stroke: root.selected ? Theme.accent-ink : Theme.muted; stroke-width: 2px;
        commands: root.preset == 1 ? "M 0 4 C 24 4 36 12 60 12 L 120 12"
            : root.preset == 2 ? "M 0 20 C 24 20 36 12 60 12 L 120 12"
            : root.preset == 3 ? "M 0 12 L 60 12 C 84 12 96 4 120 4"
            : root.preset == 4 ? "M 0 15 C 30 15 40 5 60 5 C 80 5 90 15 120 15"
            : root.preset == 5 ? "M 0 5 C 30 5 40 16 60 16 C 80 16 90 5 120 5"
            : "M 0 12 L 120 12";
    }
    Text {
        x: 12px; y: 50px; width: parent.width - 24px; height: 18px;
        text: root.title; overflow: elide;
        color: root.selected ? Theme.selected-ink : Theme.text;
        font-size: 12.5px; font-weight: root.selected ? 700 : 600;
    }
}

// A keyboard shortcut inside a settings card.
export component ShortcutSetting inherits Rectangle {
    in property <string> action;
    in property <string> binding;
    in property <bool> recording;
    in property <bool> separator: true;
    callback record();
    callback clear();
    if root.separator : Rectangle { y: 0px; height: 1px; background: Theme.divider; }
    HorizontalLayout {
        padding-top: 10px; padding-bottom: 10px; spacing: 8px; cross-axis-alignment: center;
        Text { horizontal-stretch: 1; text: root.action; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; }
        key := Rectangle {
            width: 148px; height: 34px; border-radius: 8px;
            background: root.recording ? Theme.selected : key-touch.has-hover ? Theme.hover : (Theme.light ? #efe6dc : #14171c);
            border-width: key-action.has-focus || root.recording ? 2px : 1px;
            border-color: key-action.has-focus ? Theme.focus : root.recording ? Theme.accent : Theme.outline;
            animate background { duration: ControlMotion.feedback; easing: ease-out; }
            Text {
                text: root.recording ? "Press keys…" : root.binding == "" ? "Not set" : root.binding;
                color: root.recording ? Theme.selected-ink : root.binding == "" ? Theme.muted : Theme.text;
                font-size: 12.5px; font-weight: root.binding == "" ? 500 : 700;
                horizontal-alignment: center; vertical-alignment: center;
            }
            key-touch := TouchArea {
                mouse-cursor: pointer;
                key-action := Button { width: parent.width; height: parent.height; opacity: 0; text: ""; accessible-label: "Record " + root.action + " shortcut"; clicked => { root.record(); } }
            }
        }
        clear-button := Rectangle {
            width: 30px; height: 30px; border-radius: 15px;
            opacity: root.binding != "" || root.recording ? 1 : 0.35;
            background: clear-touch.has-hover && clear-touch.enabled ? Theme.hover : transparent;
            border-width: clear-action.has-focus ? 2px : 0px; border-color: Theme.focus;
            Path { x: 9px; y: 9px; width: 12px; height: 12px; viewbox-width: 24; viewbox-height: 24; fill: transparent; stroke: Theme.muted; stroke-width: 2.4px; commands: "M 5 5 L 19 19 M 19 5 L 5 19"; }
            clear-touch := TouchArea {
                enabled: root.binding != "" || root.recording; mouse-cursor: pointer;
                clear-action := Button { width: parent.width; height: parent.height; opacity: 0; text: ""; enabled: parent.enabled; accessible-label: "Clear " + root.action + " shortcut"; clicked => { root.clear(); } }
            }
        }
    }
}

// Small status chip: a coloured dot and a short label.
export component StatusPill inherits Rectangle {
    in property <string> text;
    // 0 neutral, 1 good, 2 attention.
    in property <int> tone: 0;
    private property <color> dot: root.tone == 1 ? #3fb37f : root.tone == 2 ? #e0a03a : Theme.muted;
    height: 24px;
    width: pill-text.preferred-width + 30px;
    border-radius: 12px;
    background: root.dot.with-alpha(Theme.light ? 0.14 : 0.16);
    Rectangle { x: 10px; y: (parent.height - 7px) / 2; width: 7px; height: 7px; border-radius: 3.5px; background: root.dot; }
    pill-text := Text { x: 22px; height: parent.height; text: root.text; vertical-alignment: center; color: Theme.text; font-size: 11.5px; font-weight: 600; }
}

// The signed-in account at the foot of the rail; opens the Account page.
export component SettingsAccountChip inherits Rectangle {
    in property <string> name;
    in property <string> status;
    in property <bool> connected;
    in property <bool> active;
    callback select();
    height: 52px;
    border-radius: 12px;
    background: root.active ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: ControlMotion.feedback; easing: ease-out; }
    border-width: control.has-focus ? 2px : 0px; border-color: Theme.focus;
    touch := TouchArea {
        mouse-cursor: pointer;
        control := Button { width: parent.width; height: parent.height; opacity: 0; text: ""; accessible-label: "Account: " + root.name + ", " + root.status; clicked => { root.select(); } }
    }
    Rectangle {
        x: 8px; y: (parent.height - self.height) / 2; width: 34px; height: 34px; border-radius: 17px;
        background: root.connected ? Theme.accent : Theme.cover;
        Path { x: 9px; y: 8px; width: 16px; height: 18px; viewbox-width: 24; viewbox-height: 28; fill: transparent; stroke: root.connected ? #fff8f6 : Theme.cover-ink; stroke-width: 2.2px; commands: "M 17 7 A 5 5 0 1 0 7 7 A 5 5 0 1 0 17 7 Z M 3 25 L 3 22 C 3 12 21 12 21 22 L 21 25"; }
        Rectangle {
            x: parent.width - 10px; y: parent.height - 10px; width: 11px; height: 11px; border-radius: 5.5px;
            background: root.connected ? #3fb37f : #e0a03a; border-width: 2px; border-color: Theme.chrome;
        }
    }
    VerticalLayout {
        x: 52px; width: parent.width - self.x - 8px; height: parent.height;
        alignment: center; spacing: 1px;
        Text { text: root.name; color: Theme.text; font-size: 13px; font-weight: 700; overflow: elide; }
        Text { text: root.status; color: Theme.muted; font-size: 11px; overflow: elide; }
    }
}
