// Content building blocks: slider, artwork, rows, cards and empty states.
import { Slider } from "std-widgets.slint";
import { Theme, Icon, Hit, TextButton, IconButton, PlayButton, LoadingDots, MenuItem, MenuSurface } from "theme.slint";

export struct TrackRow {
    title: string,
    artist: string,
    album: string,
    duration: string,
    recommended: bool,
    artwork: image,
}

export component TideSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> value: 0;
    in property <int> reset-revision: 0;
    // Native input must never assign the externally owned value: doing so
    // breaks its binding to the live clock/volume. Keep a local drag preview.
    private property <float> input-value: root.value;
    private property <bool> interacting: false;
    private property <bool> input-focused: native.has-focus;
    changed value => { if !root.interacting { root.input-value = root.value; } }
    changed maximum => { root.interacting = false; root.input-value = root.value; }
    changed reset-revision => { root.interacting = false; root.input-value = root.value; }
    changed enabled => { if !root.enabled { root.interacting = false; root.input-value = root.value; } }
    changed input-focused => { if !root.input-focused { root.interacting = false; root.input-value = root.value; } }
    in property <bool> enabled: true;
    in property <string> label;
    in property <string> value-text;
    callback changed(float);
    callback released(float);
    private property <float> fraction: root.maximum > root.minimum
        ? min(1, max(0, (root.input-value - root.minimum) / (root.maximum - root.minimum))) : 0;

    min-width: 40px;
    min-height: 20px;
    horizontal-stretch: 1;
    forward-focus: native;
    // Accessibility adjustments are complete actions and have no pointer/key release.
    function commit-accessible(value: float) {
        if root.enabled {
            root.interacting = false;
            root.input-value = min(root.maximum, max(root.minimum, value));
            root.changed(root.input-value);
            root.released(root.input-value);
            root.input-value = root.value;
        }
    }

    Rectangle {
        x: 10px;
        y: (root.height - 4px) / 2;
        width: max(0px, root.width - 20px);
        height: 4px;
        border-radius: 2px;
        background: Theme.rail;
    }
    Rectangle {
        x: 10px;
        y: (root.height - 4px) / 2;
        width: max(0px, root.width - 20px) * root.fraction;
        height: 4px;
        border-radius: 2px;
        background: root.enabled ? Theme.accent : Theme.rail-disabled;
    }
    // The thumb only appears when the slider can be used, so an idle player
    // does not suggest a seekable position.
    if root.enabled : Rectangle {
        x: 3px + max(0px, root.width - 20px) * root.fraction;
        y: (root.height - 14px) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        border-width: native.has-focus ? 2px : 0px;
        border-color: Theme.light ? #68465d : #f2bccb;
        background: Theme.accent;
    }
    native := Slider {
        width: parent.width;
        height: parent.height;
        opacity: 0;
        minimum: root.minimum;
        maximum: root.maximum;
        value <=> root.input-value;
        enabled: root.enabled;
        accessible-label: root.label;
        accessible-value: root.value-text;
        accessible-action-set-value(value) => {
            if value.is-float() { root.commit-accessible(value.to-float()); }
        }
        accessible-action-increment => { root.commit-accessible(root.value + 1); }
        accessible-action-decrement => { root.commit-accessible(root.value - 1); }
        changed(value) => { root.interacting = true; root.changed(value); }
        released(value) => {
            root.interacting = false;
            root.released(value);
            // A rejected/no-op seek need not change the owner's value, so a
            // changed-value callback alone cannot end the local preview.
            root.input-value = root.value;
        }
    }
}

// Artwork is provided by the music source. An absent cover shows a quiet mark.
export component Cover inherits Rectangle {
    in property <image> artwork;
    in property <string> placeholder: "note";
    in property <bool> brand: false;
    // Text that picks a stable placeholder gradient when artwork is missing.
    in property <string> seed;
    private property <bool> missing: root.artwork.width == 0 || root.artwork.height == 0;
    private property <bool> painted: root.brand || (root.missing && root.seed != "");
    border-radius: 6px;
    background: root.brand ? Theme.brand
        : root.painted ? Theme.art(Math.mod(root.seed.character-count, 6)) : Theme.cover;
    clip: true;
    if root.artwork.width > 0 && root.artwork.height > 0 : Image {
        width: parent.width;
        height: parent.height;
        source: root.artwork;
        image-fit: cover;
    }
    if root.artwork.width == 0 || root.artwork.height == 0 : Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.placeholder;
        ink: root.painted ? #ffffffd8 : Theme.cover-ink;
        size: max(14px, min(64px, parent.width * 0.4));
    }
}

// Every empty, loading and signed-out surface uses this one component, so each
// state explains itself and offers the next step where one exists.
export component EmptyState inherits Rectangle {
    in property <string> icon: "note";
    in property <string> heading;
    in property <string> detail;
    in property <bool> loading: false;
    in property <string> action;
    in property <string> secondary-action;
    callback act();
    callback act-secondary();
    VerticalLayout {
        padding: 32px;
        spacing: 12px;
        alignment: center;
        if !root.loading : HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 64px;
                height: 64px;
                border-radius: 32px;
                background: Theme.accent-soft;
                Icon { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; name: root.icon; ink: Theme.selected-ink; size: 28px; }
            }
        }
        if root.loading : HorizontalLayout { alignment: center; LoadingDots { } }
        Text { text: root.heading; color: Theme.text; font-size: 20px; font-weight: 700; horizontal-alignment: center; wrap: word-wrap; accessible-live-region: polite; }
        Text { text: root.detail; color: Theme.muted; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
        if root.action != "" || root.secondary-action != "" : HorizontalLayout {
            alignment: center;
            spacing: 10px;
            padding-top: 6px;
            if root.action != "" : TextButton { height: 38px; pill: true; primary: true; text: root.action; font-size: 13px; clicked => { root.act(); } }
            if root.secondary-action != "" : TextButton { height: 38px; pill: true; text: root.secondary-action; font-size: 13px; clicked => { root.act-secondary(); } }
        }
    }
}

// Animated level bars for the song that is playing. They rest when paused or
// when motion is off; their timer only exists for visible playing rows.
export component EqualizerBars inherits Rectangle {
    in property <bool> active: true;
    in property <color> ink: Theme.accent;
    private property <int> tick: 0;
    private property <bool> moving: root.active && Theme.motion;
    width: 16px;
    height: 14px;
    Timer { interval: 300ms; running: root.moving; triggered => { root.tick += 1; } }
    for bar in 4 : Rectangle {
        x: bar * 4.5px;
        width: 3px;
        height: root.moving
            ? root.height * (0.25 + 0.75 * abs(Math.sin((root.tick * (1.1 + bar * 0.63) + bar * 1.7) * 1rad)))
            : root.height * (bar == 1 ? 0.9 : bar == 2 ? 0.6 : bar == 0 ? 0.45 : 0.3);
        y: root.height - self.height;
        border-radius: 1.5px;
        background: root.ink;
        animate height { duration: 280ms; easing: ease-in-out; }
    }
}

// Three song actions shared by rows and cards.
component SongMenu inherits MenuSurface {
    in property <string> title;
    in property <bool> queued: false;
    in property <bool> current: false;
    callback queue(bool);
    callback radio();
    MenuItem { icon: "next"; text: root.queued && root.current ? "Repeat next" : "Play next"; label: (root.queued && root.current ? "Repeat " : "Play ") + root.title + " next"; clicked => { root.queue(true); } }
    MenuItem { icon: "queue"; text: root.queued && root.current ? "Repeat later" : root.queued ? "Move to end of queue" : "Add to queue"; label: (root.queued ? "Move " : "Add ") + root.title + " to the end of your queue"; clicked => { root.queue(false); } }
    MenuItem { icon: "radio"; text: "Start song radio"; label: "Replace upcoming tracks with a radio from " + root.title; clicked => { root.radio(); } }
}

// A song in a list or the queue. `number` > 0 shows a track number column;
// `playing` marks the song currently loaded in the player. Song actions open in
// a popup menu, so at most one menu exists at a time and rows keep one height.
export component SongRow inherits Rectangle {
    in property <TrackRow> track;
    in property <int> index;
    in property <int> number: 0;
    in property <bool> current: false;
    in property <bool> playing: false;
    in property <bool> removable: false;
    in property <bool> draggable: false;
    in property <bool> dragging: false;
    in property <bool> drag-in-progress: false;
    in property <bool> show-album: false;
    in property <bool> enabled: true;
    in property <bool> show-duration: true;
    in property <length> row-height: 56px;
    // True while the playing song is actually producing sound.
    in property <bool> live: false;
    callback select();
    callback remove();
    callback queue(bool);
    callback radio();
    private property <bool> engaged: hit.hovered || more.hovered;
    animate background { duration: Theme.fast; }
    private property <bool> accent-title: root.playing || root.current;
    height: root.row-height;
    opacity: root.dragging ? 0.55 : 1;
    border-radius: 8px;
    background: root.current ? Theme.selected
        : hit.pressed ? Theme.pressed : root.engaged ? Theme.hover : Colors.transparent;
    border-width: hit.focused ? 2px : 0px;
    border-color: Theme.focus;
    hit := Hit {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled && !root.drag-in-progress;
        label: (root.current ? "Now playing: " : "Play ") + root.track.title + (root.track.artist == "" ? "" : " by " + root.track.artist);
        clicked => { root.select(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        cross-axis-alignment: center;
        if root.removable : Rectangle {
            width: 20px;
            height: 40px;
            if root.draggable : Rectangle {
                accessible-role: text;
                accessible-label: "Drag handle for " + root.track.title;
                for dot in 6 : Rectangle {
                    x: (dot - floor(dot / 2) * 2) * 6px + 5px;
                    y: floor(dot / 2) * 6px + 12px;
                    width: 3px;
                    height: 3px;
                    border-radius: 1.5px;
                    background: root.engaged ? Theme.muted : Theme.faint;
                }
            }
        }
        if root.number > 0 : Rectangle {
            width: 26px;
            height: 20px;
            if root.playing : EqualizerBars { x: (parent.width - self.width) / 2; y: 3px; active: root.live; }
            if !root.playing && root.engaged : Icon { x: (parent.width - self.width) / 2; y: 3px; name: "play"; ink: Theme.text; size: 14px; }
            if !root.playing && !root.engaged : Text { width: parent.width; height: parent.height; text: root.number; color: Theme.faint; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
        }
        Cover { width: 42px; height: 42px; artwork: root.track.artwork; seed: root.track.title; border-radius: 5px; }
        Rectangle {
            horizontal-stretch: 2;
            min-width: 0px;
            preferred-width: 0px;
            height: 36px;
            // Mixed-direction glyphs can paint outside an elided Text's
            // bounds. Clip metadata only, keeping row focus/actions intact.
            clip: true;
            VerticalLayout {
                width: parent.width;
                height: parent.height;
                spacing: 4px;
                Text { min-width: 0px; text: root.track.title; color: root.accent-title ? Theme.selected-ink : Theme.text; font-size: 14px; font-weight: root.accent-title ? 600 : 500; overflow: elide; }
                Text { min-width: 0px; text: root.track.artist == "" ? "Unknown artist" : root.track.artist; color: Theme.muted; font-size: 12px; overflow: elide; }
            }
        }
        if root.show-album : Text { horizontal-stretch: 1; min-width: 0px; preferred-width: 0px; text: root.track.album; color: Theme.muted; font-size: 12px; overflow: elide; vertical-alignment: center; }
        if root.show-duration && (root.number > 0 || (root.track.duration != "" && root.track.duration != "—")) : Text { width: 42px; text: root.track.duration == "—" ? "" : root.track.duration; color: Theme.muted; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
        more := IconButton {
            width: 30px;
            height: 30px;
            quiet: true;
            icon: "more";
            label: "More actions for " + root.track.title;
            enabled: root.enabled && !root.drag-in-progress;
            // Lists reveal the action on hover; the queue always shows it.
            opacity: !self.enabled ? 0.4 : (root.engaged || root.removable || root.current) ? 1 : 0;
            clicked => { menu.show(); }
            menu := PopupWindow {
                x: parent.width - 220px;
                y: parent.height + 4px;
                width: 220px;
                height: 3 * 36px + 12px;
                SongMenu {
                    width: parent.width;
                    height: parent.height;
                    title: root.track.title;
                    queued: root.removable;
                    current: root.current;
                    queue(next) => { root.queue(next); }
                    radio => { root.radio(); }
                }
            }
        }
        if root.removable : IconButton { width: 28px; height: 30px; quiet: true; icon: "close"; icon-size: 16px; label: "Remove " + root.track.title + " from queue"; enabled: root.enabled && !root.drag-in-progress; clicked => { root.remove(); } }
    }
}

// Artwork-first tile for playlists, mixes, albums and songs in a grid.
export component MediaCard inherits Rectangle {
    in property <image> artwork;
    in property <string> title;
    in property <string> subtitle;
    in property <string> placeholder: "playlist";
    in property <bool> brand: false;
    in property <bool> enabled: true;
    in property <bool> available: true;
    in property <string> unavailable-label: "Unavailable";
    in property <bool> song: false;
    in property <bool> playing: false;
    callback open();
    callback play();
    callback queue(bool);
    callback radio();
    private property <length> art: root.width - 20px;
    private property <bool> engaged: hit.hovered || play-button.hovered || more.hovered;
    // Hover lift: the play button rises into place as the card highlights.
    private property <length> lift: root.engaged || root.playing ? 0px : 10px;
    animate lift { duration: Theme.medium; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
    border-radius: 12px;
    background: hit.pressed ? Theme.pressed : root.engaged ? Theme.hover : Colors.transparent;
    animate background { duration: Theme.medium; }
    border-width: hit.focused ? 2px : 0px;
    border-color: Theme.focus;
    hit := Hit {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled && root.available;
        label: !root.available ? root.title + ", " + root.unavailable-label : (root.song ? "Play " : "Open ") + root.title;
        clicked => { root.open(); }
    }
    Cover {
        x: 10px;
        y: 10px;
        width: root.art;
        height: root.art;
        border-radius: 8px;
        artwork: root.artwork;
        placeholder: root.placeholder;
        brand: root.brand;
        seed: root.title;
        opacity: root.available ? 1 : 0.55;
        drop-shadow-blur: root.engaged ? 22px : 10px;
        drop-shadow-offset-y: root.engaged ? 8px : 3px;
        drop-shadow-color: Theme.shadow;
    }
    if !root.available : Rectangle {
        x: 18px;
        y: 18px;
        width: badge.preferred-width + 16px;
        height: 22px;
        border-radius: 11px;
        background: #000000a8;
        badge := Text { x: 8px; height: parent.height; text: root.unavailable-label; color: #ffffff; font-size: 10px; font-weight: 600; vertical-alignment: center; }
    }
    // Hover affordances stay in the tree and fade by opacity, so moving onto
    // them does not end the card's hover and make them flicker away.
    play-button := PlayButton {
        x: 10px + root.art - 52px;
        y: 10px + root.art - 52px + root.lift;
        width: 44px;
        height: 44px;
        visible: root.available && root.enabled;
        opacity: root.engaged || root.playing ? 1 : 0;
        animate opacity { duration: Theme.medium; }
        playing: false;
        label: (root.song ? "Play " : "Play all of ") + root.title;
        clicked => { root.play(); }
    }
    more := IconButton {
        x: 10px + root.art - 38px;
        y: 18px;
        width: 30px;
        height: 30px;
        round: true;
        quiet: true;
        ink: #ffffff;
        visible: root.song && root.available && root.enabled;
        opacity: root.engaged ? 1 : 0;
        animate opacity { duration: Theme.medium; }
        background: self.hovered ? #000000c0 : #00000080;
        icon: "more";
        label: "More actions for " + root.title;
        clicked => { card-menu.show(); }
        card-menu := PopupWindow {
            x: 0px;
            y: 34px;
            width: 220px;
            height: 3 * 36px + 12px;
            SongMenu {
                width: parent.width;
                height: parent.height;
                title: root.title;
                queue(next) => { root.queue(next); }
                radio => { root.radio(); }
            }
        }
    }
    VerticalLayout {
        x: 10px;
        y: 18px + root.art;
        width: root.art;
        height: 40px;
        spacing: 3px;
        Text { text: root.title; color: root.playing ? Theme.selected-ink : Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
        Text { text: root.subtitle; color: Theme.muted; font-size: 12px; overflow: elide; }
    }
}

// Sidebar destination. Collapses to an icon when the window is narrow.
export component NavigationButton inherits Rectangle {
    in property <bool> active;
    in property <string> icon;
    in property <string> text;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> icon-only: false;
    callback clicked;
    height: 40px;
    border-radius: 8px;
    background: root.active ? Theme.selected
        : hit.pressed ? Theme.pressed : hit.hovered ? Theme.hover : Colors.transparent;
    border-width: hit.focused ? 2px : 0px;
    border-color: Theme.focus;
    opacity: root.enabled ? 1 : 0.5;
    animate background { duration: Theme.fast; }
    private property <color> ink: root.active ? Theme.selected-ink : hit.hovered ? Theme.text : Theme.muted;
    hit := Hit { width: parent.width; height: parent.height; enabled: root.enabled; label: root.label; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: root.icon-only ? 0px : 12px;
        padding-right: root.icon-only ? 0px : 10px;
        spacing: 12px;
        alignment: root.icon-only ? center : start;
        cross-axis-alignment: center;
        Icon { name: root.icon; ink: root.ink; size: 19px; }
        if !root.icon-only : Text {
            horizontal-stretch: 1;
            text: root.text;
            color: root.ink;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Compact playlist entry in the sidebar.
export component SidebarPlaylist inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> liked: false;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback open();
    height: 44px;
    border-radius: 8px;
    background: root.active ? Theme.selected : hit.pressed ? Theme.pressed : hit.hovered ? Theme.hover : Colors.transparent;
    border-width: hit.focused ? 2px : 0px;
    border-color: Theme.focus;
    opacity: root.enabled ? 1 : 0.5;
    hit := Hit { width: parent.width; height: parent.height; enabled: root.enabled; label: "Open " + root.title; clicked => { root.open(); } }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        cross-axis-alignment: center;
        Cover { width: 32px; height: 32px; border-radius: 5px; brand: root.liked; seed: root.title; placeholder: root.liked ? "heart" : "playlist"; }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            alignment: center;
            spacing: 1px;
            Text { text: root.title; color: root.active ? Theme.selected-ink : Theme.text; font-size: 12px; font-weight: 600; overflow: elide; }
            if root.subtitle != "" : Text { text: root.subtitle; color: Theme.faint; font-size: 11px; overflow: elide; }
        }
    }
}
