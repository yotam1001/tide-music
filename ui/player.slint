// The persistent player bar (full, compact and mini).
import { Button } from "std-widgets.slint";
import { ControlMotion, Theme, LayoutMetrics, VolumeMark, TideSlider, TransportButtons, LibraryButton } from "theme.slint";
import { Cover, ArtistLink, RatingButton } from "components.slint";

export component PlayerBar inherits Rectangle {
    // Colour sampled from the current cover; it glows behind the now-playing area.
    in property <color> tint;
    in property <bool> tinted: false;
    in property <bool> now-playing-open: false;
    callback expand();
    private property <color> glow: root.tinted ? root.tint : Theme.accent;
    animate glow { duration: ControlMotion.enabled ? 420ms : 0ms; easing: ease-in-out; }
    in property <bool> transport-enabled: true;
    in property <bool> skip-enabled: root.transport-enabled;
    in property <bool> window-minimized: false;
    private property <int> input-revision: 0;
    private property <bool> repaint-phase: false;
    changed window-minimized => { root.input-revision += 1; }
    changed track-title => { root.input-revision += 1; }
    changed collapsed => { root.input-revision += 1; }
    // A changed label can otherwise survive in a reused Windows software
    // surface until resize. Invalidate only this small bar on live updates.
    changed volume => { root.repaint-phase = !root.repaint-phase; }
    changed position => { root.repaint-phase = !root.repaint-phase; }
    changed playback-hint => { root.repaint-phase = !root.repaint-phase; }
    changed audio-quality => { root.repaint-phase = !root.repaint-phase; }
    in property <bool> light-mode;
    in property <bool> compact;
    in property <bool> collapsed;
    in property <bool> queue-open;
    in property <bool> lyrics-open;
    callback toggle-lyrics;
    in property <bool> repeat-enabled;
    callback toggle-repeat();
    callback shuffle-queue();
    in property <string> track-title;
    in property <string> track-artist;
    in property <bool> artist-enabled;
    in property <string> audio-quality;
    in property <string> playback-hint;
    callback artist();
    in property <int> rating: 0;
    in property <bool> rating-enabled: false;
    in property <bool> rating-busy: false;
    callback rate(int);
    in property <image> artwork;
    in property <float> position;
    in property <float> duration;
    // Listed length such as "3:34" ("—" or "" when unknown).
    in property <string> known-length;
    private property <bool> length-listed: root.known-length != "" && root.known-length != "—";
    in property <bool> paused;
    in property <float> volume;
    callback toggle-pause();
    callback next-track();
    callback previous-track();
    callback seek(float);
    in property <float> volume-step: 2;
    // Bit-perfect output: the device sets loudness, so the slider rests.
    in property <bool> volume-locked: false;
    callback change-volume(float);
    callback restore();
    callback toggle-queue();
    callback mini();
    in property <bool> mini-pinned;
    callback toggle-mini-pin();
    private property <color> foreground: Theme.text;
    private property <color> secondary: Theme.muted;
    background: Theme.chrome;
    border-width: 1px;
    border-color: Theme.outline;
    Rectangle { x: 1px; y: 1px; width: max(0px, parent.width - 2px); height: max(0px, parent.height - 2px); background: Theme.chrome; visible: root.repaint-phase; }
    if !root.collapsed && root.track-title != "" : Rectangle {
        x: 1px;
        y: 1px;
        width: max(0px, parent.width * 0.42);
        height: max(0px, parent.height - 2px);
        background: @linear-gradient(90deg, root.glow.with-alpha(Theme.light ? 0.16 : 0.22) 0%, root.glow.with-alpha(0) 100%);
    }
    pure function format-time(seconds: float) -> string {
        let total: int = max(0, seconds);
        let minutes: int = total / 60;
        let remainder: int = total - (minutes * 60);
        return minutes + ":" + (remainder < 10 ? "0" + remainder : remainder);
    }

    // Side columns of the full player; the centre takes the remaining width.
    // Below 900px the side columns narrow and the volume slider gives way to
    // the mute button, so the transport never overlaps them.
    private property <bool> narrow: root.width < 900px;
    // Narrow windows give the song column whatever the transport can spare:
    // 200px at the 650px minimum, ~230px at the 780px compact size.
    private property <length> side-width: root.narrow ? clamp((root.width - 64px) * 0.32, 200px, 250px) : max(268px, (root.width - 64px) * 0.3);
    // Compact (780px+) but narrow: Like/Dislike sit with the right-hand buttons.
    private property <bool> ratings-right: root.narrow && root.width >= 760px;
    private property <float> unmute-volume: 70;
    function toggle-mute() {
        if root.volume > 0 { root.unmute-volume = root.volume; root.change-volume(0); }
        else { root.change-volume(root.unmute-volume > 0 ? root.unmute-volume : 70); }
    }

    // Full window: song | transport and timeline | actions and volume.
    if !root.collapsed : HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;
        cross-axis-alignment: center;
        HorizontalLayout {
            width: root.side-width;
            spacing: root.narrow ? 10px : 12px;
            cross-axis-alignment: center;
            Rectangle {
                width: root.narrow ? 40px : 56px; height: self.width;
                // Text measures for the title column (outside the row layout).
                title-measure := Text { visible: false; width: 0px; height: 0px; text: root.track-title == "" ? "Nothing playing" : root.track-title; font-size: 14px; font-weight: 650; }
                artist-measure := Text { visible: false; width: 0px; height: 0px; text: root.track-artist; font-size: 13px; }
                Cover { width: parent.width; height: parent.height; artwork: root.artwork; light-mode: root.light-mode; seed: root.track-title; drop-shadow-blur: 12px; drop-shadow-offset-y: 3px; drop-shadow-color: Theme.shadow; }
                if root.track-title != "" : expand-area := TouchArea {
                    mouse-cursor: pointer;
                    Rectangle {
                        border-radius: 7px;
                        background: expand-area.has-hover || expand-button.has-focus ? #00000070 : transparent;
                        border-width: expand-button.has-focus ? 2px : 0px;
                        border-color: Theme.focus;
                        animate background { duration: ControlMotion.feedback; }
                        Path {
                            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                            width: 20px; height: 20px; viewbox-width: 24; viewbox-height: 24;
                            fill: transparent; stroke: #ffffff; stroke-width: 2px;
                            opacity: expand-area.has-hover || expand-button.has-focus ? 1 : 0;
                            commands: root.now-playing-open ? "M 5 9 L 12 16 L 19 9" : "M 5 15 L 12 8 L 19 15";
                        }
                    }
                    expand-button := Button {
                        width: parent.width; height: parent.height; opacity: 0; text: "";
                        accessible-label: root.now-playing-open ? "Close Now Playing" : "Open Now Playing";
                        clicked => { root.expand(); }
                    }
                }
            }
            // The title hugs its text so Like and Dislike sit right beside it,
            // as in other players, until the column runs out of room.
            VerticalLayout {
                width: max(0px, min(root.side-width - (root.narrow ? 40px : 56px) - (root.ratings-right ? 2 * 10px : 4 * (root.narrow ? 10px : 12px) + 64px), max(title-measure.preferred-width, artist-measure.preferred-width) + 4px));
                spacing: 2px;
                alignment: center;
                // Right-to-left titles can paint outside an elided Text; clip them.
                Rectangle { height: 20px; min-width: 0px; clip: true; Text { width: parent.width; height: parent.height; vertical-alignment: center; text: root.track-title == "" ? "Nothing playing" : root.track-title; color: root.foreground; font-size: 14px; font-weight: 650; overflow: elide; } }
                ArtistLink { artist: root.track-artist; enabled: root.artist-enabled; light-mode: root.light-mode; activated => { root.artist(); } }
                if root.playback-hint != "" : Text { text: root.playback-hint; color: Theme.accent-ink; font-size: 10px; overflow: elide; accessible-live-region: polite; }
                if root.playback-hint == "" && root.audio-quality != "" : Text { text: root.audio-quality; color: root.secondary; font-size: 10px; overflow: elide; }
            }
            if !root.ratings-right : RatingButton { width: 32px; height: 34px; enabled: root.rating-enabled && !root.rating-busy; light-mode: root.light-mode; active: root.rating == 1; label: root.rating == 1 ? "Remove like" : "Like this song on YouTube Music"; clicked => { root.rate(root.rating == 1 ? 0 : 1); } }
            if !root.ratings-right : RatingButton { width: 32px; height: 34px; negative: true; enabled: root.rating-enabled && !root.rating-busy; light-mode: root.light-mode; active: root.rating == -1; label: root.rating == -1 ? "Remove dislike" : "Dislike this song on YouTube Music"; clicked => { root.rate(root.rating == -1 ? 0 : -1); } }
            Rectangle { horizontal-stretch: 1; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            spacing: 2px;
            alignment: center;
            TransportButtons {
                height: 46px;
                enabled: root.transport-enabled; next-enabled: root.skip-enabled;
                paused: root.paused; light-mode: root.light-mode; repeat-enabled: root.repeat-enabled;
                show-repeat: !root.compact && !root.narrow; show-shuffle: !root.compact && !root.narrow;
                toggle-repeat => { root.toggle-repeat(); } shuffle-queue => { root.shuffle-queue(); }
                toggle-pause => { root.toggle-pause(); } previous-track => { root.previous-track(); } next-track => { root.next-track(); }
            }
            HorizontalLayout {
                height: 22px;
                spacing: 8px;
                cross-axis-alignment: center;
                Text { width: 40px; text: root.duration > 0 ? root.format-time(root.position) : root.length-listed ? "0:00" : ""; color: root.secondary; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                TideSlider { reset-revision: root.input-revision; light-mode: root.light-mode; horizontal-stretch: 1; minimum: 0; maximum: max(1, root.duration); value: root.position; enabled: root.transport-enabled && root.duration > 0; label: "Playback position"; value-text: root.format-time(root.position); released(value) => { root.seek(value); } }
                Text { width: 40px; text: root.duration > 0 ? root.format-time(root.duration) : root.length-listed ? root.known-length : ""; color: root.secondary; font-size: 11px; vertical-alignment: center; }
            }
        }
        HorizontalLayout {
            width: root.side-width;
            spacing: 4px;
            alignment: end;
            cross-axis-alignment: center;
            if root.ratings-right : RatingButton { width: 32px; height: 34px; enabled: root.rating-enabled && !root.rating-busy; light-mode: root.light-mode; active: root.rating == 1; label: root.rating == 1 ? "Remove like" : "Like this song on YouTube Music"; clicked => { root.rate(root.rating == 1 ? 0 : 1); } }
            if root.ratings-right : RatingButton { width: 32px; height: 34px; negative: true; enabled: root.rating-enabled && !root.rating-busy; light-mode: root.light-mode; active: root.rating == -1; label: root.rating == -1 ? "Remove dislike" : "Dislike this song on YouTube Music"; clicked => { root.rate(root.rating == -1 ? 0 : -1); } }
            LibraryButton { width: 36px; height: 36px; show-tooltip: true; light-mode: root.light-mode; icon-path: "M 9 5 A 3 3 0 0 1 15 5 L 15 11 A 3 3 0 0 1 9 11 Z M 5 10 L 5 11 A 7 7 0 0 0 19 11 L 19 10 M 12 18 L 12 22 M 8 22 L 16 22"; label: root.lyrics-open ? "Close lyrics" : "Open lyrics"; active: root.lyrics-open; clicked => { root.toggle-lyrics(); } }
            LibraryButton { width: 36px; height: 36px; show-tooltip: true; light-mode: root.light-mode; icon-path: "M 4 6 L 20 6 M 4 12 L 14 12 M 4 18 L 14 18 M 18 12 L 23 15 L 18 18 Z"; label: root.queue-open ? "Close queue" : "Open queue"; active: root.queue-open; clicked => { root.toggle-queue(); } }
            LibraryButton { width: 36px; height: 36px; show-tooltip: true; light-mode: root.light-mode; icon-path: "M 3 4 L 21 4 L 21 20 L 3 20 Z M 12 12 L 19 12 L 19 18 L 12 18 Z"; label: "Open mini player"; clicked => { root.mini(); } }
            LibraryButton { width: 36px; height: 36px; show-tooltip: true; light-mode: root.light-mode; icon-path: root.volume <= 0 ? "M 3 9 L 7 9 L 12 5 L 12 19 L 7 15 L 3 15 Z M 16 9 L 22 15 M 22 9 L 16 15" : "M 3 9 L 7 9 L 12 5 L 12 19 L 7 15 L 3 15 Z M 16 8 C 19 10 19 14 16 16 M 19 5 C 24 9 24 15 19 19"; label: root.volume <= 0 ? "Unmute" : "Mute"; clicked => { root.toggle-mute(); } }
            if !root.narrow : TideSlider { reset-revision: root.input-revision; light-mode: root.light-mode; width: root.compact ? 90px : 116px; minimum: 0; maximum: 100; value: root.volume; step: root.volume-step; wheel-adjustable: true; label: root.volume-locked ? "Volume is set on your device in bit-perfect mode" : "Volume"; value-text: root.volume-locked ? "Device" : root.volume.to-fixed(0) + "%"; enabled: !root.volume-locked; changed(value) => { root.change-volume(value); } }
        }
    }

    // Mini player: the original two-row layout.
    if root.collapsed : VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 5px;
        Rectangle {
            height: 52px;
            HorizontalLayout {
                x: 0px;
                width: max(120px, parent.width / 2 - 94px);
                height: parent.height;
                spacing: 12px;
                cross-axis-alignment: center;
                Cover { width: 44px; height: 44px; artwork: root.artwork; light-mode: root.light-mode; seed: root.track-title; }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 1px;
                    // Right-to-left titles can paint outside an elided Text; clip them.
                Rectangle { height: 20px; min-width: 0px; clip: true; Text { width: parent.width; height: parent.height; vertical-alignment: center; text: root.track-title == "" ? "Nothing playing" : root.track-title; color: root.foreground; font-size: 14px; font-weight: 600; overflow: elide; } }
                    ArtistLink { artist: root.track-artist; enabled: root.artist-enabled; light-mode: root.light-mode; activated => { root.artist(); } }
                }
            }
            TransportButtons { enabled: root.transport-enabled; next-enabled: root.skip-enabled; x: (parent.width - self.width) / 2; y: 2px; width: 150px; height: 48px; paused: root.paused; light-mode: root.light-mode; repeat-enabled: root.repeat-enabled; show-repeat: false; show-shuffle: false; toggle-pause => { root.toggle-pause(); } previous-track => { root.previous-track(); } next-track => { root.next-track(); } }
            HorizontalLayout {
                x: parent.width - self.width;
                y: 8px;
                width: 150px;
                height: 36px;
                spacing: 4px;
                RatingButton { width: 32px; height: 36px; enabled: root.rating-enabled && !root.rating-busy; light-mode: root.light-mode; active: root.rating == 1; label: root.rating == 1 ? "Remove like" : "Like this song on YouTube Music"; clicked => { root.rate(root.rating == 1 ? 0 : 1); } }
                RatingButton { width: 32px; height: 36px; negative: true; enabled: root.rating-enabled && !root.rating-busy; light-mode: root.light-mode; active: root.rating == -1; label: root.rating == -1 ? "Remove dislike" : "Dislike this song on YouTube Music"; clicked => { root.rate(root.rating == -1 ? 0 : -1); } }
                LibraryButton { width: 36px; light-mode: root.light-mode; show-tooltip: true; icon-path: "M 9 3 L 15 3 L 14 9 L 18 13 L 6 13 L 10 9 Z M 12 13 L 12 21"; label: root.mini-pinned ? "Unpin mini player" : "Pin mini player above other windows"; active: root.mini-pinned; clicked => { root.toggle-mini-pin(); } }
                LibraryButton { width: 38px; light-mode: root.light-mode; show-tooltip: true; icon-path: "M 14 4 L 20 4 L 20 10 M 20 4 L 13 11 M 10 20 L 4 20 L 4 14 M 4 20 L 11 13"; label: "Expand to full Tide window"; clicked => { root.restore(); } }
            }
        }
        HorizontalLayout {
            height: 25px;
            spacing: 9px;
            cross-axis-alignment: center;
            Text { width: 38px; text: root.duration > 0 ? root.format-time(root.position) : root.length-listed ? "0:00" : ""; color: root.secondary; font-size: 11px; horizontal-alignment: right; }
            TideSlider { reset-revision: root.input-revision; light-mode: root.light-mode; horizontal-stretch: 1; minimum: 0; maximum: max(1, root.duration); value: root.position; enabled: root.transport-enabled && root.duration > 0; label: "Playback position"; value-text: root.format-time(root.position); released(value) => { root.seek(value); } }
            Text { width: 38px; text: root.duration > 0 ? root.format-time(root.duration) : root.length-listed ? root.known-length : ""; color: root.secondary; font-size: 11px; }
            VolumeMark { ink: root.secondary; }
            TideSlider { reset-revision: root.input-revision; light-mode: root.light-mode; width: 105px; minimum: 0; maximum: 100; value: root.volume; step: root.volume-step; wheel-adjustable: true; label: root.volume-locked ? "Volume is set on your device in bit-perfect mode" : "Volume"; value-text: root.volume-locked ? "Device" : root.volume.to-fixed(0) + "%"; enabled: !root.volume-locked; changed(value) => { root.change-volume(value); } }
            Text { width: 38px; text: root.volume.to-fixed(0) + "%"; color: root.secondary; font-size: 11px; horizontal-alignment: right; }
        }
    }
}
