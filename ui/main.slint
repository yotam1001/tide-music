                        VerticalLayout {
                            padding: 20px; spacing: 10px;
                            HorizontalLayout {
                                height: 36px; spacing: 8px; cross-axis-alignment: center;
                                Text { horizontal-stretch: 1; text: "Shared queue (" + root.rows.length + ")"; color: root.foreground; font-size: 23px; font-weight: 650; overflow: elide; }
                                LibraryButton {
                                    width: 104px; height: 36px; light-mode: root.light-mode; quiet: false; caption: "Add tracks";
                                    label: "Browse music to add to the shared queue";
                                    clicked => { root.jam-open = false; root.search-focus-revision += 1; }
                                }
