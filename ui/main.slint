            spacing: 0px;
            if !root.collapsed : Rectangle {
                height: 64px;
                background: root.light-mode ? #eee5db : #15181d;
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    spacing: 10px;
                    cross-axis-alignment: center;
                    Image { width: 28px; height: 28px; source: @image-url("assets/tide-icon.png"); image-fit: contain; }
                    Text { width: 56px; text: "Tide"; color: root.foreground; font-size: 21px; font-weight: 700; }
                    SearchMark { ink: root.secondary; }
                    LineEdit { horizontal-stretch: 1; enabled: root.browsing-enabled; text <=> root.source-input; placeholder-text: "Search music or paste a link"; accessible-label: "Search music or paste a YouTube link"; accepted(value) => { if value != "" { root.add-source(value); } } }
                    LibraryButton { width: 74px; light-mode: root.light-mode; enabled: root.browsing-enabled; caption: "Search"; label: "Search for music or open the pasted link"; clicked => { if root.source-input != "" { root.add-source(root.source-input); } } }
                    LibraryButton { width: 92px; light-mode: root.light-mode; caption: "Account"; label: "Open account and settings"; active: root.settings-open; clicked => { root.settings-open = !root.settings-open; } }
                }
            }
            if !root.collapsed : content-area := Rectangle {
                vertical-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                max-width: 10000px;
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 0px;
                    Rectangle {
                        width: 112px;
                        background: root.light-mode ? #eee5db : #15181d;
                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 18px;
                            spacing: 8px;
                            NavigationButton { light-mode: root.light-mode; enabled: root.browsing-enabled; active: !root.library-open; library: false; clicked => { root.library-open = false; root.home-open = true; root.close-detail(); root.close-search(); } }
                            NavigationButton { light-mode: root.light-mode; enabled: root.browsing-enabled; active: root.library-open; library: true; clicked => { root.library-open = true; root.home-open = false; root.close-detail(); root.close-search(); } }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        VerticalLayout {
                            padding: root.compact-mode ? 16px : 22px;
                            spacing: 12px;
                            if root.error-message != "" : Rectangle {
                                height: 58px;
                                border-radius: 8px;
                                background: root.light-mode ? #ecd7cc : #39252a;
                                HorizontalLayout {
                                    padding: 10px;
                                    spacing: 10px;
                                    cross-axis-alignment: center;
                                    Text { horizontal-stretch: 1; text: root.error-message; color: root.foreground; font-size: 12px; wrap: word-wrap; overflow: elide; accessible-live-region: assertive; }
                                    LibraryButton { width: root.error-is-account ? 128px : 70px; light-mode: root.light-mode; caption: root.error-is-account ? "Account settings" : root.error-retryable ? "Retry" : "Dismiss"; enabled: root.browsing-enabled; label: root.error-is-account ? "Open account settings to resolve the connection problem" : root.error-retryable ? "Retry interrupted playback or recommendations" : "Dismiss this error"; clicked => { root.retry-error(); } }
                                }
                            }
                            if root.detail-open : VerticalLayout {
                                spacing: 12px;
                                HorizontalLayout {
                                    height: 48px;
                                    spacing: 10px;
                                    cross-axis-alignment: center;
                                    VerticalLayout { horizontal-stretch: 1; spacing: 4px; Text { text: root.detail-title; color: root.foreground; font-size: 26px; font-weight: 600; overflow: elide; } Text { text: root.detail-busy ? "Loading tracks…" : "" + root.detail-rows.length + " tracks"; color: root.secondary; font-size: 12px; } }
                                    LibraryButton { width: 62px; light-mode: root.light-mode; enabled: root.browsing-enabled; caption: "Back"; label: "Close playlist details"; clicked => { root.close-detail(); } }
                                }
                                HorizontalLayout {
                                    height: 36px;
                                    spacing: 8px;
                                    LibraryButton { width: 84px; light-mode: root.light-mode; caption: "Play"; label: "Play " + root.detail-title; active: true; enabled: root.browsing-enabled && !root.detail-busy && root.detail-rows.length > 0; clicked => { root.play-detail(); } }
                                    LibraryButton { width: 84px; light-mode: root.light-mode; caption: "Shuffle"; label: "Shuffle " + root.detail-title; enabled: root.browsing-enabled && !root.detail-busy && root.detail-rows.length > 0; clicked => { root.shuffle-detail(); } }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                if root.detail-rows.length > 0 : ListView {
                                    content-y <=> root.detail-artwork-y;
                                    changed visible-height => { root.detail-artwork-height = self.visible-height; }
                                    vertical-stretch: 1;
                                    accessible-label: "Tracks in " + root.detail-title;
                                    for row[index] in root.detail-rows : SongRow { enabled: root.browsing-enabled; track: row; index: index; light-mode: root.light-mode; select => { root.select-detail-track(index); } queue(next) => { root.queue-detail-track(index, next); } radio => { root.start-track-radio(1, index); } }
                                }
                                if root.detail-rows.length == 0 : EmptyState { vertical-stretch: 1; light-mode: root.light-mode; heading: root.detail-busy ? "Loading tracks…" : "No tracks to show"; detail: root.detail-busy ? "Your playlist will appear here shortly." : "Choose another playlist from your Library."; }
                            }
                            if root.search-open && !root.detail-open : VerticalLayout {
                                spacing: 12px;
                                HorizontalLayout {
                                    height: 48px;
                                    spacing: 10px;
                                    cross-axis-alignment: center;
                                    VerticalLayout { horizontal-stretch: 1; spacing: 4px; Text { text: "Search results"; color: root.foreground; font-size: 26px; font-weight: 600; } Text { text: root.search-busy ? "Searching…" : "" + root.search-rows.length + " songs"; color: root.secondary; font-size: 12px; } }
                                    LibraryButton { width: 62px; light-mode: root.light-mode; enabled: root.browsing-enabled; caption: "Back"; label: "Close search results"; clicked => { root.close-search(); } }
                                }
                                if root.search-rows.length > 0 : ListView {
                                    content-y <=> root.search-artwork-y;
                                    changed visible-height => { root.search-artwork-height = self.visible-height; }
                                    vertical-stretch: 1;
                                    accessible-label: "Music search results";
                                    for row[index] in root.search-rows : SongRow { enabled: root.browsing-enabled; track: row; index: index; light-mode: root.light-mode; select => { root.select-search-track(index); } queue(next) => { root.queue-search-track(index, next); } radio => { root.start-track-radio(2, index); } }
                                }
                                if root.search-rows.length == 0 : EmptyState { vertical-stretch: 1; light-mode: root.light-mode; heading: root.search-busy ? "Searching…" : "No results yet"; detail: root.search-busy ? "Finding music for your search." : "Try another song title or artist in the search box."; }
                            }
                            if root.library-open && !root.detail-open && !root.search-open : VerticalLayout {
                                spacing: 12px;
                                HorizontalLayout {
                                    height: 48px;
                                    cross-axis-alignment: center;
                                    Text { horizontal-stretch: 1; text: "Your library"; color: root.foreground; font-size: 28px; font-weight: 600; }
                                    LibraryButton { width: 78px; light-mode: root.light-mode; caption: "Refresh"; label: "Refresh your playlists"; enabled: root.browsing-enabled && root.account-connected && !root.account-busy; clicked => { root.refresh-library(); } }
                                }
                                LibraryEntry { title: "Liked Songs"; subtitle: "Your favorites in one place"; light-mode: root.light-mode; enabled: root.browsing-enabled && root.account-connected && !root.account-busy; open => { root.play-liked(); } }
                                if root.library-playlists.length > 0 : ListView {
                                    content-y <=> root.library-artwork-y;
                                    changed visible-height => { root.library-artwork-height = self.visible-height; }
                                    vertical-stretch: 1;
                                    accessible-label: "Your saved playlists";
                                    for row[index] in root.library-playlists : LibraryEntry { title: row.title; subtitle: row.subtitle; artwork: row.artwork; light-mode: root.light-mode; enabled: root.browsing-enabled && root.account-connected && !root.account-busy; open => { root.select-library-playlist(index); } }
                                }
                                if root.library-playlists.length == 0 : EmptyState { vertical-stretch: 1; light-mode: root.light-mode; heading: root.account-busy ? "Loading your library…" : "Your playlists"; detail: root.account-connected ? "Refresh to load your saved playlists." : "Open Account to connect your YouTube Music session and load your library."; }
                            }
                            if !root.library-open && !root.detail-open && !root.search-open : VerticalLayout {
                                spacing: 12px;
                                HorizontalLayout {
                                    height: 48px;
                                    spacing: 10px;
                                    cross-axis-alignment: center;
                                    VerticalLayout { horizontal-stretch: 1; spacing: 4px; Text { text: "For you"; color: root.foreground; font-size: 28px; font-weight: 600; } Text { text: "Music from your YouTube Music Home"; color: root.secondary; font-size: 12px; overflow: elide; } }
                                    if root.current-index >= 0 && root.paused : LibraryButton { width: 78px; light-mode: root.light-mode; enabled: root.browsing-enabled; caption: "Resume"; label: "Resume your current queue"; clicked => { root.toggle-pause(); } }
                                    LibraryButton { width: 78px; light-mode: root.light-mode; caption: "Refresh"; label: "Refresh your recommendations"; enabled: root.browsing-enabled && root.account-connected && !root.account-busy; clicked => { root.refresh-recommendations(); } }
                                }
                                if root.recommendations.length > 0 : ListView {
                                    content-y <=> root.home-artwork-y;
                                    changed visible-height => { root.home-artwork-height = self.visible-height; }
                                    vertical-stretch: 1;
                                    accessible-label: "Home recommendations";
                                    for row[index] in root.recommendations : VerticalLayout {
                                        spacing: 0px;
                                        if row.kind == "song" : SongRow { track: { title: row.title, artist: row.subtitle, album: row.shelf, duration: "", artwork: row.artwork, recommended: false }; index: index; light-mode: root.light-mode; show-duration: false; enabled: root.browsing-enabled && root.account-connected && !root.account-busy; select => { root.select-recommendation(index); } queue(next) => { root.queue-recommendation(index, next); } radio => { root.start-track-radio(3, index); } }
                                        if row.kind != "song" : LibraryEntry { navigable: row.kind == "playlist"; unavailable-label: row.kind == "album" ? "Album unavailable" : "Unavailable"; title: row.title; subtitle: row.subtitle + (row.shelf == "" ? "" : " · " + row.shelf); artwork: row.artwork; light-mode: root.light-mode; enabled: root.browsing-enabled && root.account-connected && !root.account-busy && row.kind == "playlist"; open => { root.select-recommendation(index); } }
                                    }
                                }
                                if root.recommendations.length == 0 : EmptyState { vertical-stretch: 1; light-mode: root.light-mode; heading: root.account-busy ? "Loading your music…" : root.account-connected ? "Your recommendations" : "Welcome to Tide"; detail: root.account-connected ? "Refresh to load recommendations, or search for a song above." : "Search above to start listening. Open Account to connect YouTube Music and see your recommendations."; }
                            }
                        }
                    }
                    if root.queue-open && root.wide : QueueDrawer {
                        artwork-scroll-y <=> root.queue-artwork-y;
                        artwork-view-height <=> root.queue-artwork-height;
                        enabled: !root.settings-open;
                        width: 340px;
                        rows: root.rows;
                        current-index: root.current-index;
                        light-mode: root.light-mode;
                        autoplay-enabled: root.autoplay-enabled;
                        repeat-enabled: root.repeat-enabled;
                        close => { root.queue-open = false; }
                        select(index) => { root.select-track(index); }
                        remove(index) => { root.remove-queue-track(index); }
                        requeue(index, next) => { root.requeue-track(index, next); }
                        reorder(source, target) => { root.reorder-queue-track(source, target); }
                        radio(index) => { root.start-track-radio(0, index); }
                        toggle-autoplay => { root.toggle-autoplay(); }
                        toggle-repeat => { root.toggle-repeat(); }
                        shuffle => { root.shuffle-queue(); }
                        clear => { root.clear-queue(); }
                    }
                }
                if root.queue-open && !root.wide : Rectangle {
                    width: parent.width;
                    height: parent.height;
                    Rectangle { x: 0px; y: 0px; width: max(0px, parent.width - 340px); height: parent.height; background: #00000060; TouchArea { clicked => { root.queue-open = false; } } }
                    QueueDrawer {
                        artwork-scroll-y <=> root.queue-artwork-y;
                        artwork-view-height <=> root.queue-artwork-height;
                        enabled: !root.settings-open;
                        x: max(0px, parent.width - 340px);
                        width: 340px;
                        height: parent.height;
                        rows: root.rows;
                        current-index: root.current-index;
                        light-mode: root.light-mode;
                        autoplay-enabled: root.autoplay-enabled;
                        repeat-enabled: root.repeat-enabled;
                        close => { root.queue-open = false; }
                        select(index) => { root.select-track(index); }
                        remove(index) => { root.remove-queue-track(index); }
                        requeue(index, next) => { root.requeue-track(index, next); }
                        reorder(source, target) => { root.reorder-queue-track(source, target); }
                        radio(index) => { root.start-track-radio(0, index); }
                        toggle-autoplay => { root.toggle-autoplay(); }
                        toggle-repeat => { root.toggle-repeat(); }
                        shuffle => { root.shuffle-queue(); }
                        clear => { root.clear-queue(); }
                    }
                }
                if root.settings-open : Rectangle {
                    width: parent.width;
                    height: parent.height;
                    Rectangle { x: 0px; y: 0px; width: max(0px, parent.width - 420px); height: parent.height; background: #00000060; TouchArea { clicked => { root.settings-open = false; } } }
                    Rectangle {
                        x: max(0px, parent.width - 420px);
                        width: 420px;
                        height: parent.height;
                        background: root.surface;
                        border-width: 1px;
                        border-color: root.outline;
                        TouchArea { }
                        ScrollView {
                            width: parent.width;
                            height: parent.height;
                            horizontal-scrollbar-policy: always-off;
                            VerticalLayout {
                            padding: 20px;
                            spacing: 10px;
                            HorizontalLayout { height: 34px; cross-axis-alignment: center; Text { horizontal-stretch: 1; text: "Account & settings"; color: root.foreground; font-size: 20px; font-weight: 650; } LibraryButton { width: 30px; height: 30px; light-mode: root.light-mode; caption: "×"; label: "Close account and settings"; clicked => { root.settings-open = false; } } }
                            Text { height: 25px; text: root.account-busy ? "Connecting…" : root.account-verified ? "Connected" + (root.account-name == "" ? "" : " · " + root.account-name) : root.account-connected ? "Saved session · not verified" : "Connect YouTube Music"; color: root.foreground; font-size: 14px; font-weight: 600; overflow: elide; }
                            Text { height: 42px; text: root.account-status; color: root.secondary; font-size: 11px; wrap: word-wrap; overflow: elide; accessible-live-region: polite; }
                            HorizontalLayout { height: 34px; spacing: 8px; ComboBox { horizontal-stretch: 1; model: ["Account 1", "Account 2", "Account 3", "Account 4", "Account 5", "Account 6", "Account 7", "Account 8", "Account 9", "Account 10"]; current-index <=> root.account-index; enabled: root.account-connected && !root.account-busy; } LibraryButton { width: 76px; light-mode: root.light-mode; caption: "Switch"; label: "Connect selected Google account"; enabled: root.account-connected && !root.account-busy; clicked => { root.switch-account(root.account-index); } } }
                            HorizontalLayout {
                                height: 36px;
                                spacing: 8px;
                                LibraryButton { horizontal-stretch: 1; light-mode: root.light-mode; caption: root.account-connected ? "Reconnect" : "Connect account"; label: "Connect your local YouTube Music session"; enabled: !root.account-busy; active: !root.account-connected; clicked => { root.connect-account(); } }
                                if root.account-busy : LibraryButton { width: 76px; light-mode: root.light-mode; caption: "Cancel"; label: "Cancel account request"; clicked => { root.cancel-account(); } }
                            }
                            Rectangle { height: 1px; background: root.outline; }
                            HorizontalLayout { height: 36px; cross-axis-alignment: center; Text { horizontal-stretch: 1; text: "Appearance"; color: root.secondary; font-size: 12px; } LibraryButton { width: 116px; light-mode: root.light-mode; caption: root.light-mode ? "Use dark" : "Use light"; label: "Switch color theme"; clicked => { root.switch-mode(); } } }
                            HorizontalLayout { height: 36px; cross-axis-alignment: center; Text { horizontal-stretch: 1; text: "Window size"; color: root.secondary; font-size: 12px; } LibraryButton { width: 116px; light-mode: root.light-mode; caption: root.compact-mode ? "Full size" : "Compact"; label: "Switch window size"; clicked => { root.toggle-compact(); } } }
                            LibraryButton { height: 36px; light-mode: root.light-mode; caption: "Open audio file"; label: "Open a local audio file"; clicked => { root.open-file(); root.settings-open = false; } }
                            LibraryButton { height: 34px; light-mode: root.light-mode; caption: root.advanced-open ? "Advanced -" : "Advanced +"; label: root.advanced-open ? "Hide advanced account options" : "Show advanced account options"; active: root.advanced-open; clicked => { root.advanced-open = !root.advanced-open; } }
                            if root.advanced-open : HorizontalLayout {
                                height: 34px;
                                spacing: 8px;
                                LibraryButton { width: 124px; light-mode: root.light-mode; caption: "Import session"; label: "Import session from a local file"; enabled: !root.account-busy; clicked => { root.import-account(); } }
                                LibraryButton { horizontal-stretch: 1; light-mode: root.light-mode; caption: "Disconnect"; label: "Disconnect YouTube Music account"; enabled: root.account-connected && !root.account-busy; clicked => { root.disconnect-account(); } }
                                LibraryButton { width: 70px; light-mode: root.light-mode; caption: "Help"; label: "Help connecting your account"; clicked => { root.open-account-help(); } }
                            }
                            Rectangle { height: 12px; }
                            Rectangle { height: 1px; background: root.outline; }
                            Text { text: "About Tide · 0.1.0 preview"; color: root.secondary; font-size: 12px; }
                            AboutSlint { height: 112px; horizontal-stretch: 0; }
                            }
                        }
                    }
                }
            }
            if !root.collapsed && root.error-message == "" && root.status-text != "" : Rectangle {
                height: 24px;
                Text { x: 130px; width: max(0px, parent.width - 150px); height: parent.height; text: root.status-text; color: root.secondary; font-size: 11px; overflow: elide; vertical-alignment: center; accessible-live-region: polite; }
            }
            PlayerBar {
                window-minimized: root.minimized;
                preferred-height: 110px;
                min-height: 110px;
                max-height: root.collapsed ? 1000px : 110px;
                vertical-stretch: root.collapsed ? 1 : 0;
                track-title: root.track-title;
                track-artist: root.track-artist;
                artwork: root.current-artwork;
                position: root.position;
                duration: root.duration;
                paused: root.paused;
                volume: root.volume;
                light-mode: root.light-mode;
                compact: root.compact-mode;
                collapsed: root.collapsed;
                queue-open: root.queue-open;
                toggle-pause => { root.toggle-pause(); }
                next-track => { root.next-track(); }
                previous-track => { root.previous-track(); }
                seek(value) => { root.seek(value); }
                change-volume(value) => { root.change-volume(value); }
                restore => { root.collapse-player(); }
                mini => { root.collapse-player(); }
                toggle-queue => { root.queue-open = !root.queue-open; }
            }
        }
    }
}
