                    light-mode: root.light-mode; lines: root.lyrics-lines; active: root.lyrics-active; sung-prefix: root.lyrics-sung-prefix;
                    synced: root.lyrics-synced; status: root.lyrics-status; source: root.lyrics-source;
                    song: root.track-title; artist: root.track-artist; seek-enabled: !root.jam-guest;
                    effects-active: root.lyrics-effects-active; motion-enabled: root.lyrics-motion-enabled;
