                                        }
                                        Text { horizontal-stretch: 1; text: member.name; color: root.foreground; vertical-alignment: center; overflow: elide; }
                                        LibraryButton { width: 80px; light-mode: root.light-mode; caption: "Remove"; label: "Remove " + member.name + " and replace the invite"; clicked => { root.jam-remove-member(member.id); } }
                                    }
                                }
                                if root.jam-active && root.jam-guest && root.jam-listener-id > 0 : Text { text: "You are Listener " + root.jam-listener-id; color: root.foreground; font-weight: 600; }
                                if root.jam-active && !root.jam-guest : HorizontalLayout {
                                    height: 34px; spacing: 8px; alignment: start;
                                    LibraryButton { width: 144px; light-mode: root.light-mode; quiet: true; leading-icon: root.jam-locked ? "M 5 10 L 19 10 L 19 21 L 5 21 Z M 8 10 L 8 6 A 4 4 0 0 1 16 6 L 16 10" : "M 5 10 L 19 10 L 19 21 L 5 21 Z M 8 10 L 8 6 A 4 4 0 0 1 16 6"; caption: root.jam-locked ? "Allow joining" : "Lock room"; label: root.jam-locked ? "Allow new listeners to join" : "Prevent new listeners from joining"; clicked => { root.jam-toggle-lock(); } }
                                    LibraryButton { width: 144px; light-mode: root.light-mode; quiet: true; leading-icon: "M 18 3 L 21 7 L 17 10 M 21 7 L 8 7 C 2 7 2 17 8 17 L 19 17"; caption: "Replace invite"; label: "Replace the invite and invalidate the previous code"; clicked => { root.jam-rotate-invite(); } }
                                }
                                if root.jam-active : Text { height: 42px; text: root.jam-guest ? "Browse your music and select a song to add it to the shared queue. Press Next to request a skip for everyone. Your volume stays local." : "Send the invite code to friends. They paste it into Join a Jam. Each person plays using their own account."; color: root.secondary; font-size: 12px; wrap: word-wrap; }

                                if !root.jam-active : HorizontalLayout {
                                    height: root.sidebar-profile ? 194px : 154px; spacing: 28px;
                                    VerticalLayout {
                                        horizontal-stretch: 1; min-width: 0px; spacing: 12px; alignment: start;
                                        Text { text: "Start a Jam"; font-size: 20px; font-weight: 600; color: root.foreground; }
                                        Text { height: 50px; text: "Pick a song and invite friends to your shared queue."; color: root.secondary; font-size: 13px; wrap: word-wrap; }
                                        LibraryButton { height: 38px; light-mode: root.light-mode; caption: "Start Jam"; label: "Host the current YouTube queue with an invite code"; active: true; clicked => { root.jam-host-code(); } }
                                    }
