                                        Cover { width: 48px; height: 48px; artwork: track.artwork; light-mode: root.light-mode; }
                                        VerticalLayout {
                                            horizontal-stretch: 1; min-width: 0px; alignment: center; spacing: 3px;
                                            Text { text: track.title; color: root.foreground; font-size: 16px; font-weight: 600; overflow: elide; }
                                            Text { text: track.artist; color: root.secondary; font-size: 13px; overflow: elide; }
                                        }
                                        Text { width: 40px; text: track.duration; color: root.secondary; font-size: 11px; horizontal-alignment: right; }
                                    }
                                }
                            }
                        }
                    }
                }
