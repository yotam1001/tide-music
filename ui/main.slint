import { Button, ComboBox, LineEdit, ListView, Palette, ScrollView, Slider } from "std-widgets.slint";

export struct TrackRow {
    title: string,
    artist: string,
    album: string,
    duration: string,
    recommended: bool,
    artwork: image,
}

export struct PlaylistRow {
    id: string,
    title: string,
    subtitle: string,
    artwork: image,
}

export struct RecommendationRow {
    id: string,
    title: string,
    subtitle: string,
    artwork: image,
    kind: string,
    shelf: string,
}

component SearchMark inherits Path {
    in property <color> ink;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: Colors.transparent;
    stroke: root.ink;
    stroke-width: 1.6px;
    commands: "M 18 10 A 8 8 0 1 0 2 10 A 8 8 0 1 0 18 10 Z M 16 16 L 22 22";
}

component VolumeMark inherits Path {
    in property <color> ink;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: Colors.transparent;
    stroke: root.ink;
    stroke-width: 1.5px;
    commands: "M 3 9 L 7 9 L 12 5 L 12 19 L 7 15 L 3 15 Z M 16 8 C 19 10 19 14 16 16 M 19 5 C 24 9 24 15 19 19";
}

// The native slider supplies pointer, keyboard, focus and accessibility actions.
// Its value drives a tiny code-native treatment in the approved accent colors.
component TideSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in-out property <float> value: 0;
    in property <bool> enabled: true;
    in property <bool> light-mode: false;
    in property <string> label;
    in property <string> value-text;
    callback released(float);
    private property <float> fraction: root.maximum > root.minimum
        ? min(1, max(0, (root.value - root.minimum) / (root.maximum - root.minimum))) : 0;
    private property <color> accent: root.light-mode ? #ad574b : #a43352;

    min-width: 40px;
    min-height: 20px;
    horizontal-stretch: 1;
    forward-focus: native;

    Rectangle {
        x: 10px;
        y: (root.height - 4px) / 2;
        width: max(0px, root.width - 20px);
        height: 4px;
        border-radius: 2px;
        background: root.light-mode ? #b7a599 : #44464d;
    }
    Rectangle {
        x: 10px;
        y: (root.height - 4px) / 2;
        width: max(0px, root.width - 20px) * root.fraction;
        height: 4px;
        border-radius: 2px;
        background: root.enabled ? root.accent : (root.light-mode ? #c1b3aa : #4b4950);
    }
    Rectangle {
        x: 3px + max(0px, root.width - 20px) * root.fraction;
        y: (root.height - 14px) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        border-width: native.has-focus ? 2px : 0px;
        border-color: root.light-mode ? #68465d : #f2bccb;
        background: root.enabled ? root.accent : (root.light-mode ? #c1b3aa : #4b4950);
    }
    native := Slider {
        width: parent.width;
        height: parent.height;
        opacity: 0;
        minimum: root.minimum;
        maximum: root.maximum;
        value <=> root.value;
        enabled: root.enabled;
        accessible-label: root.label;
        accessible-value: root.value-text;
        changed(value) => { root.released(value); }
    }
}

// Buttons use Slint's standard Button for keyboard and accessibility behavior,
// while the surrounding rectangle supplies Tide's compact visual treatment.
component TideButton inherits Rectangle {
    in property <string> label;
    in property <string> caption;
    in property <color> surface-color;
    in property <color> text-color;
    in property <color> accent-color;
    in property <color> accent-text-color;
    in property <color> outline-color;
    in property <color> focus-color;
    in property <color> pressed-color;
    in property <bool> active: false;
    in property <bool> round: false;
    in property <bool> enabled: true;
    in property <length> caption-size: 14px;
    callback clicked;

    private property <string> icon-kind:
        root.caption == "⏮" ? "previous" : root.caption == "⏭" ? "next"
        : root.caption == "▶" ? "play" : root.caption == "Ⅱ" ? "pause"
        : root.caption == "↻" ? "repeat" : root.caption == "⌄" ? "collapse"
        : root.caption == "↗" ? "expand" : root.caption == "◐" || root.caption == "☼" ? "mode"
        : root.caption == "⌫" ? "clear" : root.caption == "＋" ? "add"
        : root.caption == "⇄" ? "shuffle" : root.caption == "→" ? "send" : "";
    private property <color> icon-color: root.active ? root.accent-text-color : root.text-color;

    border-radius: root.round ? self.height / 2 : 8px;
    border-width: control.has-focus ? 2px : 1px;
    border-color: control.has-focus ? root.focus-color : root.outline-color;
    background: root.active ? root.accent-color
        : control.pressed ? root.pressed-color : root.surface-color;
    opacity: root.enabled ? 1 : 0.45;

    control := Button {
        width: parent.width;
        height: parent.height;
        text: "";
        opacity: 0;
        accessible-label: root.label;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.icon-kind == "" ? root.caption : "";
        color: root.active ? root.accent-text-color : root.text-color;
        font-size: root.caption-size;
        font-weight: 650;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.icon-kind != "" : Path {
        x: (root.width - 20px) / 2;
        y: (root.height - 20px) / 2;
        width: 20px;
        height: 20px;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.icon-kind == "play" || root.icon-kind == "pause" || root.icon-kind == "previous" || root.icon-kind == "next" ? root.icon-color : Colors.transparent;
        stroke: root.icon-color;
        stroke-width: 1.5px;
        commands: root.icon-kind == "play" ? "M 7 4 L 20 12 L 7 20 Z"
            : root.icon-kind == "pause" ? "M 6 5 L 9 5 L 9 19 L 6 19 Z M 15 5 L 18 5 L 18 19 L 15 19 Z"
            : root.icon-kind == "previous" ? "M 6 5 L 6 19 M 18 5 L 9 12 L 18 19 Z"
            : root.icon-kind == "next" ? "M 18 5 L 18 19 M 6 5 L 15 12 L 6 19 Z"
            : root.icon-kind == "repeat" ? "M 17 3 L 21 7 L 17 11 M 21 7 L 7 7 C 4 7 3 9 3 12 M 7 21 L 3 17 L 7 13 M 3 17 L 17 17 C 20 17 21 15 21 12"
            : root.icon-kind == "shuffle" ? "M 3 6 L 7 6 C 11 6 13 18 17 18 L 21 18 M 17 14 L 21 18 L 17 22 M 3 18 L 7 18 C 11 18 13 6 17 6 L 21 6 M 17 2 L 21 6 L 17 10"
            : root.icon-kind == "collapse" ? "M 5 9 L 12 16 L 19 9"
            : root.icon-kind == "expand" ? "M 14 4 L 20 4 L 20 10 M 20 4 L 10 14 M 10 5 L 5 5 L 5 19 L 19 19 L 19 14"
            : root.icon-kind == "mode" ? "M 12 3 A 9 9 0 1 0 12 21 A 9 9 0 1 0 12 3 Z M 12 3 L 12 21 M 12 6 L 17 6 M 12 9 L 19 9 M 12 12 L 20 12 M 12 15 L 19 15 M 12 18 L 17 18"
            : root.icon-kind == "clear" ? "M 6 7 L 18 7 L 17 21 L 7 21 Z M 4 7 L 20 7 M 9 7 L 9 3 L 15 3 L 15 7 M 10 10 L 10 18 M 14 10 L 14 18"
            : root.icon-kind == "add" ? "M 12 5 L 12 19 M 5 12 L 19 12"
            : "M 4 12 L 20 12 M 14 6 L 20 12 L 14 18";
    }
}

// Code-native abstract cover art avoids loading and retaining large artwork in
// the lightweight layouts. The parent can replace this component once artwork
// becomes part of the shared track model.
component TransportButtons inherits Rectangle {
    in property <bool> paused;
    in property <bool> repeat-enabled;
    in property <bool> light-mode: false;
    in property <bool> show-repeat: true;
    in property <bool> show-shuffle: true;
    callback previous-track;
    callback toggle-pause;
    callback next-track;
    callback toggle-repeat;
    callback shuffle-queue;

    private property <color> surface: root.light-mode ? #eaded9 : #1b1c22;
    private property <color> foreground: root.light-mode ? #432d45 : #f3eff2;
    private property <color> accent: root.light-mode ? #ad574b : #9e304d;
    private property <color> accent-foreground: #fff8f6;
    private property <color> outline: root.light-mode ? #cfbdb7 : #323139;
    private property <color> focus-ring: root.light-mode ? #6e4b61 : #e1768b;
    private property <color> pressed: root.light-mode ? #dbc9c2 : #2c2730;

    HorizontalLayout {
        spacing: 9px;
        alignment: center;

        if root.show-shuffle : TideButton {
            width: 36px;
            height: 36px;
            label: "Shuffle upcoming tracks";
            caption: "⇄";
            surface-color: root.surface;
            text-color: root.foreground;
            accent-color: root.accent;
            accent-text-color: root.accent-foreground;
            outline-color: root.outline;
            focus-color: root.focus-ring;
            pressed-color: root.pressed;
            clicked => { root.shuffle-queue(); }
        }

        TideButton {
            width: 42px;
            height: 40px;
            label: "Previous track";
            caption: "⏮";
            surface-color: root.surface;
            text-color: root.foreground;
            accent-color: root.accent;
            accent-text-color: root.accent-foreground;
            outline-color: root.outline;
            focus-color: root.focus-ring;
            pressed-color: root.pressed;
            clicked => { root.previous-track(); }
        }

        TideButton {
            width: 48px;
            height: 44px;
            label: root.paused ? "Play" : "Pause";
            caption: root.paused ? "▶" : "Ⅱ";
            active: true;
            round: true;
            caption-size: 17px;
            surface-color: root.surface;
            text-color: root.foreground;
            accent-color: root.accent;
            accent-text-color: root.accent-foreground;
            outline-color: root.outline;
            focus-color: root.focus-ring;
            pressed-color: root.pressed;
            clicked => { root.toggle-pause(); }
        }

        TideButton {
            width: 42px;
            height: 40px;
            label: "Next track";
            caption: "⏭";
            surface-color: root.surface;
            text-color: root.foreground;
            accent-color: root.accent;
            accent-text-color: root.accent-foreground;
            outline-color: root.outline;
            focus-color: root.focus-ring;
            pressed-color: root.pressed;
            clicked => { root.next-track(); }
        }

        if root.show-repeat : TideButton {
            width: 38px;
            height: 38px;
            label: root.repeat-enabled ? "Turn repeat off" : "Turn repeat on";
            caption: "↻";
            active: root.repeat-enabled;
            surface-color: root.surface;
            text-color: root.foreground;
            accent-color: root.accent;
            accent-text-color: root.accent-foreground;
            outline-color: root.outline;
            focus-color: root.focus-ring;
            pressed-color: root.pressed;
            clicked => { root.toggle-repeat(); }
        }
    }
}

component LibraryButton inherits TideButton {
    in property <bool> light-mode: false;
    height: 36px;
    caption-size: 12px;
    surface-color: root.light-mode ? #efe4df : #1c1e24;
    text-color: root.light-mode ? #432d45 : #f4f0f2;
    accent-color: root.light-mode ? #ad574b : #982b49;
    accent-text-color: #fff8f6;
    outline-color: root.light-mode ? #c8b7b1 : #323139;
    focus-color: root.light-mode ? #68465d : #e1768b;
    pressed-color: root.light-mode ? #d4bfb8 : #2c2730;
}


// Artwork is provided by the music source. An absent cover is a small music note.
component Cover inherits Rectangle {
    in property <image> artwork;
    in property <bool> light-mode;
    border-radius: 7px;
    background: root.light-mode ? #e0d1c9 : #29262d;
    clip: true;
    if root.artwork != @image-url("") : Image {
        width: parent.width;
        height: parent.height;
        source: root.artwork;
        image-fit: cover;
    }
    if root.artwork == @image-url("") : Path {
        x: (parent.width - 22px) / 2;
        y: (parent.height - 22px) / 2;
        width: 22px;
        height: 22px;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: Colors.transparent;
        stroke: root.light-mode ? #956a61 : #bd8496;
        stroke-width: 1.5px;
        commands: "M 9 18 L 9 5 L 20 3 L 20 16 M 9 8 L 20 6 M 9 18 C 9 22 3 22 3 19 C 3 16 9 15 9 18 Z M 20 16 C 20 20 14 20 14 17 C 14 14 20 13 20 16 Z";
    }
}

component EmptyState inherits Rectangle {
    in property <bool> light-mode;
    in property <string> heading;
    in property <string> detail;
    background: root.light-mode ? #efe7e1 : #18191e;
    border-radius: 10px;
    border-color: root.light-mode ? #d5c5bc : #303036;
    border-width: 1px;
    VerticalLayout {
        padding: 28px;
        spacing: 10px;
        alignment: center;
        Text { text: root.heading; color: root.light-mode ? #392e33 : #f5eff2; font-size: 20px; font-weight: 650; horizontal-alignment: center; }
        Text { text: root.detail; color: root.light-mode ? #756870 : #aaa5ae; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
    }
}

component SongRow inherits Rectangle {
    in property <TrackRow> track;
    in property <int> index;
    in property <bool> current: false;
    in property <bool> light-mode;
    in property <bool> removable: false;
    in property <bool> can-move-up: false;
    in property <bool> can-move-down: false;
    in property <bool> show-menu: true;
    in property <bool> enabled: true;
    in property <bool> show-duration: true;
    callback select();
    callback remove();
    callback queue(bool);
    callback move(int);
    callback radio();
    private property <bool> menu-open: false;
    height: root.menu-open ? (root.removable && !root.current ? 174px : 140px) : 66px;
    border-radius: 7px;
    background: root.current ? (root.light-mode ? #e6cfc7 : #36222c) : (root.light-mode ? #efe7e1 : #18191e);
    border-width: action.has-focus ? 2px : 0px;
    border-color: root.light-mode ? #985955 : #d16b89;
    action := Button {
        width: parent.width;
        height: 66px;
        text: "";
        opacity: 0;
        enabled: root.enabled;
        accessible-label: "Play " + root.track.title + " by " + root.track.artist;
        clicked => { root.select(); }
    }
    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 0px;
        HorizontalLayout {
            height: 66px;
            spacing: 10px;
            cross-axis-alignment: center;
            Cover { width: 42px; height: 42px; artwork: root.track.artwork; light-mode: root.light-mode; }
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 60px;
                spacing: 4px;
                Text { text: root.track.title; color: root.light-mode ? #392e33 : #f5eff2; font-size: 13px; font-weight: root.current ? 650 : 500; overflow: elide; }
                Text { text: (root.current ? "Now playing · " : "") + root.track.artist; color: root.light-mode ? #756870 : #aaa5ae; font-size: 11px; overflow: elide; }
            }
            if root.show-duration && root.track.duration != "" && root.track.duration != "—" : Text { width: 42px; text: root.track.duration; color: root.light-mode ? #756870 : #aaa5ae; font-size: 11px; horizontal-alignment: right; }
            if root.show-menu : LibraryButton { width: 30px; height: 30px; caption: "..."; label: "Actions for " + root.track.title; light-mode: root.light-mode; enabled: root.enabled; active: root.menu-open; clicked => { root.menu-open = !root.menu-open; } }
            if root.removable : LibraryButton { width: 28px; height: 30px; caption: "×"; label: "Remove " + root.track.title + " from queue"; light-mode: root.light-mode; clicked => { root.remove(); } }
        }
        if root.menu-open : VerticalLayout {
            height: root.removable && !root.current ? 104px : 70px;
            spacing: 4px;
            HorizontalLayout {
                height: 32px;
                spacing: 6px;
                LibraryButton { width: 78px; height: 30px; caption: root.removable && root.current ? "Repeat next" : "Play next"; label: root.removable && !root.current ? "Move " + root.track.title + " to play next" : "Play " + root.track.title + " next"; light-mode: root.light-mode; clicked => { root.queue(true); root.menu-open = false; } }
                LibraryButton { width: 96px; height: 30px; caption: root.removable ? (root.current ? "Repeat later" : "Move to end") : "Add to queue"; label: root.removable && !root.current ? "Move " + root.track.title + " to the end of the queue" : "Add " + root.track.title + " to queue"; light-mode: root.light-mode; clicked => { root.queue(false); root.menu-open = false; } }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.removable && !root.current : HorizontalLayout {
                height: 30px;
                spacing: 6px;
                LibraryButton { width: 86px; height: 30px; caption: "Move up"; label: "Move " + root.track.title + " up in the queue"; light-mode: root.light-mode; enabled: root.can-move-up; clicked => { root.move(-1); root.menu-open = false; } }
                LibraryButton { width: 96px; height: 30px; caption: "Move down"; label: "Move " + root.track.title + " down in the queue"; light-mode: root.light-mode; enabled: root.can-move-down; clicked => { root.move(1); root.menu-open = false; } }
                Rectangle { horizontal-stretch: 1; }
            }
            LibraryButton { height: 30px; caption: "Replace upcoming with song radio"; label: "Replace upcoming tracks with a radio from " + root.track.title; light-mode: root.light-mode; clicked => { root.radio(); root.menu-open = false; } }
        }
    }
}

component LibraryEntry inherits Rectangle {
    in property <image> artwork;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> light-mode;
    in property <bool> enabled: true;
    in property <bool> navigable: true;
    in property <string> unavailable-label: "Unavailable";
    callback open();
    height: 76px;
    border-radius: 8px;
    background: root.light-mode ? #efe7e1 : #18191e;
    border-width: action.has-focus ? 2px : 0px;
    border-color: root.light-mode ? #985955 : #d16b89;
    action := Button { width: parent.width; height: parent.height; text: ""; opacity: 0; enabled: root.enabled && root.navigable; accessible-label: root.navigable ? "Open " + root.title : root.title + ", " + root.unavailable-label; clicked => { root.open(); } }
    HorizontalLayout {
        padding: 12px;
        spacing: 14px;
        cross-axis-alignment: center;
        Cover { width: 50px; height: 50px; artwork: root.artwork; light-mode: root.light-mode; }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 80px;
            spacing: 4px;
            Text { text: root.title; color: root.light-mode ? #392e33 : #f5eff2; font-weight: 600; overflow: elide; }
            Text { text: root.subtitle; color: root.light-mode ? #756870 : #aaa5ae; font-size: 12px; overflow: elide; }
        }
        if root.navigable : Text { width: 20px; text: "›"; color: root.light-mode ? #756870 : #aaa5ae; font-size: 20px; horizontal-alignment: center; }
        if !root.navigable : Text { width: 116px; text: root.unavailable-label; color: root.light-mode ? #756870 : #aaa5ae; font-size: 11px; horizontal-alignment: right; }
    }
}

component QueueDrawer inherits Rectangle {
    in property <[TrackRow]> rows;
    in property <int> current-index;
    in property <bool> light-mode;
    in property <bool> autoplay-enabled;
    in property <bool> repeat-enabled;
    callback close();
    callback select(int);
    callback remove(int);
    callback requeue(int, bool);
    callback move(int, int);
    callback radio(int);
    callback toggle-autoplay();
    callback toggle-repeat();
    callback shuffle();
    callback clear();
    private property <bool> overflow-open: false;
    background: root.light-mode ? #e9ddd5 : #141519;
    border-width: 1px;
    border-color: root.light-mode ? #d5c5bc : #303036;
    TouchArea { }
    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        HorizontalLayout {
            height: 34px;
            spacing: 7px;
            cross-axis-alignment: center;
            Text { horizontal-stretch: 1; text: "Queue"; color: root.light-mode ? #392e33 : #f5eff2; font-size: 19px; font-weight: 650; }
            LibraryButton { width: 30px; height: 30px; caption: "..."; label: "More queue actions"; light-mode: root.light-mode; active: root.overflow-open; clicked => { root.overflow-open = !root.overflow-open; } }
            LibraryButton { width: 30px; height: 30px; caption: "×"; label: "Close queue drawer"; light-mode: root.light-mode; clicked => { root.close(); } }
        }
        if root.overflow-open : HorizontalLayout {
            height: 34px;
            spacing: 6px;
            LibraryButton { horizontal-stretch: 1; light-mode: root.light-mode; caption: "Shuffle upcoming"; label: "Shuffle the upcoming queue"; enabled: root.rows.length > 1; clicked => { root.shuffle(); root.overflow-open = false; } }
            LibraryButton { width: 98px; light-mode: root.light-mode; caption: "Clear queue"; label: "Clear the playback queue"; enabled: root.rows.length > 0; clicked => { root.clear(); root.overflow-open = false; } }
        }
        if root.rows.length > 0 : ListView {
            vertical-stretch: 1;
            accessible-label: "Playback queue including manual choices and autoplay";
            for row[index] in root.rows : VerticalLayout {
                spacing: 0px;
                if index >= max(0, root.current-index) : VerticalLayout {
                    spacing: 0px;
                    if index == max(0, root.current-index) || index == root.current-index + 1 || row.recommended != root.rows[max(0, index - 1)].recommended : Text {
                        height: 28px;
                        text: index == root.current-index ? "NOW PLAYING" : row.recommended ? "AUTOPLAY" : "UP NEXT";
                        color: root.light-mode ? #956a61 : #bd8496;
                        font-size: 10px;
                        font-weight: 650;
                        vertical-alignment: center;
                    }
                    SongRow { track: row; index: index; current: index == root.current-index; light-mode: root.light-mode; removable: true; can-move-up: index > max(0, root.current-index + 1) && row.recommended == root.rows[max(0, index - 1)].recommended; can-move-down: index < root.rows.length - 1 && row.recommended == root.rows[min(root.rows.length - 1, index + 1)].recommended; show-duration: false; select => { root.select(index); } remove => { root.remove(index); } queue(next) => { root.requeue(index, next); } move(direction) => { root.move(index, direction); } radio => { root.radio(index); } }
                }
            }
        }
        if root.rows.length == 0 : EmptyState { vertical-stretch: 1; light-mode: root.light-mode; heading: "Queue is empty"; detail: "Choose a song or playlist to start listening."; }
        HorizontalLayout {
            height: 34px;
            spacing: 8px;
            cross-axis-alignment: center;
            Text { horizontal-stretch: 1; text: "Autoplay"; color: root.light-mode ? #756870 : #aaa5ae; font-size: 12px; }
            LibraryButton { width: 58px; light-mode: root.light-mode; caption: root.autoplay-enabled ? "On" : "Off"; label: root.autoplay-enabled ? "Turn autoplay off" : "Turn autoplay on"; active: root.autoplay-enabled; clicked => { root.toggle-autoplay(); } }
            LibraryButton { width: 82px; light-mode: root.light-mode; caption: "Repeat"; label: root.repeat-enabled ? "Turn repeat off" : "Turn repeat on"; active: root.repeat-enabled; clicked => { root.toggle-repeat(); } }
        }
    }
}

component PlayerBar inherits Rectangle {
    in property <bool> light-mode;
    in property <bool> compact;
    in property <bool> collapsed;
    in property <bool> queue-open;
    in property <string> track-title;
    in property <string> track-artist;
    in property <image> artwork;
    in property <float> position;
    in property <float> duration;
    in property <bool> paused;
    in property <float> volume;
    callback toggle-pause();
    callback next-track();
    callback previous-track();
