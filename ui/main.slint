                                        min-width: 0px; horizontal-stretch: 1; alignment: center; spacing: 6px;
                                        Text { text: "NOW PLAYING TOGETHER"; font-size: 11px; font-weight: 650; color: root.secondary; }
                                        Text { text: root.track-title; color: root.foreground; font-size: root.jam-queue-visible ? 30px : 16px; font-weight: 650; overflow: elide; }
                                        Text { text: root.track-artist; color: root.secondary; font-size: 13px; overflow: elide; }
                                        Rectangle {
                                            height: 4px; border-radius: 2px; background: root.outline;
                                            Rectangle { x: 0px; height: parent.height; width: parent.width * min(1, max(0, root.position / max(1, root.duration))); border-radius: 2px; background: root.light-mode ? #a94d46 : #b33d60; }
                                        }
                                    }
                                }
                                if root.jam-active : Rectangle { height: 1px; background: root.outline; }
                                if root.jam-active && !root.jam-guest && root.jam-members.length > 0 : Text { text: "Listeners (" + root.jam-members.length + ")"; color: root.foreground; font-size: 18px; font-weight: 600; }
                                if root.jam-active && !root.jam-guest : VerticalLayout {
