                                    height: root.sidebar-profile ? 48px : 36px;
                                    cross-axis-alignment: center;
                                    VerticalLayout {
                                        horizontal-stretch: 1; spacing: 2px; alignment: center;
                                        Text { text: root.library-section == 4 ? "Explore" : "Your Library"; color: root.foreground; font-size: 30px; font-weight: 800; }
                                        if root.sidebar-profile : Text { text: root.library-section == 4 ? "Browse charts, moods and genres" : "Your saved music and listening history"; color: root.secondary; font-size: 12px; overflow: elide; }
                                    }
                                    if root.library-section == 0 : LibraryButton {
                                        width: 116px; height: 36px; light-mode: root.light-mode;
                                        caption: "New playlist"; label: "Create a private playlist";
                                        enabled: root.browsing-enabled && root.collection-enabled && !root.collection-busy && !root.account-busy;
