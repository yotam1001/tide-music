                            if root.search-open && !root.detail-open : VerticalLayout {
                                spacing: 12px;
                                HorizontalLayout {
                                    height: 48px;
                                    spacing: 10px;
                                    cross-axis-alignment: center;
                                    VerticalLayout { horizontal-stretch: 1; spacing: 4px; Text { text: "Search results"; color: root.foreground; font-size: 30px; font-weight: 800; } Text { text: root.search-busy ? (root.search-result-count > 0 ? "Refreshing results…" : "Searching…") : "" + root.search-result-count + " results"; color: root.secondary; font-size: 12px; } }
                                    LibraryButton { width: 36px; show-tooltip: true; light-mode: root.light-mode; enabled: root.browsing-enabled; icon-path: "M 20 12 L 4 12 M 10 6 L 4 12 L 10 18"; label: "Close search results"; clicked => { root.close-search(); } }
                                }
                                HorizontalLayout {
                                    height: 32px; spacing: 8px; alignment: start;
                                    // "All" is kind 4, YouTube Music's unfiltered mix.
                                    for chip in [{ title: "All", kind: 4 }, { title: "Songs", kind: 0 }, { title: "Albums", kind: 1 }, { title: "Artists", kind: 2 }, { title: "Playlists", kind: 3 }] : LibraryTab {
                                        width: chip.kind == 4 ? 56px : chip.kind == 3 ? 88px : 76px;
                                        title: chip.title; label: chip.title + " search results"; selected: root.search-kind == chip.kind; light-mode: root.light-mode;
                                        enabled: root.browsing-enabled && !root.search-busy && !root.account-busy;
                                        select => { root.select-search-kind(chip.kind); }
                                    }
                                }
                                if root.search-note != "" : HorizontalLayout {
                                    min-height: 34px; spacing: 10px; cross-axis-alignment: center;
                                    Text { horizontal-stretch: 1; text: root.search-note; color: root.secondary; font-size: 12px; wrap: word-wrap; accessible-live-region: polite; }
                                    if root.search-retryable : LibraryButton {
                                        width: 76px; height: 32px; caption: "Retry"; label: "Retry this search";
                                        light-mode: root.light-mode; enabled: root.music-search-enabled && !root.search-busy;
                                        clicked => { root.select-search-kind(root.search-kind); }
                                    }
                                }
                                // Top result, like the hero card in other players' search.
                                if root.search-kind == 0 && root.search-rows.length > 0 && root.browse-width >= 600px && root.height >= 680px : Rectangle {
                                    height: 132px;
                                    border-radius: 10px;
                                    background: hero-touch.has-hover ? Theme.hover : Theme.raised;
                                    animate background { duration: ControlMotion.feedback; easing: ease-out; }
                                    hero-touch := TouchArea {
                                        enabled: root.browsing-enabled; mouse-cursor: pointer;
                                        clicked => { root.select-search-track(0); }
                                    }
                                    HorizontalLayout {
                                        padding: 16px; spacing: 18px;
                                        Cover { width: 100px; height: 100px; artwork: root.search-rows[0].artwork; light-mode: root.light-mode; seed: root.search-rows[0].title; drop-shadow-blur: 14px; drop-shadow-color: Theme.shadow; }
                                        VerticalLayout {
                                            horizontal-stretch: 1; min-width: 0px; spacing: 6px; alignment: center;
                                            Text { text: "TOP RESULT"; color: Theme.accent-ink; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
                                            Text { text: root.search-rows[0].title; color: root.foreground; font-size: 26px; font-weight: 800; overflow: elide; }
                                            Text { text: "Song · " + root.search-rows[0].artist; color: root.secondary; font-size: 14px; overflow: elide; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            LibraryButton {
                                                width: 52px; height: 52px; round: true; show-tooltip: true; light-mode: root.light-mode;
                                                active: true; icon-path: "M 7 4 L 20 12 L 7 20 Z";
                                                opacity: hero-touch.has-hover ? 1 : 0.92;
                                                label: (root.jam-guest ? "Add to shared queue: " : "Play ") + root.search-rows[0].title;
                                                enabled: root.browsing-enabled;
                                                clicked => { root.select-search-track(0); }
                                            }
                                        }
                                    }
                                }
                                if root.search-kind == 0 && root.search-rows.length > 0 : ListView {
                                    content-y <=> root.search-artwork-y;
                                    changed visible-height => { root.search-artwork-height = self.visible-height; }
                                    vertical-stretch: 1;
                                    accessible-label: "Music search results";
                                    for row[index] in root.search-rows : SongRow { shared-queue: root.jam-guest; collection-enabled: root.collection-enabled && !root.collection-busy; enabled: root.browsing-enabled; track: row; index: index; light-mode: root.light-mode; now-playing: root.current-index >= 0 && self.track.title == root.track-title && self.track.artist == root.track-artist; live: !root.paused; select => { root.select-search-track(index); } queue(next) => { root.queue-search-track(index, next); } radio => { root.start-track-radio(2, index); } artist => { root.open-artist(2, index); } add-playlist => { root.add-to-playlist(2, index); } }
                                }
                                if root.search-kind > 0 && root.search-cards.length > 0 : ListView {
