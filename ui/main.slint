                                spacing: 8px; alignment: start;
                                if !root.paused : EqualizerBars { width: 14px; height: 12px; active: true; }
                                Text { text: root.jam-guest ? "LISTENING WITH YOUR JAM" : root.paused ? "PAUSED" : "NOW PLAYING"; color: Theme.selected-ink; font-size: 11px; font-weight: 700; letter-spacing: 0.8px; }
                            }
                            Text { text: root.track-title; color: Theme.text; font-size: 34px; font-weight: 750; wrap: word-wrap; max-height: 130px; overflow: elide; }
                            ArtistLink { height: 24px; artist: root.track-artist; enabled: root.track-artist-enabled; light-mode: root.light-mode; label-size: 17px; activated => { root.now-playing-open = false; root.open-artist(4, 0); } }
                            if root.track-album != "" : Text { text: root.track-album; color: Theme.muted; font-size: 13px; overflow: elide; }
                            if root.audio-quality != "" : Text { text: root.audio-quality; color: Theme.muted; font-size: 11px; overflow: elide; }
                            Rectangle { height: 14px; }
                            HorizontalLayout {
                                height: 36px; spacing: 8px; alignment: start;
                                LibraryButton { width: 108px; height: 36px; border-radius: 18px; quiet: false; light-mode: root.light-mode; caption: "Lyrics"; leading-icon: "M 12 3 A 3 3 0 0 1 15 6 L 15 11 A 3 3 0 0 1 9 11 L 9 6 A 3 3 0 0 1 12 3 Z M 6 11 A 6 6 0 0 0 18 11 M 12 17 L 12 21"; label: "Open lyrics"; clicked => { root.now-playing-open = false; root.lyrics-open = true; } }
                                LibraryButton { width: 108px; height: 36px; border-radius: 18px; quiet: false; light-mode: root.light-mode; caption: "Queue"; leading-icon: "M 4 6 L 16 6 M 4 11 L 16 11 M 4 16 L 11 16 M 15 14 L 20 17 L 15 20 Z"; label: "Open the queue"; clicked => { root.now-playing-open = false; root.queue-open = true; } }
                            }
                            Rectangle { height: 10px; }
                            // Live lyrics preview, like the full-screen players.
                            if root.lyrics-lines.length > 0 : Text { text: "LYRICS"; color: Theme.muted; font-size: 11px; font-weight: 700; letter-spacing: 0.8px; }
                            if root.lyrics-lines.length > 0 : lyrics-window := Rectangle {
                                height: 5 * 34px;
                                property <int> first: max(0, min(root.lyrics-lines.length - 5, root.lyrics-active - 1));
                                lyrics-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    Button { width: parent.width; height: parent.height; opacity: 0; text: ""; accessible-label: "Open full lyrics"; clicked => { root.now-playing-open = false; root.lyrics-open = true; } }
                                }
                                VerticalLayout {
                                    for offset in min(5, root.lyrics-lines.length) : Text {
                                        height: 34px; vertical-alignment: center; overflow: elide;
                                        text: root.lyrics-lines[lyrics-window.first + offset].text;
                                        font-size: lyrics-window.first + offset == root.lyrics-active ? 20px : 17px;
                                        font-weight: 750;
                                        color: lyrics-window.first + offset == root.lyrics-active ? Theme.text
                                            : lyrics-window.first + offset < root.lyrics-active ? Theme.muted.with-alpha(0.55) : Theme.muted;
                                        animate font-size, color { duration: ControlMotion.selection; easing: ease-out; }
                                    }
                                }
                            }
                            if root.lyrics-lines.length == 0 : Text { text: "UP NEXT"; color: Theme.muted; font-size: 11px; font-weight: 700; letter-spacing: 0.8px; }
                            for offset in root.lyrics-lines.length > 0 ? 0 : min(4, np.upcoming) : Rectangle {
                                height: 52px; border-radius: 8px;
                                background: row-touch.has-hover ? Theme.hover : transparent;
                                row-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    Button { width: parent.width; height: parent.height; opacity: 0; text: ""; enabled: !root.jam-guest; accessible-label: "Play " + root.rows[root.current-index + 1 + offset].title + " now"; clicked => { root.select-track(root.current-index + 1 + offset); } }
                                }
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px; spacing: 12px; cross-axis-alignment: center;
                                    Cover { width: 40px; height: 40px; artwork: root.rows[root.current-index + 1 + offset].artwork; seed: root.rows[root.current-index + 1 + offset].title; light-mode: root.light-mode; }
                                    VerticalLayout {
                                        horizontal-stretch: 1; min-width: 0px; spacing: 2px; alignment: center;
                                        Text { text: root.rows[root.current-index + 1 + offset].title; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                                        Text { text: root.rows[root.current-index + 1 + offset].artist; color: Theme.muted; font-size: 12px; overflow: elide; }
                                    }
                                    Text { text: root.rows[root.current-index + 1 + offset].duration == "—" ? "" : root.rows[root.current-index + 1 + offset].duration; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                }
                            }
                            if np.upcoming == 0 && root.lyrics-lines.length == 0 : Text {
                                text: root.autoplay-enabled ? "Nothing queued. Autoplay will add similar songs." : "Nothing queued. Add songs from any song's menu.";
                                color: Theme.muted; font-size: 13px; wrap: word-wrap;
                            }
                        }
                    }
                    LibraryButton {
                        x: 16px; y: 14px; width: 36px; height: 36px; show-tooltip: true; light-mode: root.light-mode;
                        caption: "⌄"; label: "Close Now Playing";
                        clicked => { root.now-playing-open = false; }
                    }
                }
                if root.queue-open && !root.wide : Rectangle {
                    width: parent.width;
                    height: parent.height;
                    Rectangle { x: 0px; y: 0px; width: max(0px, parent.width - 340px); height: parent.height; background: #00000060; TouchArea { clicked => { root.queue-open = false; } } }
                    QueueDrawer {
                        live: !root.paused;
                        source-name: root.jam-guest ? "Shared Jam" : root.queue-source;
                        related-open <=> root.related-open;
                        related-enabled: root.account-verified && root.current-index >= 0;
                        related-rows: root.related-rows; related-note: root.related-note;
                        load-related => { root.load-related(); }
                        add-related(index) => { root.queue-related(index); }
                        query <=> root.queue-filter;
                        matches: root.queue-matches;
                        filter-changed => { root.filter-queue(); }
                        artwork-scroll-y <=> root.queue-artwork-y;
                        artwork-view-height <=> root.queue-artwork-height;
                        enabled: !root.settings-open && !root.account-open && !root.jam-open && !root.jam-guest;

                        x: max(0px, parent.width - 340px);
                        collection-enabled: root.collection-enabled && !root.collection-busy;
                        add-playlist(index) => { root.add-to-playlist(0, index); }
                        width: 340px;
                        height: parent.height;
                        rows: root.rows;
                        current-index: root.current-index;
                        light-mode: root.light-mode;
                        autoplay-enabled: root.autoplay-enabled;
                        repeat-enabled: root.repeat-enabled;
                        close => { root.queue-open = false; }
                        select(index) => { root.select-track(index); }
                        remove(index) => { root.remove-queue-track(index); }
                        requeue(index, next) => { root.requeue-track(index, next); }
                        reorder(source, target) => { root.reorder-queue-track(source, target); }
                        radio(index) => { root.start-track-radio(0, index); }
                        artist(index) => { root.open-artist(0, index); }
                        toggle-autoplay => { root.toggle-autoplay(); }
                        toggle-repeat => { root.toggle-repeat(); }
                        shuffle => { root.shuffle-queue(); }
                        clear => { root.clear-queue(); }
                    }
                }
                if root.settings-open : Rectangle {
                    width: parent.width; height: parent.height;
                    Rectangle {
                        x: 0px; y: 0px; width: max(0px, parent.width - 384px); height: parent.height; background: #00000070;
                        opacity: ControlMotion.enabled ? 0 : 1;
                        init => { self.opacity = 1; }
                        animate opacity { duration: ControlMotion.enabled ? 240ms : 0ms; easing: ease-out; }
                        TouchArea { clicked => { root.settings-open = false; } }
                    }
                    Rectangle {
                        property <length> slide: ControlMotion.enabled ? 384px : 0px;
                        init => { self.slide = 0; }
                        animate slide { duration: ControlMotion.enabled ? 280ms : 0ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
                        x: max(0px, parent.width - 384px) + self.slide; width: 384px; height: parent.height;
                        background: root.surface; border-width: 1px; border-color: root.outline;
                        drop-shadow-blur: 30px; drop-shadow-color: Theme.shadow;
                        TouchArea { }
                        ScrollView {
                            content-y <=> root.settings-scroll-y;
                            width: parent.width; height: parent.height; horizontal-scrollbar-policy: always-off;
                            VerticalLayout {
                                padding: 24px; spacing: 14px; alignment: start;
                                HorizontalLayout { height: 42px; cross-axis-alignment: center; Text { horizontal-stretch: 1; text: "Settings"; color: root.foreground; font-size: 26px; font-weight: 800; } LibraryButton { width: 32px; height: 32px; caption: "×"; label: "Close settings"; light-mode: root.light-mode; clicked => { root.settings-open = false; } } }
                                if root.settings-shortcuts-open : VerticalLayout {
                                    spacing: 12px; alignment: start;
                                    LibraryButton { height: 34px; caption: "‹  Back"; label: "Back to general settings"; light-mode: root.light-mode; clicked => { root.cancel-shortcut(); root.settings-shortcuts-open = false; } }
                                    Text { height: 24px; text: "Keyboard shortcuts"; font-size: 18px; font-weight: 600; color: root.foreground; }
                                    Text { height: 36px; text: "Select an action, then press a Ctrl or Alt combination. Esc cancels."; color: root.secondary; font-size: 12px; wrap: word-wrap; }
                                    ShortcutRow { action: "Play / pause"; binding: root.shortcut-toggle; recording: root.shortcut-recording-index == 0; light-mode: root.light-mode; record => { root.begin-shortcut(0); app-focus.focus(); } clear => { root.clear-shortcut(0); } }
                                    ShortcutRow { action: "Next song"; binding: root.shortcut-next; recording: root.shortcut-recording-index == 1; light-mode: root.light-mode; record => { root.begin-shortcut(1); app-focus.focus(); } clear => { root.clear-shortcut(1); } }
                                    ShortcutRow { action: "Previous song"; binding: root.shortcut-previous; recording: root.shortcut-recording-index == 2; light-mode: root.light-mode; record => { root.begin-shortcut(2); app-focus.focus(); } clear => { root.clear-shortcut(2); } }
                                    if root.shortcut-status != "" : Text { text: root.shortcut-status; color: root.secondary; font-size: 12px; wrap: word-wrap; accessible-live-region: polite; }
                                    Rectangle { height: 1px; background: root.outline; }
                                    Text { height: 56px; text: "While Tide has focus, press Space to play or pause, or J and L to seek 10 seconds. Media keys and custom shortcuts also work in the background."; color: root.secondary; font-size: 12px; wrap: word-wrap; }
                                }
                                if root.settings-audio-open : VerticalLayout {
                                    spacing: 12px; alignment: start;
                                    LibraryButton { height: 34px; caption: "‹  Back"; label: "Back to general settings"; light-mode: root.light-mode; clicked => { root.settings-audio-open = false; } }
                                    Text { text: "Audio"; color: root.foreground; font-size: 20px; font-weight: 600; }
                                    Text { text: "Output device"; color: root.secondary; font-size: 12px; }
                                    ComboBox { model: root.audio-device-names; current-index: root.audio-device-index; selected(value) => { root.choose-audio-device(self.current-index); } }
                                    Text { text: root.audio-status; color: root.secondary; font-size: 12px; wrap: word-wrap; accessible-live-region: polite; }
                                    Text { text: "Volume step for wheel and arrow keys"; color: root.secondary; font-size: 12px; }
                                    ComboBox { model: ["1%", "2%", "5%", "10%"]; current-index: root.volume-step-index; accessible-label: "Volume adjustment step"; selected(value) => { root.set-volume-step(self.current-index); } }
                                    PreferenceRow { title: "Even volume"; detail: "Smooth volume differences between songs."; checked: root.normalize-volume; light-mode: root.light-mode; toggled => { root.toggle-normalization(); } }
                                    Text { text: "Smooth out loud and quiet songs locally. This changes the sound and adds a small processing delay. Off preserves the original dynamics."; color: root.secondary; font-size: 12px; wrap: word-wrap; }
                                }
                                if !root.settings-shortcuts-open && !root.settings-audio-open : VerticalLayout {
                                    spacing: 10px; alignment: start;
                                    Text { height: 24px; text: "Listening"; color: root.foreground; font-size: 17px; font-weight: 700; }
                                    PreferenceRow { title: "Listening history"; detail: "Send played songs to YouTube Music for better recommendations."; checked: root.history-feedback-enabled; light-mode: root.light-mode; toggled => { root.toggle-history-feedback(); } }
                                    if root.history-feedback-status != "" : Text { text: root.history-feedback-status; color: root.secondary; font-size: 12px; wrap: word-wrap; accessible-live-region: polite; }
                                    PreferenceRow { title: "Discord activity"; detail: "Show the playing song on your Discord profile."; checked: root.discord-presence-enabled; light-mode: root.light-mode; toggled => { root.toggle-discord-presence(); } }
                                    PreferenceRow { title: "Animations"; detail: "Smooth transitions, hover effects and live level bars."; checked: root.animations-enabled; light-mode: root.light-mode; toggled => { root.toggle-animations(); } }
                                    if root.discord-presence-enabled : Text { text: root.discord-status; color: root.secondary; font-size: 12px; wrap: word-wrap; accessible-live-region: polite; }
                                    SettingsLink { title: "Audio"; icon-path: "M 4 10 L 8 10 L 13 5 L 13 19 L 8 14 L 4 14 Z M 17 8 C 21 10 21 14 17 16 M 19 4 C 27 9 27 15 19 20"; light-mode: root.light-mode; activated => { root.settings-audio-open = true; } }
                                    SettingsLink { title: "Keyboard shortcuts"; icon-path: "M 2 5 L 22 5 L 22 19 L 2 19 Z M 5 9 L 7 9 M 10 9 L 12 9 M 15 9 L 19 9 M 5 12 L 7 12 M 10 12 L 12 12 M 15 12 L 19 12 M 6 16 L 18 16"; light-mode: root.light-mode; activated => { root.settings-shortcuts-open = true; app-focus.focus(); } }
                                    Rectangle { height: 1px; background: root.outline; }
                                    LibraryButton { height: 34px; caption: root.settings-more-open ? "Advanced  −" : "Advanced  +"; label: "Show additional settings"; light-mode: root.light-mode; clicked => { root.settings-more-open = !root.settings-more-open; } }
                                    if root.settings-more-open : VerticalLayout {
                                        spacing: 10px; alignment: start;
                                        if root.windows-theme-supported : PreferenceRow { title: "Follow Windows theme"; checked: root.follow-windows-theme; light-mode: root.light-mode; toggled => { root.toggle-follow-windows-theme(); } }
                                        PreferenceRow { title: "Windows media keys"; checked: root.media-controls-enabled; light-mode: root.light-mode; toggled => { root.toggle-media-controls(); } }
                                        if root.media-controls-enabled : PreferenceRow { title: "Keep playing when I close Tide"; checked: root.close-to-tray; light-mode: root.light-mode; toggled => { root.toggle-close-to-tray(); } }
                                        PreferenceRow { title: "Skip known disliked songs"; checked: root.skip-disliked; light-mode: root.light-mode; toggled => { root.toggle-skip-disliked(); } }
                                        PreferenceRow { title: "Check for updates on startup"; checked: root.auto-update-checks; light-mode: root.light-mode; toggled => { root.toggle-update-checks(); } }
                                        Text { height: 18px; text: "Mini opacity · " + root.mini-opacity.to-fixed(0) + "%"; color: root.secondary; font-size: 12px; }
                                        TideSlider { height: 28px; light-mode: root.light-mode; minimum: 60; maximum: 100; value: root.mini-opacity; label: "Mini player opacity"; value-text: root.mini-opacity.to-fixed(0) + "%"; released(value) => { root.change-mini-opacity(value); } }
                                        AboutSlint { height: 112px; horizontal-stretch: 0; }
                                    }
                                }
                            }
                        }
                    }
                }
                if root.account-open : Rectangle {
                    width: parent.width;
                    height: parent.height;
