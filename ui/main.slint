                                    }
                                    if root.sidebar-profile && root.library-section != 3 : LibraryButton { width: 36px; height: 36px; show-tooltip: true; light-mode: root.light-mode; active: root.library-tiles; icon-path: root.library-tiles ? "M 4 6 L 20 6 M 4 12 L 20 12 M 4 18 L 20 18" : "M 3 3 L 9 3 L 9 9 L 3 9 Z M 15 3 L 21 3 L 21 9 L 15 9 Z M 3 15 L 9 15 L 9 21 L 3 21 Z M 15 15 L 21 15 L 21 21 L 15 21 Z"; label: root.library-tiles ? "Switch to list view" : "Switch to cover grid"; clicked => { root.toggle-library-view(); } }
                                    LibraryButton { width: 36px; show-tooltip: true; light-mode: root.light-mode; icon-path: "M 20 7 L 20 3 M 20 7 L 16 7 M 20 7 A 9 9 0 1 0 21 14"; label: "Refresh this Library section"; enabled: root.browsing-enabled && root.account-connected && !root.account-busy; clicked => { root.refresh-library(); } }
                                }
                                HorizontalLayout {
                                    height: 32px; spacing: 8px; alignment: start;
                                    for title[index] in ["Playlists", "Albums", "Artists", "History", "Explore"] : LibraryTab {
                                        title: title; selected: root.library-section == index; light-mode: root.light-mode;
                                        enabled: root.browsing-enabled && root.account-connected && !root.account-busy;
                                        select => { root.select-library-section(index); }
                                    }
                                }
                                if root.library-section == 4 : HorizontalLayout {
                                    height: 36px; spacing: 12px;
