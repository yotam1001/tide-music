                                if root.jam-active && root.jam-queue-notice != "" : Text { height: 48px; text: root.jam-queue-notice; color: root.foreground; font-size: 12px; wrap: word-wrap; accessible-live-region: polite; }
                                if root.jam-active && root.track-title != "" : HorizontalLayout {
                                    height: root.jam-queue-visible ? 210px : 82px;
                                    spacing: 18px; cross-axis-alignment: center;
