                VerticalLayout {
                    padding: 8px;
                    for suggestion[index] in root.search-suggestions : LibraryButton {
                        height: 36px; light-mode: root.light-mode; caption: suggestion; label: "Search for " + suggestion;
                        active: index == root.suggestion-index;
                        clicked => { root.select-suggestion(suggestion); }
                    }
                }
            }
        }
        if root.update-panel-open && !root.collapsed && !root.lyrics-open : Rectangle {
            width: root.width; height: root.height;
            TouchArea { clicked => { root.update-panel-open = false; } }
            Rectangle {
                x: 12px; y: parent.height - self.height - (root.jam-active ? 208px : 174px);
                width: 330px; height: 166px;
                background: root.surface; border-width: 1px; border-color: root.outline; border-radius: 12px;
                TouchArea { }
                VerticalLayout {
                    padding: 14px; spacing: 8px; alignment: start;
                    HorizontalLayout {
                        height: 28px; spacing: 8px; cross-axis-alignment: center;
                        Text { horizontal-stretch: 1; text: root.update-phase == 2 ? "Ready to restart" : "Tide updates"; color: root.foreground; font-weight: 650; font-size: 17px; }
                        Text { text: "Tide " + root.app-version; color: root.secondary; font-size: 11px; }
                        LibraryButton { width: 54px; height: 28px; light-mode: root.light-mode; caption: "Later"; label: "Close updates and keep listening"; clicked => { root.update-panel-open = false; } }
                    }
                    Text { height: 42px; text: root.update-available && !root.update-installable ? root.update-status + ". Use TideSetup.exe from GitHub to update this copy." : root.update-status; color: root.secondary; font-size: 12px; wrap: word-wrap; accessible-live-region: polite; }
                    HorizontalLayout {
                        height: 36px; spacing: 8px; cross-axis-alignment: center;
                        if root.update-installable && (root.update-available || root.update-phase > 0) : UpdateAction { horizontal-stretch: 1; height: 36px; light-mode: root.light-mode; busy: root.update-busy; phase: root.update-phase; progress: root.update-progress; activate => { root.install-update(); } cancel => { root.cancel-update(); } }
                        if !root.update-installable || (!root.update-available && root.update-phase == 0) : LibraryButton { width: 150px; height: 36px; quiet: false; caption: root.update-busy ? "Checking…" : "Check for updates"; label: "Check GitHub for a newer stable Tide release"; light-mode: root.light-mode; enabled: !root.update-busy; clicked => { root.check-updates(); } }
                    }
                }
            }
        }
        if !root.collapsed && root.playlist-picker-open : Rectangle {
            min-width: 0px; preferred-width: 0px; max-width: 10000px;
            min-height: 0px; preferred-height: 0px; max-height: 10000px;
            background: Colors.transparent;
            y: 64px; width: root.width; height: max(0px, root.height - (root.jam-active ? 208px : 174px));
            Rectangle { width: max(0px, parent.width - 420px); height: parent.height; background: Colors.transparent; TouchArea { clicked => { root.cancel-playlist-picker(); } } }
            Rectangle {
                x: max(0px, parent.width - 420px); width: min(420px, parent.width); height: parent.height;
                background: root.surface; border-width: 1px; border-color: root.outline;
                VerticalLayout {
                    padding: 12px; spacing: 8px;
                    HorizontalLayout { height: 36px;
                        Text { horizontal-stretch: 1; text: "Add to playlist"; color: root.foreground; font-size: 22px; font-weight: 650; }
                        LibraryButton { width: 32px; height: 32px; light-mode: root.light-mode; caption: "×"; label: "Close playlist chooser"; clicked => { root.cancel-playlist-picker(); } }
                    }
                    Text { height: 20px; text: root.playlist-picker-song; color: root.secondary; font-size: 12px; overflow: elide; }
                    if root.playlist-choices.length > 0 : ListView {
                        vertical-stretch: 1; min-height: 40px;
                        content-y <=> root.playlist-picker-artwork-y;
                        changed visible-height => { root.playlist-picker-artwork-height = self.visible-height; }
                        horizontal-scrollbar-policy: always-off;
                        for row[index] in root.playlist-choices : LibraryEntry {
                            cover-variant: row.cover-variant;
                            light-mode: root.light-mode; add-target: true;
                            title: row.title; subtitle: row.subtitle; artwork: row.artwork;
                            enabled: root.collection-enabled && !root.collection-busy && !root.playlist-choices-busy;
                            open => { root.pick-playlist(index); }
                        }
                    }
                    if root.playlist-choices.length == 0 : Text { vertical-stretch: 1; min-height: 40px; text: root.playlist-choices-busy ? "Refreshing your playlists…" : "No editable playlists loaded. Refresh your playlists, or create one in YouTube Music."; color: root.secondary; font-size: 12px; wrap: word-wrap; }
                    LibraryButton { height: 32px; light-mode: root.light-mode; caption: root.playlist-choices-busy ? "Refreshing…" : "Refresh playlists"; enabled: !root.playlist-choices-busy; label: "Refresh editable playlists from your selected account"; clicked => { root.refresh-playlist-choices(); } }
                    Text { height: 28px; text: "Saved to your selected YouTube Music account. Your playback queue stays separate."; color: root.secondary; font-size: 11px; wrap: word-wrap; }
                }
            }
        }
        if !root.collapsed && root.feedback-notice != "" : Rectangle {
            x: root.width - self.width - 18px; y: root.height - self.height - 122px;
            width: min(360px, root.width - 36px); height: 76px;
            background: root.surface; border-width: 1px; border-color: root.outline; border-radius: 8px;
            HorizontalLayout { padding: 12px; spacing: 10px;
                Text { horizontal-stretch: 1; text: root.feedback-notice; color: root.foreground; font-size: 12px; wrap: word-wrap; overflow: elide; accessible-live-region: polite; }
                LibraryButton { width: 28px; height: 28px; light-mode: root.light-mode; caption: "×"; label: "Dismiss feedback message"; clicked => { root.dismiss-feedback(); } }
            }
        }
    }
}
