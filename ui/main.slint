                    animate opacity { duration: ControlMotion.selection; easing: ease-out; }
                    TouchArea { }
                    property <length> art: max(140px, min(420px, min(self.height - 120px, (self.width - 160px) * 0.45)));
                    property <int> upcoming: max(0, root.rows.length - root.current-index - 1);
                    // Ambient backdrop: the cover itself, washed into the window.
                    // The lyrics controller's pre-blurred cover when available.
                    Image {
                        width: parent.width; height: parent.height;
                        source: root.lyrics-backdrop.width > 0 ? root.lyrics-backdrop : root.track-artwork; image-fit: cover;
                        opacity: root.lyrics-backdrop.width > 0 ? (Theme.light ? 0.35 : 0.55) : (Theme.light ? 0.14 : 0.2);
                    }
                    Rectangle {
                        background: @linear-gradient(180deg, Theme.window.with-alpha(0.35) 0%, Theme.window.with-alpha(0.82) 60%, Theme.window 100%);
                    }
                    Rectangle {
                        background: @linear-gradient(160deg, root.hero-color.with-alpha(Theme.light ? 0.36 : 0.5) 0%, root.hero-color.with-alpha(0.08) 55%, root.hero-color.with-alpha(0) 100%);
                    }
                    HorizontalLayout {
                        padding-left: 56px; padding-right: 56px; padding-top: 56px; padding-bottom: 32px;
                        spacing: 48px; alignment: center;
                        Cover {
                            width: np.art; height: np.art; border-radius: 14px;
                            artwork: root.track-artwork; seed: root.track-title; light-mode: root.light-mode;
                            drop-shadow-blur: 48px; drop-shadow-offset-y: 18px; drop-shadow-color: Theme.shadow;
                        }
