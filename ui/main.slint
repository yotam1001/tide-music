                        x: 0px; y: 0px; width: max(0px, parent.width - 420px); height: parent.height; background: #00000070;
                        opacity: ControlMotion.enabled ? 0 : 1;
                        init => { self.opacity = 1; }
                        animate opacity { duration: ControlMotion.enabled ? 240ms : 0ms; easing: ease-out; }
                        TouchArea { clicked => { root.account-open = false; } }
                    }
                    Rectangle {
                        property <length> slide: ControlMotion.enabled ? 420px : 0px;
                        init => { self.slide = 0; }
