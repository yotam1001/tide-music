            if root.jam-active : Rectangle {
                height: 34px; background: root.surface;
                HorizontalLayout { padding-left: 18px; padding-right: 18px; spacing: 10px; cross-axis-alignment: center;
                    Text { horizontal-stretch: 1; text: root.jam-queue-notice != "" ? root.jam-queue-notice : root.jam-status; color: root.foreground; font-size: 11px; overflow: elide; }
                    LibraryButton { width: 90px; height: 28px; light-mode: root.light-mode; caption: root.jam-guest ? "Leave Jam" : "End Jam"; label: "Stop participating in this Jam"; clicked => { root.jam-leave(); } }
                }
            }
            PlayerBar {
                expand => { root.now-playing-open = !root.now-playing-open; }
                now-playing-open: root.now-playing-open;
                tint: root.now-tint;
                tinted: root.has-now-tint;
                window-minimized: root.minimized;
                transport-enabled: !root.jam-guest;
                skip-enabled: root.can-skip;
                preferred-height: root.collapsed ? 110px : 92px;
                min-height: root.collapsed ? 110px : 92px;
                max-height: root.collapsed ? 1000px : 92px;
                vertical-stretch: root.collapsed ? 1 : 0;
                track-title: root.track-title;
                track-artist: root.track-artist;
                mini-pinned: root.mini-pinned;
                toggle-mini-pin => { root.toggle-mini-pin(); }
