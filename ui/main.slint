                                            }
                                        }
                                    }
                                    LibraryButton {
                                        width: 78px; height: 36px; active: true; light-mode: root.light-mode;
                                        caption: "Create"; label: "Save new private playlist";
                                        enabled: root.collection-enabled && !root.collection-busy && !root.account-busy && root.playlist-create-title != "";
                                        clicked => { root.create-playlist(root.playlist-create-title); }
                                    }
                                    LibraryButton {
                                        width: 72px; height: 36px; light-mode: root.light-mode;
                                        caption: "Cancel"; label: "Cancel creating the playlist";
                                        clicked => { root.playlist-create-open = false; root.playlist-create-title = ""; }
                                    }
                                }
                                if root.library-section == 0 : HorizontalLayout {
                                    height: root.sidebar-profile ? 56px : 34px;
                                    spacing: 10px;
                                    if root.sidebar-profile : QuickTile { horizontal-stretch: 1; min-width: 0px; title: "My Supermix"; kind: "mix"; light-mode: root.light-mode; enabled: root.browsing-enabled && root.account-connected && !root.account-busy; open => { root.open-supermix(); } }
                                    if root.sidebar-profile : QuickTile { horizontal-stretch: 1; min-width: 0px; title: "Liked Songs"; kind: "liked"; light-mode: root.light-mode; enabled: root.browsing-enabled && root.account-connected && !root.account-busy; open => { root.play-liked(); } }
                                    if !root.sidebar-profile : LibraryButton { quiet: false; horizontal-stretch: 1; height: 34px; caption: "My Supermix"; label: "Open My Supermix"; light-mode: root.light-mode; enabled: root.browsing-enabled && root.account-connected && !root.account-busy; clicked => { root.open-supermix(); } }
                                    if !root.sidebar-profile : LibraryButton { quiet: false; horizontal-stretch: 1; height: 34px; caption: "Liked Songs"; label: "Open Liked Songs"; light-mode: root.light-mode; enabled: root.browsing-enabled && root.account-connected && !root.account-busy; clicked => { root.play-liked(); } }
                                }
                                if root.library-note != "" : Text { height: 18px; text: root.library-note; font-size: 12px; color: root.secondary; overflow: elide; }
                                if root.library-section == 0 && root.library-playlists.length > 0 : library-list := ListView {
                                    content-y <=> root.library-artwork-y;
                                    changed visible-height => { root.library-artwork-height = self.visible-height; }
                                    vertical-stretch: 1;
                                    accessible-label: "Your saved playlists";
                                    for group in ceil(root.library-playlists.length / root.library-columns) : Rectangle {
                                        height: root.library-tiles ? LayoutMetrics.library-tile-height : LayoutMetrics.browse-row-height;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            for column in root.library-columns : Rectangle {
                                                horizontal-stretch: 1; min-width: 0px;
                                                private property <int> item-index: group * root.library-columns + column;
                                                if self.item-index < root.library-playlists.length && root.library-tiles : PlaylistTile {
                                                    width: parent.width; height: parent.height;
                                                    cover-variant: root.library-playlists[parent.item-index].cover-variant; title: root.library-playlists[parent.item-index].title; subtitle: root.library-playlists[parent.item-index].subtitle; artwork: root.library-playlists[parent.item-index].artwork;
                                                    light-mode: root.light-mode; enabled: root.browsing-enabled && root.account-connected && !root.account-busy;
                                                    open => { root.select-library-playlist(parent.item-index); }
                                                }
                                                if self.item-index < root.library-playlists.length && !root.library-tiles : LibraryEntry {
                                                    width: parent.width; height: parent.height;
                                                    cover-variant: root.library-playlists[parent.item-index].cover-variant; title: root.library-playlists[parent.item-index].title; subtitle: root.library-playlists[parent.item-index].subtitle; artwork: root.library-playlists[parent.item-index].artwork;
                                                    light-mode: root.light-mode; enabled: root.browsing-enabled && root.account-connected && !root.account-busy;
                                                    open => { root.select-library-playlist(parent.item-index); }
                                                }
                                            }
                                        }
                                    }
                                }
                                if root.library-section == 0 && root.library-playlists.length == 0 : EmptyState { vertical-stretch: 1; light-mode: root.light-mode; heading: root.account-busy ? "Loading your library…" : "Your playlists"; detail: root.account-connected ? "Refresh to load your saved playlists." : "Open Account to connect your YouTube Music session and load your library."; }
                                if root.library-section > 0 && root.library-cards.length > 0 : library-browse-list := ListView {
                                    content-y <=> root.library-artwork-y;
                                    changed visible-height => { root.library-artwork-height = self.visible-height; }
                                    vertical-stretch: 1; accessible-label: root.library-section == 1 ? "Saved albums" : root.library-section == 2 ? "Your artists" : root.library-section == 4 ? "Explore music" : "Listening history";
                                    for group in ceil(root.library-cards.length / root.library-browse-columns) : Rectangle {
