                audio-quality: root.audio-quality;
                playback-hint: root.collapsed && root.feedback-notice != "" ? root.feedback-notice : root.playback-hint;
                rating: root.current-rating;
                rating-enabled: root.rating-enabled;
                rating-busy: root.rating-busy;
                rate(value) => { root.rate-song(value); }
                artist => { root.lyrics-open = false; root.open-artist(4, 0); }
                artwork: root.current-artwork;
                position: root.position;
                duration: root.duration;
                paused: root.paused;
                volume: root.volume;
                volume-step: root.volume-step-index == 0 ? 1 : root.volume-step-index == 2 ? 5 : root.volume-step-index == 3 ? 10 : 2;
                light-mode: root.light-mode;
                compact: root.compact-mode;
                collapsed: root.collapsed;
                queue-open: root.queue-open;
                lyrics-open: root.lyrics-open;
                toggle-lyrics => { root.lyrics-open = !root.lyrics-open; }
                repeat-enabled: root.repeat-enabled;
                toggle-repeat => { root.toggle-repeat(); }
                shuffle-queue => { root.shuffle-queue(); }
                toggle-pause => { root.toggle-pause(); }
                next-track => { root.next-track(); }
                previous-track => { root.previous-track(); }
                seek(value) => { root.seek(value); }
                change-volume(value) => { root.change-volume(value); }
                restore => { root.collapse-player(); }
                mini => { root.collapse-player(); }
                toggle-queue => { root.queue-open = !root.queue-open; }
            }
