                                        Text { text: "Join friends"; font-size: 20px; font-weight: 600; color: root.foreground; }
                                        LineEdit { height: 38px; text <=> root.jam-code-input; placeholder-text: "Enter a room code or paste an invite"; accessible-label: "Guest Jam invite code"; }
                                        LibraryButton { height: 38px; light-mode: root.light-mode; caption: "Join Jam"; label: "Join using the pasted private invite code"; clicked => { root.jam-join-code(); } }
                                    }
                                }
                                if !root.jam-active : LibraryButton { height: 32px; light-mode: root.light-mode; caption: root.jam-advanced ? "Hide advanced setup" : "Advanced setup"; label: "Show or hide private server file setup"; clicked => { root.jam-advanced = !root.jam-advanced; } }
                                if !root.jam-active && root.jam-advanced : Text { text: "Jam server"; color: root.foreground; font-weight: 600; }
                                if !root.jam-active && root.jam-advanced : LineEdit { text <=> root.jam-endpoint; placeholder-text: "https://your-jam-server.example"; accessible-label: "Trusted Jam relay endpoint"; }
                                if !root.jam-active && root.jam-advanced : Text { height: 48px; text: "Private servers can require an operator key. Use the file flow for those servers or older invitations."; color: root.secondary; font-size: 11px; wrap: word-wrap; }
                                if !root.jam-active && root.jam-advanced : LibraryButton { height: 36px; light-mode: root.light-mode; caption: "Host with operator key…"; label: "Host the current YouTube queue and save a new private guest invite"; clicked => { root.jam-host(); } }
                                if !root.jam-active && root.jam-advanced : LibraryButton { height: 36px; light-mode: root.light-mode; caption: "Open invite file…"; label: "Select a private Jam invite and follow its host"; clicked => { root.jam-join(); } }
                                Rectangle { height: 12px; }
                                Text { height: 58px; text: "The free shared server currently allows two rooms. Use Advanced setup for your own server. Accounts and audio stay on each PC."; color: root.secondary; font-size: 11px; wrap: word-wrap; }
                            }
                        }
                    }
                    if root.jam-queue-visible : Rectangle {
                        x: parent.width * 0.59; width: parent.width - self.x; height: parent.height;
                        background: transparent;
