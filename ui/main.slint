                }
            }
        }
        if root.rows.length == 0 : EmptyState { vertical-stretch: 1; light-mode: root.light-mode; heading: "Queue is empty"; detail: "Choose a song or playlist to start listening."; }
        HorizontalLayout {
            height: 34px;
            spacing: 8px;
            cross-axis-alignment: center;
            Text { horizontal-stretch: 1; text: "Autoplay"; color: root.light-mode ? #716773 : #a1a5ae; font-size: 12px; }
            LibraryButton { width: 58px; light-mode: root.light-mode; enabled: root.enabled; caption: root.autoplay-enabled ? "On" : "Off"; label: root.autoplay-enabled ? "Turn autoplay off" : "Turn autoplay on"; active: root.autoplay-enabled; clicked => { root.toggle-autoplay(); } }
            LibraryButton { width: 82px; light-mode: root.light-mode; enabled: root.enabled; caption: "Repeat"; label: root.repeat-enabled ? "Turn repeat off" : "Turn repeat on"; active: root.repeat-enabled; clicked => { root.toggle-repeat(); } }
        }
    }
}

component PlayerBar inherits Rectangle {
    in property <bool> window-minimized: false;
    private property <int> input-revision: 0;
    private property <bool> repaint-phase: false;
    changed window-minimized => { root.input-revision += 1; }
    changed track-title => { root.input-revision += 1; }
    changed collapsed => { root.input-revision += 1; }
    // A changed label can otherwise survive in a reused Windows software
    // surface until resize. Invalidate only this small bar on live updates.
    changed volume => { root.repaint-phase = !root.repaint-phase; }
    changed position => { root.repaint-phase = !root.repaint-phase; }
    in property <bool> light-mode;
    in property <bool> compact;
    in property <bool> collapsed;
    in property <bool> queue-open;
    in property <string> track-title;
    in property <string> track-artist;
    in property <image> artwork;
    in property <float> position;
    in property <float> duration;
    in property <bool> paused;
    in property <float> volume;
    callback toggle-pause();
    callback next-track();
    callback previous-track();
    callback seek(float);
    callback change-volume(float);
    callback restore();
    callback toggle-queue();
    callback mini();
    private property <color> foreground: root.light-mode ? #392e33 : #f0eeef;
    private property <color> secondary: root.light-mode ? #716773 : #a1a5ae;
    background: root.light-mode ? #eee5db : #15181d;
    border-width: 1px;
    border-color: root.light-mode ? #ded0c4 : #292e37;
    Rectangle { x: 1px; y: 1px; width: max(0px, parent.width - 2px); height: max(0px, parent.height - 2px); background: root.light-mode ? #eee5db : #15181d; visible: root.repaint-phase; }
    pure function format-time(seconds: float) -> string {
        let total: int = max(0, seconds);
        let minutes: int = total / 60;
        let remainder: int = total - (minutes * 60);
        return minutes + ":" + (remainder < 10 ? "0" + remainder : remainder);
    }
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 5px;
        Rectangle {
            height: 52px;
            HorizontalLayout {
                x: 0px;
                width: max(120px, parent.width / 2 - 94px);
                height: parent.height;
                spacing: 12px;
                cross-axis-alignment: center;
                Cover { width: 44px; height: 44px; artwork: root.artwork; light-mode: root.light-mode; }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    Text { text: root.track-title == "" ? "Nothing playing" : root.track-title; color: root.foreground; font-size: 14px; font-weight: 600; overflow: elide; }
                    Text { text: root.track-artist; color: root.secondary; font-size: 12px; overflow: elide; }
                }
            }
            TransportButtons { x: (parent.width - self.width) / 2; y: 2px; width: 150px; height: 48px; paused: root.paused; light-mode: root.light-mode; show-repeat: false; show-shuffle: false; toggle-pause => { root.toggle-pause(); } previous-track => { root.previous-track(); } next-track => { root.next-track(); } }
            HorizontalLayout {
                x: parent.width - self.width;
                y: 8px;
                width: root.collapsed ? 38px : 148px;
                height: 36px;
                spacing: 12px;
                if !root.collapsed : LibraryButton { width: 80px; light-mode: root.light-mode; caption: "Queue"; label: root.queue-open ? "Close queue drawer" : "Open queue drawer"; active: root.queue-open; clicked => { root.toggle-queue(); } }
                if !root.collapsed : LibraryButton { width: 56px; light-mode: root.light-mode; caption: "Mini"; label: "Collapse to mini player"; clicked => { root.mini(); } }
                if root.collapsed : LibraryButton { width: 38px; light-mode: root.light-mode; caption: "↗"; label: "Expand to full Tide window"; clicked => { root.restore(); } }
            }
        }
        HorizontalLayout {
            height: 25px;
            spacing: 9px;
            cross-axis-alignment: center;
            Text { width: 38px; text: root.format-time(root.position); color: root.secondary; font-size: 11px; horizontal-alignment: right; }
            TideSlider { reset-revision: root.input-revision; light-mode: root.light-mode; horizontal-stretch: 1; minimum: 0; maximum: max(1, root.duration); value: root.position; enabled: root.duration > 0; label: "Playback position"; value-text: root.format-time(root.position); released(value) => { root.seek(value); } }
            Text { width: 38px; text: root.format-time(root.duration); color: root.secondary; font-size: 11px; }
            VolumeMark { ink: root.secondary; }
            TideSlider { reset-revision: root.input-revision; light-mode: root.light-mode; width: root.compact || root.collapsed ? 105px : 150px; minimum: 0; maximum: 100; value: root.volume; label: "Volume"; value-text: root.volume.to-fixed(0) + "%"; changed(value) => { root.change-volume(value); } }
            Text { width: 38px; text: root.volume.to-fixed(0) + "%"; color: root.secondary; font-size: 11px; horizontal-alignment: right; }
        }
    }
}
