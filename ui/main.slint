    callback toggle-pause();
    callback next-track();
    callback previous-track();
    callback seek(float);
    callback change-volume(float);
    callback toggle-repeat();
    callback shuffle-queue();
    callback switch-mode();
    callback collapse-player();
    callback open-file();
    callback clear-queue();

    in property <bool> detail-open;
    in property <string> detail-title;
    in property <[TrackRow]> detail-rows;
    in property <bool> detail-busy;
    in property <bool> search-open;
    in property <[TrackRow]> search-rows;
    in property <bool> search-busy;
    in property <string> error-message;
    in property <bool> error-is-account;
    in-out property <bool> settings-open: false;
    callback close-detail();
