import { Button, ComboBox, LineEdit, ListView, Palette, Slider } from "std-widgets.slint";

export struct TrackRow {
    title: string,
    artist: string,
    album: string,
    duration: string,
    artwork: image,
}

export struct PlaylistRow {
    id: string,
    title: string,
    subtitle: string,
    artwork: image,
}

export struct RecommendationRow {
    id: string,
    title: string,
    subtitle: string,
    artwork: image,
    kind: string,
    shelf: string,
}

component SearchMark inherits Path {
    in property <color> ink;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: Colors.transparent;
    stroke: root.ink;
    stroke-width: 1.6px;
    commands: "M 18 10 A 8 8 0 1 0 2 10 A 8 8 0 1 0 18 10 Z M 16 16 L 22 22";
}

component VolumeMark inherits Path {
    in property <color> ink;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: Colors.transparent;
    stroke: root.ink;
    stroke-width: 1.5px;
    commands: "M 3 9 L 7 9 L 12 5 L 12 19 L 7 15 L 3 15 Z M 16 8 C 19 10 19 14 16 16 M 19 5 C 24 9 24 15 19 19";
}

// The native slider supplies pointer, keyboard, focus and accessibility actions.
// Its value drives a tiny code-native treatment in the approved accent colors.
component TideSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in-out property <float> value: 0;
    in property <bool> enabled: true;
    in property <bool> light-mode: false;
    in property <string> label;
    in property <string> value-text;
    callback released(float);
    private property <float> fraction: root.maximum > root.minimum
        ? min(1, max(0, (root.value - root.minimum) / (root.maximum - root.minimum))) : 0;
    private property <color> accent: root.light-mode ? #ad574b : #a43352;

    min-width: 40px;
    min-height: 20px;
    horizontal-stretch: 1;
    forward-focus: native;

    Rectangle {
        x: 10px;
        y: (root.height - 4px) / 2;
        width: max(0px, root.width - 20px);
        height: 4px;
        border-radius: 2px;
        background: root.light-mode ? #b7a599 : #44464d;
    }
    Rectangle {
        x: 10px;
        y: (root.height - 4px) / 2;
        width: max(0px, root.width - 20px) * root.fraction;
        height: 4px;
        border-radius: 2px;
        background: root.enabled ? root.accent : (root.light-mode ? #c1b3aa : #4b4950);
    }
    Rectangle {
        x: 3px + max(0px, root.width - 20px) * root.fraction;
        y: (root.height - 14px) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        border-width: native.has-focus ? 2px : 0px;
        border-color: root.light-mode ? #68465d : #f2bccb;
        background: root.enabled ? root.accent : (root.light-mode ? #c1b3aa : #4b4950);
    }
    native := Slider {
        width: parent.width;
        height: parent.height;
        opacity: 0;
        minimum: root.minimum;
        maximum: root.maximum;
        value <=> root.value;
        enabled: root.enabled;
        accessible-label: root.label;
        accessible-value: root.value-text;
        changed(value) => { root.released(value); }
    }
}

// Buttons use Slint's standard Button for keyboard and accessibility behavior,
// while the surrounding rectangle supplies Tide's compact visual treatment.
component TideButton inherits Rectangle {
    in property <string> label;
    in property <string> caption;
    in property <color> surface-color;
    in property <color> text-color;
    in property <color> accent-color;
    in property <color> accent-text-color;
    in property <color> outline-color;
    in property <color> focus-color;
    in property <color> pressed-color;
    in property <bool> active: false;
    in property <bool> round: false;
    in property <bool> enabled: true;
    in property <length> caption-size: 14px;
    callback clicked;

    private property <string> icon-kind:
        root.caption == "⏮" ? "previous" : root.caption == "⏭" ? "next"
        : root.caption == "▶" ? "play" : root.caption == "Ⅱ" ? "pause"
        : root.caption == "↻" ? "repeat" : root.caption == "⌄" ? "collapse"
        : root.caption == "↗" ? "expand" : root.caption == "◐" || root.caption == "☼" ? "mode"
        : root.caption == "⌫" ? "clear" : root.caption == "＋" ? "add"
        : root.caption == "⇄" ? "shuffle" : root.caption == "→" ? "send" : "";
    private property <color> icon-color: root.active ? root.accent-text-color : root.text-color;

    border-radius: root.round ? self.height / 2 : 8px;
    border-width: control.has-focus ? 2px : 1px;
    border-color: control.has-focus ? root.focus-color : root.outline-color;
    background: root.active ? root.accent-color
        : control.pressed ? root.pressed-color : root.surface-color;
    opacity: root.enabled ? 1 : 0.45;

    control := Button {
        width: parent.width;
        height: parent.height;
        text: "";
        opacity: 0;
        accessible-label: root.label;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.icon-kind == "" ? root.caption : "";
        color: root.active ? root.accent-text-color : root.text-color;
        font-size: root.caption-size;
        font-weight: 650;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.icon-kind != "" : Path {
        x: (root.width - 20px) / 2;
        y: (root.height - 20px) / 2;
        width: 20px;
        height: 20px;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.icon-kind == "play" || root.icon-kind == "pause" || root.icon-kind == "previous" || root.icon-kind == "next" ? root.icon-color : Colors.transparent;
        stroke: root.icon-color;
        stroke-width: 1.5px;
        commands: root.icon-kind == "play" ? "M 7 4 L 20 12 L 7 20 Z"
            : root.icon-kind == "pause" ? "M 6 5 L 9 5 L 9 19 L 6 19 Z M 15 5 L 18 5 L 18 19 L 15 19 Z"
            : root.icon-kind == "previous" ? "M 6 5 L 6 19 M 18 5 L 9 12 L 18 19 Z"
            : root.icon-kind == "next" ? "M 18 5 L 18 19 M 6 5 L 15 12 L 6 19 Z"
            : root.icon-kind == "repeat" ? "M 17 3 L 21 7 L 17 11 M 21 7 L 7 7 C 4 7 3 9 3 12 M 7 21 L 3 17 L 7 13 M 3 17 L 17 17 C 20 17 21 15 21 12"
            : root.icon-kind == "shuffle" ? "M 3 6 L 7 6 C 11 6 13 18 17 18 L 21 18 M 17 14 L 21 18 L 17 22 M 3 18 L 7 18 C 11 18 13 6 17 6 L 21 6 M 17 2 L 21 6 L 17 10"
            : root.icon-kind == "collapse" ? "M 5 9 L 12 16 L 19 9"
            : root.icon-kind == "expand" ? "M 14 4 L 20 4 L 20 10 M 20 4 L 10 14 M 10 5 L 5 5 L 5 19 L 19 19 L 19 14"
            : root.icon-kind == "mode" ? "M 12 3 A 9 9 0 1 0 12 21 A 9 9 0 1 0 12 3 Z M 12 3 L 12 21 M 12 6 L 17 6 M 12 9 L 19 9 M 12 12 L 20 12 M 12 15 L 19 15 M 12 18 L 17 18"
            : root.icon-kind == "clear" ? "M 6 7 L 18 7 L 17 21 L 7 21 Z M 4 7 L 20 7 M 9 7 L 9 3 L 15 3 L 15 7 M 10 10 L 10 18 M 14 10 L 14 18"
            : root.icon-kind == "add" ? "M 12 5 L 12 19 M 5 12 L 19 12"
            : "M 4 12 L 20 12 M 14 6 L 20 12 L 14 18";
    }
}

// Code-native abstract cover art avoids loading and retaining large artwork in
// the lightweight layouts. The parent can replace this component once artwork
// becomes part of the shared track model.
component TransportButtons inherits Rectangle {
    in property <bool> paused;
    in property <bool> repeat-enabled;
    in property <bool> light-mode: false;
    in property <bool> show-repeat: true;
    in property <bool> show-shuffle: true;
    callback previous-track;
    callback toggle-pause;
    callback next-track;
    callback toggle-repeat;
    callback shuffle-queue;

    private property <color> surface: root.light-mode ? #eaded9 : #1b1c22;
    private property <color> foreground: root.light-mode ? #432d45 : #f3eff2;
    private property <color> accent: root.light-mode ? #ad574b : #9e304d;
    private property <color> accent-foreground: #fff8f6;
    private property <color> outline: root.light-mode ? #cfbdb7 : #323139;
    private property <color> focus-ring: root.light-mode ? #6e4b61 : #e1768b;
    private property <color> pressed: root.light-mode ? #dbc9c2 : #2c2730;

    HorizontalLayout {
        spacing: 9px;
        alignment: center;

        if root.show-shuffle : TideButton {
            width: 36px;
            height: 36px;
            label: "Shuffle upcoming tracks";
            caption: "⇄";
            surface-color: root.surface;
            text-color: root.foreground;
            accent-color: root.accent;
            accent-text-color: root.accent-foreground;
            outline-color: root.outline;
            focus-color: root.focus-ring;
            pressed-color: root.pressed;
            clicked => { root.shuffle-queue(); }
        }

        TideButton {
            width: 42px;
            height: 40px;
            label: "Previous track";
            caption: "⏮";
            surface-color: root.surface;
            text-color: root.foreground;
            accent-color: root.accent;
            accent-text-color: root.accent-foreground;
            outline-color: root.outline;
            focus-color: root.focus-ring;
            pressed-color: root.pressed;
            clicked => { root.previous-track(); }
        }

        TideButton {
            width: 48px;
            height: 44px;
            label: root.paused ? "Play" : "Pause";
            caption: root.paused ? "▶" : "Ⅱ";
            active: true;
            round: true;
            caption-size: 17px;
            surface-color: root.surface;
            text-color: root.foreground;
            accent-color: root.accent;
            accent-text-color: root.accent-foreground;
            outline-color: root.outline;
            focus-color: root.focus-ring;
            pressed-color: root.pressed;
            clicked => { root.toggle-pause(); }
        }

        TideButton {
            width: 42px;
            height: 40px;
            label: "Next track";
            caption: "⏭";
            surface-color: root.surface;
            text-color: root.foreground;
            accent-color: root.accent;
            accent-text-color: root.accent-foreground;
            outline-color: root.outline;
            focus-color: root.focus-ring;
            pressed-color: root.pressed;
            clicked => { root.next-track(); }
        }

        if root.show-repeat : TideButton {
            width: 38px;
            height: 38px;
            label: root.repeat-enabled ? "Turn repeat off" : "Turn repeat on";
            caption: "↻";
            active: root.repeat-enabled;
            surface-color: root.surface;
            text-color: root.foreground;
            accent-color: root.accent;
            accent-text-color: root.accent-foreground;
            outline-color: root.outline;
            focus-color: root.focus-ring;
            pressed-color: root.pressed;
            clicked => { root.toggle-repeat(); }
        }
    }
}

component LibraryButton inherits TideButton {
    in property <bool> light-mode: false;
    height: 36px;
    caption-size: 12px;
    surface-color: root.light-mode ? #efe4df : #1c1e24;
    text-color: root.light-mode ? #432d45 : #f4f0f2;
    accent-color: root.light-mode ? #ad574b : #982b49;
    accent-text-color: #fff8f6;
    outline-color: root.light-mode ? #c8b7b1 : #323139;
    focus-color: root.light-mode ? #68465d : #e1768b;
    pressed-color: root.light-mode ? #d4bfb8 : #2c2730;
}


// Artwork is provided by the music source. An absent cover is a small music note.
component Cover inherits Rectangle {
    in property <image> artwork;
    in property <bool> light-mode;
    border-radius: 7px;
    background: root.light-mode ? #e0d1c9 : #29262d;
    clip: true;
    if root.artwork != @image-url("") : Image {
        width: parent.width;
        height: parent.height;
        source: root.artwork;
        image-fit: cover;
    }
    if root.artwork == @image-url("") : Text {
        width: parent.width;
        height: parent.height;
        text: "♪";
        color: root.light-mode ? #956a61 : #bd8496;
        font-size: 26px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component EmptyState inherits Rectangle {
    in property <bool> light-mode;
    in property <string> heading;
    in property <string> detail;
    background: root.light-mode ? #efe7e1 : #18191e;
    border-radius: 10px;
    border-color: root.light-mode ? #d5c5bc : #303036;
    border-width: 1px;
    VerticalLayout {
        padding: 28px;
        spacing: 10px;
        alignment: center;
        Text { text: root.heading; color: root.light-mode ? #392e33 : #f5eff2; font-size: 20px; font-weight: 650; horizontal-alignment: center; }
        Text { text: root.detail; color: root.light-mode ? #756870 : #aaa5ae; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
    }
}

component MusicRow inherits Rectangle {
    in property <TrackRow> track;
    in property <int> index;
    in property <bool> current;
    in property <string> playback-label;
    in property <bool> compact;
    in property <bool> light-mode;
    callback play(int);
    callback remove(int);
    private property <color> foreground: root.light-mode ? #392e33 : #f5eff2;
    private property <color> secondary: root.light-mode ? #756870 : #aaa5ae;
    height: root.compact ? 64px : 68px;
    border-radius: 7px;
    background: root.current ? (root.light-mode ? #e6cfc7 : #36222c) : (root.light-mode ? #efe7e1 : #18191e);
    border-width: action.has-focus ? 2px : 0px;
    border-color: root.light-mode ? #985955 : #d16b89;
    action := Button {
        width: parent.width;
        height: parent.height;
        text: "";
        opacity: 0;
        accessible-label: (root.current ? "Currently playing: " : "Play: ") + root.track.title + " by " + root.track.artist;
        clicked => { root.play(root.index); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        cross-axis-alignment: center;
        Text { width: 28px; text: root.current ? "▶" : "" + (root.index + 1); color: root.current ? (root.light-mode ? #964e49 : #df87a0) : root.secondary; horizontal-alignment: center; font-size: 12px; }
        Cover { width: 42px; height: 42px; artwork: root.track.artwork; light-mode: root.light-mode; }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 100px;
            spacing: 3px;
            Text { text: root.track.title; color: root.foreground; font-size: 14px; font-weight: root.current ? 650 : 500; overflow: elide; }
            if root.compact : Text { text: (root.current ? "Now playing · " : "") + root.track.artist; color: root.secondary; font-size: 12px; overflow: elide; }
            if !root.compact : Text { text: root.playback-label; color: root.light-mode ? #964e49 : #df87a0; font-size: 9px; }
        }
        if !root.compact : Text { width: 180px; text: root.track.artist; color: root.secondary; font-size: 13px; overflow: elide; }
        if !root.compact : Text { width: 190px; text: root.track.album; color: root.secondary; font-size: 13px; overflow: elide; }
        Text { width: 48px; text: root.track.duration; color: root.secondary; font-size: 12px; horizontal-alignment: right; }
        LibraryButton { width: 34px; height: 32px; caption: "×"; label: "Remove " + root.track.title + " from queue"; light-mode: root.light-mode; clicked => { root.remove(root.index); } }
    }
}

component CatalogRow inherits Rectangle {
    in property <image> artwork;
    in property <string> title;
    in property <string> subtitle;
    in property <string> detail;
    in property <bool> light-mode;
    in property <bool> enabled: true;
    in property <bool> show-shuffle: false;
    callback play();
    callback shuffle();
    height: 78px;
    border-radius: 8px;
    background: root.light-mode ? #efe7e1 : #18191e;
    HorizontalLayout {
        padding: 12px;
        spacing: 14px;
        cross-axis-alignment: center;
        Cover { width: 50px; height: 50px; artwork: root.artwork; light-mode: root.light-mode; }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 80px;
            spacing: 3px;
            Text { text: root.title; color: root.light-mode ? #392e33 : #f5eff2; font-weight: 600; overflow: elide; }
            Text { text: root.subtitle; color: root.light-mode ? #756870 : #aaa5ae; font-size: 12px; overflow: elide; }
            if root.detail != "" : Text { text: root.detail; color: root.light-mode ? #956a61 : #bd8496; font-size: 10px; overflow: elide; }
        }
        LibraryButton { width: 66px; caption: "Play"; label: "Play " + root.title; light-mode: root.light-mode; active: true; enabled: root.enabled; clicked => { root.play(); } }
        if root.show-shuffle : LibraryButton { width: 76px; caption: "Shuffle"; label: "Shuffle " + root.title; light-mode: root.light-mode; enabled: root.enabled; clicked => { root.shuffle(); } }
    }
}

component PlayerBar inherits Rectangle {
    in property <bool> light-mode;
    in property <bool> compact;
    in property <bool> collapsed;
    in property <string> track-title;
    in property <string> track-artist;
    in property <image> artwork;
    in property <float> position;
    in property <float> duration;
    in property <bool> paused;
    in property <float> volume;
    in property <bool> repeat-enabled;
    callback toggle-pause();
    callback next-track();
    callback previous-track();
    callback toggle-repeat();
    callback shuffle-queue();
    callback seek(float);
    callback change-volume(float);
    callback restore();
    private property <color> foreground: root.light-mode ? #392e33 : #f5eff2;
    private property <color> secondary: root.light-mode ? #756870 : #aaa5ae;
    background: root.light-mode ? #e9ddd5 : #141519;
    border-width: 1px;
    border-color: root.light-mode ? #d5c5bc : #303036;
    pure function format-time(seconds: float) -> string {
        let total: int = max(0, seconds);
        let minutes: int = total / 60;
        let remainder: int = total - (minutes * 60);
        return minutes + ":" + (remainder < 10 ? "0" + remainder : remainder);
    }
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 5px;
        HorizontalLayout {
            height: 52px;
            spacing: 14px;
            cross-axis-alignment: center;
            Cover { width: 44px; height: 44px; artwork: root.artwork; light-mode: root.light-mode; }
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 92px;
                spacing: 4px;
                Text { text: root.track-title == "" ? "Nothing playing" : root.track-title; color: root.foreground; font-size: 14px; font-weight: 600; overflow: elide; }
                Text { text: root.track-artist == "" ? "Choose music from Home or your Library" : root.track-artist; color: root.secondary; font-size: 12px; overflow: elide; }
            }
            TransportButtons {
                width: root.collapsed ? 144px : 258px;
                height: 48px;
                paused: root.paused;
                light-mode: root.light-mode;
                repeat-enabled: root.repeat-enabled;
                show-repeat: !root.collapsed;
                show-shuffle: !root.collapsed;
                toggle-pause => { root.toggle-pause(); }
                previous-track => { root.previous-track(); }
                next-track => { root.next-track(); }
                toggle-repeat => { root.toggle-repeat(); }
                shuffle-queue => { root.shuffle-queue(); }
            }
            if root.collapsed : LibraryButton { width: 94px; light-mode: root.light-mode; caption: "Restore"; label: "Restore full Tide window"; clicked => { root.restore(); } }
        }
        HorizontalLayout {
            height: 25px;
            spacing: 9px;
            cross-axis-alignment: center;
            Text { width: 38px; text: root.format-time(root.position); color: root.secondary; font-size: 11px; horizontal-alignment: right; }
            TideSlider { light-mode: root.light-mode; horizontal-stretch: 1; minimum: 0; maximum: max(1, root.duration); value: root.position; enabled: root.duration > 0; label: "Playback position"; value-text: root.format-time(root.position); released(value) => { root.seek(value); } }
            Text { width: 38px; text: root.format-time(root.duration); color: root.secondary; font-size: 11px; }
            VolumeMark { ink: root.secondary; }
            TideSlider { light-mode: root.light-mode; width: root.compact || root.collapsed ? 105px : 150px; minimum: 0; maximum: 100; value: root.volume; label: "Volume"; value-text: root.volume.to-fixed(0) + "%"; released(value) => { root.change-volume(value); } }
            Text { width: 38px; text: root.volume.to-fixed(0) + "%"; color: root.secondary; font-size: 11px; horizontal-alignment: right; }
        }
    }
}

export component AppWindow inherits Window {
    in-out property <int> account-index;
    callback switch-account(int);
    callback connect-account();
    callback cancel-account();
    callback media-command(int, float);
    in property <[PlaylistRow]> library-playlists;
    in property <[RecommendationRow]> recommendations;
    in property <bool> account-connected;
    in property <bool> account-busy;
    in property <string> account-name;
    in property <string> account-status;
    in-out property <bool> library-open: false;
    in-out property <bool> home-open: true;
    in-out property <bool> queue-open: false;
    in-out property <bool> compact-mode: false;
    in property <bool> autoplay-enabled: false;
    callback toggle-compact();
    callback toggle-autoplay();
    callback shuffle-playlist(int);
    callback play-radio();
    callback remove-queue-track(int);
    callback import-account();
    callback refresh-library();
    callback disconnect-account();
    callback select-library-playlist(int);
    callback play-liked();
    callback refresh-recommendations();
    callback select-recommendation(int);
    callback open-account-help();
    in property <[TrackRow]> rows;
    in property <int> current-index;
    in property <string> track-title;
    in property <string> track-artist;
    in property <string> track-album;
    in property <image> track-artwork;
    in property <float> position;
    in property <float> duration;
    in property <bool> paused;
    in property <float> volume;
    in property <string> status-text;
    in-out property <string> source-input;
    in property <bool> light-mode;
    in property <bool> collapsed;
    in property <bool> repeat-enabled;
    callback add-source(string);
    callback select-track(int);
    callback toggle-pause();
    callback next-track();
    callback previous-track();
    callback seek(float);
    callback change-volume(float);
    callback toggle-repeat();
    callback shuffle-queue();
    callback switch-mode();
    callback collapse-player();
    callback open-file();
    callback clear-queue();
    private property <color> foreground: root.light-mode ? #392e33 : #f5eff2;
    private property <color> secondary: root.light-mode ? #756870 : #aaa5ae;
    private property <color> surface: root.light-mode ? #efe7e1 : #18191e;
    private property <color> outline: root.light-mode ? #d5c5bc : #303036;
    private property <image> current-artwork: root.track-artwork != @image-url("") ? root.track-artwork : root.current-index >= 0 && root.current-index < root.rows.length ? root.rows[root.current-index].artwork : @image-url("");
    private property <bool> show-home: root.home-open && !root.library-open && !root.queue-open;
    title: "Tide";
    icon: @image-url("assets/tide-icon.png");
    default-font-family: "Segoe UI";
    default-font-size: 14px;
    preferred-width: root.collapsed ? 700px : root.compact-mode ? 780px : 1140px;
    preferred-height: root.collapsed ? 132px : root.compact-mode ? 720px : 800px;
    min-width: root.collapsed ? 650px : root.compact-mode ? 700px : 950px;
    min-height: root.collapsed ? 112px : 660px;
    background: root.light-mode ? #f4ede7 : #101115;
    init => { Palette.color-scheme = root.light-mode ? light : dark; }
    changed light-mode => { Palette.color-scheme = root.light-mode ? light : dark; }

    VerticalLayout {
        spacing: 0px;
        if !root.collapsed : Rectangle {
            height: 62px;
            background: root.light-mode ? #e9ddd5 : #141519;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 9px;
                cross-axis-alignment: center;
                Image { width: 28px; height: 28px; source: @image-url("assets/tide-icon.png"); image-fit: contain; }
                Text { width: 44px; text: "Tide"; color: root.foreground; font-size: 22px; font-weight: 750; }
                LibraryButton { width: 74px; light-mode: root.light-mode; caption: "Home"; label: "Open Home"; active: root.show-home; clicked => { root.home-open = true; root.library-open = false; root.queue-open = false; } }
                LibraryButton { width: 74px; light-mode: root.light-mode; caption: "Library"; label: "Open your music library"; active: root.library-open; clicked => { root.home-open = false; root.library-open = true; root.queue-open = false; } }
                LibraryButton { width: 86px; light-mode: root.light-mode; caption: "Queue · " + root.rows.length; label: "Open playback queue"; active: root.queue-open; clicked => { root.home-open = false; root.library-open = false; root.queue-open = true; } }
                Rectangle { horizontal-stretch: 1; }
                LibraryButton { width: 70px; light-mode: root.light-mode; caption: root.light-mode ? "Dark" : "Light"; label: root.light-mode ? "Use dark theme" : "Use light theme"; clicked => { root.switch-mode(); } }
                LibraryButton { width: 82px; light-mode: root.light-mode; caption: root.compact-mode ? "Full size" : "Compact"; label: root.compact-mode ? "Use full window size" : "Use compact window size"; clicked => { root.toggle-compact(); } }
                LibraryButton { width: 70px; light-mode: root.light-mode; caption: "Mini"; label: "Collapse to mini player"; clicked => { root.collapse-player(); } }
            }
        }
        if !root.collapsed : Rectangle {
            height: 58px;
            background: root.light-mode ? #f4ede7 : #101115;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 10px;
                cross-axis-alignment: center;
                SearchMark { ink: root.secondary; }
                LineEdit { horizontal-stretch: 1; text <=> root.source-input; placeholder-text: "Search music or paste a YouTube link"; accessible-label: "Search music or paste a YouTube link"; accepted(value) => { if value != "" { root.add-source(value); } } }
                LibraryButton { width: 80px; light-mode: root.light-mode; active: true; caption: "Add music"; label: "Add search or link to queue"; clicked => { if root.source-input != "" { root.add-source(root.source-input); } } }
                LibraryButton { width: 80px; light-mode: root.light-mode; caption: "Open file"; label: "Open local audio file"; clicked => { root.open-file(); } }
            }
        }
        if !root.collapsed : Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 12px;
                padding-bottom: 14px;
                spacing: 14px;
                if root.show-home : VerticalLayout {
                    spacing: 14px;
                    HorizontalLayout {
                        height: 50px;
                        spacing: 12px;
                        cross-axis-alignment: center;
                        VerticalLayout { horizontal-stretch: 1; spacing: 3px; Text { text: "Home"; color: root.foreground; font-size: 26px; font-weight: 700; } Text { text: root.account-connected ? "Your music, ready to play" : "Find something to listen to"; color: root.secondary; font-size: 12px; } }
                        LibraryButton { width: 116px; light-mode: root.light-mode; caption: "Liked Songs"; label: "Play your Liked Songs"; enabled: root.account-connected && !root.account-busy; clicked => { root.play-liked(); } }
                        LibraryButton { width: 100px; light-mode: root.light-mode; caption: "My playlists"; label: "Browse your playlists"; clicked => { root.home-open = false; root.library-open = true; root.queue-open = false; } }
                    }
                    if root.current-index >= 0 : Rectangle {
                        height: 92px;
                        border-radius: 9px;
                        background: root.surface;
                        HorizontalLayout {
                            padding: 14px;
                            spacing: 14px;
                            cross-axis-alignment: center;
                            Cover { width: 58px; height: 58px; artwork: root.current-artwork; light-mode: root.light-mode; }
                            VerticalLayout { horizontal-stretch: 1; spacing: 4px; Text { text: "NOW PLAYING"; color: root.light-mode ? #956a61 : #bd8496; font-size: 10px; font-weight: 650; } Text { text: root.track-title; color: root.foreground; font-size: 16px; font-weight: 600; overflow: elide; } Text { text: root.track-artist; color: root.secondary; font-size: 12px; overflow: elide; } }
                            LibraryButton { width: 96px; light-mode: root.light-mode; caption: "Start radio"; label: "Start a radio from the current song"; clicked => { root.play-radio(); } }
                            LibraryButton { width: 92px; light-mode: root.light-mode; caption: "View queue"; label: "See the current song and upcoming tracks"; clicked => { root.home-open = false; root.library-open = false; root.queue-open = true; } }
                        }
                    }
                    HorizontalLayout {
                        height: 32px;
                        spacing: 10px;
                        cross-axis-alignment: center;
                        Text { horizontal-stretch: 1; text: "For you"; color: root.foreground; font-size: 18px; font-weight: 650; }
                        LibraryButton { width: 86px; light-mode: root.light-mode; caption: "Refresh"; label: "Refresh Home recommendations"; enabled: root.account-connected && !root.account-busy; clicked => { root.refresh-recommendations(); } }
                    }
                    if root.recommendations.length > 0 : ListView {
                        vertical-stretch: 1;
                        accessible-label: "Music recommendations from your YouTube Music Home";
                        for row[index] in root.recommendations : CatalogRow {
                            artwork: row.artwork;
                            title: row.title;
                            subtitle: row.subtitle;
                            detail: row.shelf + (row.shelf == "" ? "" : " · ") + row.kind;
                            light-mode: root.light-mode;
                            enabled: root.account-connected && !root.account-busy && (row.kind == "song" || row.kind == "playlist");
                            play => { root.select-recommendation(index); }
                        }
                    }
                    if root.recommendations.length == 0 : EmptyState {
                        vertical-stretch: 1;
                        light-mode: root.light-mode;
                        heading: root.account-busy ? "Loading your music…" : root.account-connected ? "Your recommendations" : "Welcome to Tide";
                        detail: root.account-connected ? "Refresh to load music from your YouTube Music Home. You can also search above." : "Search above to start listening, or open Library to connect your account and see your playlists.";
                    }
                }
                if root.library-open : VerticalLayout {
                    spacing: 12px;
                    HorizontalLayout {
                        height: 46px;
                        cross-axis-alignment: center;
                        Text { horizontal-stretch: 1; text: "Your library"; color: root.foreground; font-size: 26px; font-weight: 700; }
                        LibraryButton { width: 100px; light-mode: root.light-mode; caption: "Liked Songs"; label: "Play your Liked Songs"; enabled: root.account-connected && !root.account-busy; clicked => { root.play-liked(); } }
                    }
                    Rectangle {
                        height: 190px;
                        border-radius: 9px;
                        background: root.surface;
                        border-width: 1px;
                        border-color: root.outline;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 8px;
                            HorizontalLayout {
                                height: 28px;
                                cross-axis-alignment: center;
                                Text { horizontal-stretch: 1; text: root.account-busy ? "Connecting…" : root.account-connected ? "Connected" + (root.account-name == "" ? "" : " · " + root.account-name) : "Connect YouTube Music"; color: root.foreground; font-size: 17px; font-weight: 650; overflow: elide; accessible-live-region: polite; }
                                LibraryButton { width: 55px; height: 28px; light-mode: root.light-mode; caption: "Help"; label: "Help connecting your music account"; clicked => { root.open-account-help(); } }
                            }
                            Text { height: 30px; text: root.account-status; color: root.secondary; font-size: 11px; wrap: word-wrap; overflow: elide; accessible-live-region: polite; }
                            HorizontalLayout {
                                height: 34px;
                                spacing: 8px;
                                cross-axis-alignment: center;
                                Text { width: 96px; text: "Google account"; color: root.secondary; font-size: 12px; }
                                ComboBox { horizontal-stretch: 1; model: ["Account 1", "Account 2", "Account 3", "Account 4", "Account 5", "Account 6", "Account 7", "Account 8", "Account 9", "Account 10"]; current-index <=> root.account-index; enabled: root.account-connected && !root.account-busy; }
                                LibraryButton { width: 76px; light-mode: root.light-mode; caption: "Switch"; label: "Connect the selected Google account"; enabled: root.account-connected && !root.account-busy; clicked => { root.switch-account(root.account-index); } }
                                LibraryButton { width: 120px; light-mode: root.light-mode; caption: root.account-connected ? "Reconnect" : "Connect account"; label: "Connect YouTube Music from your local session"; active: !root.account-connected; enabled: !root.account-busy; clicked => { root.connect-account(); } }
                            }
                            HorizontalLayout {
                                height: 34px;
                                spacing: 8px;
                                LibraryButton { width: 116px; light-mode: root.light-mode; caption: "Import session"; label: "Import a local YouTube Music session file"; enabled: !root.account-busy; clicked => { root.import-account(); } }
                                LibraryButton { width: 100px; light-mode: root.light-mode; caption: "Disconnect"; label: "Disconnect your music account"; enabled: root.account-connected && !root.account-busy; clicked => { root.disconnect-account(); } }
                                LibraryButton { width: 76px; light-mode: root.light-mode; caption: "Cancel"; label: "Cancel the current account request"; enabled: root.account-busy; clicked => { root.cancel-account(); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }
                    HorizontalLayout {
                        height: 32px;
                        cross-axis-alignment: center;
                        Text { horizontal-stretch: 1; text: "Playlists · " + root.library-playlists.length; color: root.foreground; font-size: 18px; font-weight: 650; }
                        LibraryButton { width: 86px; light-mode: root.light-mode; caption: "Refresh"; label: "Refresh your saved playlists"; enabled: root.account-connected && !root.account-busy; clicked => { root.refresh-library(); } }
                    }
                    if root.library-playlists.length > 0 : ListView {
                        vertical-stretch: 1;
                        accessible-label: "Your saved YouTube Music playlists";
                        for row[index] in root.library-playlists : CatalogRow {
                            artwork: row.artwork;
                            title: row.title;
                            subtitle: row.subtitle;
                            light-mode: root.light-mode;
                            enabled: root.account-connected && !root.account-busy;
                            show-shuffle: true;
                            play => { root.select-library-playlist(index); }
                            shuffle => { root.shuffle-playlist(index); }
                        }
                    }
                    if root.library-playlists.length == 0 : EmptyState { vertical-stretch: 1; light-mode: root.light-mode; heading: root.account-busy ? "Loading playlists…" : "Your playlists"; detail: root.account-connected ? "Refresh to load your saved playlists." : "Connect or import a session above to load playlists and Liked Songs."; }
                }
                if root.queue-open || (!root.home-open && !root.library-open) : VerticalLayout {
                    spacing: 12px;
                    HorizontalLayout {
                        height: 50px;
                        spacing: 12px;
                        cross-axis-alignment: center;
                        VerticalLayout { horizontal-stretch: 1; spacing: 3px; Text { text: "Queue"; color: root.foreground; font-size: 26px; font-weight: 700; } Text { text: "" + root.rows.length + " tracks · " + max(0, root.rows.length - root.current-index - 1) + " upcoming"; color: root.secondary; font-size: 12px; } }
                        LibraryButton { width: 94px; light-mode: root.light-mode; caption: "Shuffle"; label: "Shuffle upcoming tracks"; enabled: root.rows.length > 1; clicked => { root.shuffle-queue(); } }
                        LibraryButton { width: 94px; light-mode: root.light-mode; caption: "Clear queue"; label: "Clear the playback queue"; enabled: root.rows.length > 0; clicked => { root.clear-queue(); } }
                    }
                    Rectangle {
                        height: 48px;
                        background: root.surface;
                        border-radius: 8px;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            cross-axis-alignment: center;
                            Text { horizontal-stretch: 1; text: "Autoplay · keep the music going after your queue"; color: root.secondary; font-size: 12px; overflow: elide; }
                            LibraryButton { width: 76px; light-mode: root.light-mode; caption: root.autoplay-enabled ? "On" : "Off"; active: root.autoplay-enabled; label: root.autoplay-enabled ? "Turn autoplay off" : "Turn autoplay on"; clicked => { root.toggle-autoplay(); } }
                            LibraryButton { width: 100px; light-mode: root.light-mode; caption: "Start radio"; label: "Start radio from the current song"; enabled: root.current-index >= 0; clicked => { root.play-radio(); } }
                        }
                    }
                    if root.rows.length > 0 : HorizontalLayout {
                        height: 20px;
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 12px;
                        Text { width: 28px; text: "#"; color: root.secondary; font-size: 10px; horizontal-alignment: center; }
                        Rectangle { width: 42px; }
                        Text { horizontal-stretch: 1; text: "TITLE"; color: root.secondary; font-size: 10px; }
                        if !root.compact-mode : Text { width: 180px; text: "ARTIST"; color: root.secondary; font-size: 10px; }
                        if !root.compact-mode : Text { width: 190px; text: "ALBUM"; color: root.secondary; font-size: 10px; }
                        Text { width: 48px; text: "TIME"; color: root.secondary; font-size: 10px; horizontal-alignment: right; }
                        Rectangle { width: 34px; }
                    }
                    if root.rows.length > 0 : ListView {
                        vertical-stretch: 1;
                        accessible-label: "Current song and upcoming playback queue";
                        for row[index] in root.rows : MusicRow {
                            track: row;
                            index: index;
                            current: index == root.current-index;
                            playback-label: index == root.current-index ? "NOW PLAYING" : index == root.current-index + 1 ? "UP NEXT" : "";
                            compact: root.compact-mode;
                            light-mode: root.light-mode;
                            play(index) => { root.select-track(index); }
                            remove(index) => { root.remove-queue-track(index); }
                        }
                    }
                    if root.rows.length == 0 : EmptyState { vertical-stretch: 1; light-mode: root.light-mode; heading: "Your queue is empty"; detail: "Search music, paste a YouTube link or choose a playlist from Library to start listening."; }
                }
            }
        }
        if !root.collapsed : Rectangle {
            height: 26px;
            Text {
                x: 20px;
                width: parent.width - 40px;
                height: parent.height;
                text: root.status-text;
                color: root.secondary;
                font-size: 11px;
                overflow: elide;
                vertical-alignment: center;
                accessible-live-region: polite;
            }
        }
        PlayerBar {
            preferred-height: 110px;
            min-height: 110px;
            max-height: root.collapsed ? 1000px : 110px;
            vertical-stretch: root.collapsed ? 1 : 0;
            track-title: root.track-title;
            track-artist: root.track-artist;
            artwork: root.current-artwork;
            position: root.position;
            duration: root.duration;
            paused: root.paused;
            volume: root.volume;
            repeat-enabled: root.repeat-enabled;
            light-mode: root.light-mode;
            compact: root.compact-mode;
            collapsed: root.collapsed;
            toggle-pause => { root.toggle-pause(); }
            next-track => { root.next-track(); }
            previous-track => { root.previous-track(); }
            toggle-repeat => { root.toggle-repeat(); }
            shuffle-queue => { root.shuffle-queue(); }
            seek(value) => { root.seek(value); }
            change-volume(value) => { root.change-volume(value); }
            restore => { root.collapse-player(); }
        }
    }
}
