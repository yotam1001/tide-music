        Rectangle { height: parent.height; width: parent.width * (root.phase == 2 ? 1 : (root.downloading ? clamp(root.progress / 100, 0, 1) : 0)); background: root.light-mode ? #b13e622c : #b13e6240; animate width { duration: 160ms; } }
        Rectangle { x: 5px; y: 5px; width: parent.height - 10px; height: self.width; border-radius: self.height / 2; background: root.light-mode ? #b45249 : #b13e62;
            Path { x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px; viewbox-width: 24; viewbox-height: 24; fill: Colors.transparent; stroke: #fff5ee; stroke-width: 2px; commands: root.phase == 2 ? "M5 12 L10 17 L19 7" : "M12 3 V15 M7 10 L12 15 L17 10 M5 17 V21 H19 V17"; }
        }
        Text { x: parent.height + 4px; width: max(0px, parent.width - self.x - 8px); height: parent.height; vertical-alignment: center; text: root.phase == 2 ? "Restart to update" : (root.phase == 3 ? "Canceling…" : (root.phase == 1 ? "Updating " + root.progress.to-fixed(0) + "%" : "Update Tide")); color: root.ink; font-size: 12px; font-weight: 600; overflow: elide; }
    }
    if root.downloading : Rectangle { x: parent.width - self.width; width: parent.height; height: parent.height; border-radius: self.height / 2; clip: true;
        LibraryButton { width: parent.width; height: parent.height; caption: "×"; label: "Cancel update download and keep listening"; light-mode: root.light-mode; quiet: false; enabled: root.phase == 1; clicked => { root.cancel(); } }
    }
}

component PlayerBar inherits Rectangle {
    in property <bool> transport-enabled: true;
    in property <bool> window-minimized: false;
    private property <int> input-revision: 0;
    private property <bool> repaint-phase: false;
