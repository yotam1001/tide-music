                                    heading: root.search-retryable ? "Search unavailable" : "No results yet";
                                    detail: root.search-retryable ? "" : "Try another search or category.";
                                }
                            }
                            if root.library-open && !root.detail-open && !root.search-open : VerticalLayout {
