                                                    enabled: root.browsing-enabled && root.account-connected && !root.account-busy;
                                                    shared-queue: root.jam-guest; collection-enabled: root.collection-enabled && !root.collection-busy;
                                                    select(index) => { root.select-library-card(index); } queue(index, next) => { root.queue-library-card(index, next); }
                                                    radio(index) => { root.start-track-radio(5, index); } artist(index) => { root.open-artist(5, index); } add-playlist(index) => { root.add-to-playlist(5, index); }
                                                }
                                            }
                                        }
                                    }
                                }
                                if root.library-section > 0 && root.library-cards.length == 0 : EmptyState {
                                    vertical-stretch: 1; light-mode: root.light-mode;
                                    heading: root.account-busy ? "Loading your library…" : root.library-section == 1 ? "Your saved albums" : root.library-section == 2 ? "Your artists" : root.library-section == 4 ? "Explore music" : "Listening history";
                                    detail: "Refresh to load this section from YouTube Music.";
                                }
                            }
                            if !root.library-open && !root.detail-open && !root.search-open : VerticalLayout {
                                spacing: 18px;
                                if root.account-connected || root.account-busy || root.jam-guest : HorizontalLayout {
                                    height: 48px;
                                    spacing: 10px;
                                    cross-axis-alignment: center;
                                    VerticalLayout { horizontal-stretch: 1; spacing: 4px; Text { text: root.jam-guest ? "Home" : root.greeting; color: root.foreground; font-size: 30px; font-weight: 800; overflow: elide; } Text { text: root.home-refreshing ? "Refreshing recommendations…" : root.jam-guest ? "Choose a song or press + to add it to the shared queue" : "Picks from your YouTube Music Home"; color: root.secondary; font-size: 13px; overflow: elide; } }
                                        LibraryButton { width: 36px; show-tooltip: true; light-mode: root.light-mode; icon-path: "M 20 7 L 20 3 M 20 7 L 16 7 M 20 7 A 9 9 0 1 0 21 14"; label: "Refresh your recommendations"; enabled: root.browsing-enabled && root.account-connected && !root.account-busy; clicked => { root.refresh-recommendations(); } }

                                }
                                if root.account-connected && root.height >= 620px : quick := Rectangle {
                                    property <int> columns: root.browse-width >= 760px ? 3 : 2;
                                    property <int> count: min(self.columns * 2, root.library-playlists.length + 2);
                                    property <length> tile-width: (self.width - 10px * (self.columns - 1)) / self.columns;
                                    property <bool> tiles-enabled: root.browsing-enabled && root.account-connected && !root.account-busy;
                                    height: ceil(self.count / self.columns) * 66px - 10px;
                                    QuickTile { x: 0px; y: 0px; width: quick.tile-width; title: "Liked Songs"; kind: "liked"; light-mode: root.light-mode; enabled: quick.tiles-enabled; open => { root.play-liked(); } }
                                    QuickTile { x: quick.tile-width + 10px; y: quick.columns == 2 ? 0px : 0px; width: quick.tile-width; title: "My Supermix"; kind: "mix"; light-mode: root.light-mode; enabled: quick.tiles-enabled; open => { root.open-supermix(); } }
                                    for row[index] in root.library-playlists : QuickTile {
                                        visible: index + 2 < quick.count;
                                        x: Math.mod(index + 2, quick.columns) * (quick.tile-width + 10px);
                                        y: floor((index + 2) / quick.columns) * 66px;
                                        width: quick.tile-width;
                                        title: row.title; kind: "playlist"; variant: row.cover-variant; artwork: row.artwork;
                                        light-mode: root.light-mode; enabled: quick.tiles-enabled;
                                        open => { root.select-library-playlist(index); }
                                    }
                                }
                                if root.recommendations.length > 0 : ListView {
                                    content-y <=> root.home-artwork-y;
                                    changed visible-height => { root.home-artwork-height = self.visible-height; }
                                    vertical-stretch: 1;
                                    accessible-label: "Home recommendations";
                                    for group in root.home-browse-rows : VerticalLayout {
                                        spacing: 0px; padding-bottom: LayoutMetrics.home-row-gap;
                                        if group.title != "" : Rectangle {
                                            height: LayoutMetrics.home-heading-height;
                                            Text { x: 0px; y: 6px; width: parent.width; height: 34px; text: group.title; color: root.foreground; font-size: 22px; font-weight: 750; overflow: elide; }
                                        }
                                        HorizontalLayout {
                                            height: group.layout == "compact" ? LayoutMetrics.home-compact-height : LayoutMetrics.library-tile-height; spacing: 12px;
                                            for column in (group.layout == "compact" ? min(2, root.home-columns) : root.home-columns) : Rectangle {
                                                horizontal-stretch: 1; min-width: 0px;
                                                private property <int> item-index: group.start + column;
                                                if column < group.count : HomeCard {
                                                    width: parent.width; height: parent.height; quick: group.layout == "compact";
                                                    item: root.recommendations[parent.item-index]; source-index: parent.item-index;
                                                    light-mode: root.light-mode; enabled: root.browsing-enabled && root.account-connected && !root.account-busy; shared-queue: root.jam-guest; collection-enabled: root.collection-enabled && !root.collection-busy;
                                                    select(index) => { root.select-recommendation(index); } queue(index, next) => { root.queue-recommendation(index, next); } radio(index) => { root.start-track-radio(3, index); } artist(index) => { root.open-artist(3, index); } add-playlist(index) => { root.add-to-playlist(3, index); }
                                                }
                                            }
                                        }
                                    }
                                }
                                if root.home-refreshing && root.recommendations.length == 0 : LoadingTracks { placeholder-color: root.outline; }
                                if !root.home-refreshing && root.recommendations.length == 0 : EmptyState {
                                    vertical-stretch: 1; light-mode: root.light-mode;
                                    welcome-actions: !root.account-connected && !root.account-busy && !root.jam-guest && root.browsing-enabled;
                                    heading: root.account-busy ? "Loading your music…" : root.account-connected ? "Your recommendations" : "Welcome to Tide";
                                    detail: root.account-connected ? "Refresh to load recommendations, or search for a song above." : "Connect YouTube Music to search songs, open your library, and see your recommendations.";
                                    connect-account => { root.account-open = true; }
                                }
                            }
                        }
                        Rectangle {
                            width: parent.width; height: parent.height;
                            background: Theme.surface;
                            opacity: 0;
                            states [
