import { AboutSlint, Button, ComboBox, LineEdit, ListView, Palette, ScrollView, Slider } from "std-widgets.slint";

// Artwork viewport calculations read these same logical dimensions from Rust.
export global LayoutMetrics {
    out property <length> browse-row-height: 72px;
    out property <length> queue-row-height: 66px;
    out property <length> queue-heading-height: 28px;
}

export struct TrackRow {
    title: string,
    artist: string,
    artist-enabled: bool,
    album: string,
    duration: string,
    recommended: bool,
    artwork: image,
}

export struct JamMemberRow { id: int, name: string }

export struct ArtistRow { id: string, name: string }

export struct PlaylistRow {
    id: string,
    title: string,
    subtitle: string,
    artwork: image,
}

export struct RecommendationRow {
    id: string,
    title: string,
    subtitle: string,
    artwork: image,
    kind: string,
    shelf: string,
}

component SearchMark inherits Path {
    in property <color> ink;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: Colors.transparent;
    stroke: root.ink;
    stroke-width: 1.6px;
    commands: "M 18 10 A 8 8 0 1 0 2 10 A 8 8 0 1 0 18 10 Z M 16 16 L 22 22";
}

component VolumeMark inherits Path {
    in property <color> ink;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: Colors.transparent;
    stroke: root.ink;
    stroke-width: 1.5px;
    commands: "M 3 9 L 7 9 L 12 5 L 12 19 L 7 15 L 3 15 Z M 16 8 C 19 10 19 14 16 16 M 19 5 C 24 9 24 15 19 19";
}

// The native slider supplies pointer, keyboard, focus and accessibility actions.
// Its value drives a tiny code-native treatment in the approved accent colors.
component TideSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> value: 0;
    in property <int> reset-revision: 0;
    // Native input must never assign the externally owned value: doing so
    // breaks its binding to the live clock/volume. Keep a local drag preview.
    private property <float> input-value: root.value;
    private property <bool> interacting: false;
    private property <bool> input-focused: native.has-focus;
    changed value => { if !root.interacting { root.input-value = root.value; } }
    changed maximum => { root.interacting = false; root.input-value = root.value; }
    changed reset-revision => { root.interacting = false; root.input-value = root.value; }
    changed enabled => { if !root.enabled { root.interacting = false; root.input-value = root.value; } }
    changed input-focused => { if !root.input-focused { root.interacting = false; root.input-value = root.value; } }
    in property <bool> enabled: true;
    in property <bool> light-mode: false;
    in property <string> label;
    in property <string> value-text;
    callback changed(float);
    callback released(float);
    private property <float> fraction: root.maximum > root.minimum
        ? min(1, max(0, (root.input-value - root.minimum) / (root.maximum - root.minimum))) : 0;
    private property <color> accent: root.light-mode ? #b45448 : #b33d60;

    min-width: 40px;
    min-height: 20px;
    horizontal-stretch: 1;
    forward-focus: native;
    // Accessibility adjustments are complete actions and have no pointer/key release.
    function commit-accessible(value: float) {
        if root.enabled {
            root.interacting = false;
            root.input-value = min(root.maximum, max(root.minimum, value));
            root.changed(root.input-value);
            root.released(root.input-value);
            root.input-value = root.value;
        }
    }

    Rectangle {
        x: 10px;
        y: (root.height - 4px) / 2;
        width: max(0px, root.width - 20px);
        height: 4px;
        border-radius: 2px;
        background: root.light-mode ? #b7a599 : #44464d;
    }
    Rectangle {
        x: 10px;
        y: (root.height - 4px) / 2;
        width: max(0px, root.width - 20px) * root.fraction;
        height: 4px;
        border-radius: 2px;
        background: root.enabled ? root.accent : (root.light-mode ? #c1b3aa : #4b4950);
    }
    Rectangle {
        x: 3px + max(0px, root.width - 20px) * root.fraction;
        y: (root.height - 14px) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        border-width: native.has-focus ? 2px : 0px;
        border-color: root.light-mode ? #68465d : #f2bccb;
        background: root.enabled ? root.accent : (root.light-mode ? #c1b3aa : #4b4950);
    }
    native := Slider {
        width: parent.width;
        height: parent.height;
        opacity: 0;
        minimum: root.minimum;
        maximum: root.maximum;
        value <=> root.input-value;
        enabled: root.enabled;
        accessible-label: root.label;
        accessible-value: root.value-text;
        accessible-action-set-value(value) => {
            if value.is-float() { root.commit-accessible(value.to-float()); }
        }
        accessible-action-increment => { root.commit-accessible(root.value + 1); }
        accessible-action-decrement => { root.commit-accessible(root.value - 1); }
        changed(value) => { root.interacting = true; root.changed(value); }
        released(value) => {
            root.interacting = false;
            root.released(value);
            // A rejected/no-op seek need not change the owner's value, so a
            // changed-value callback alone cannot end the local preview.
            root.input-value = root.value;
        }
    }
}

// Buttons use Slint's standard Button for keyboard and accessibility behavior,
// while the surrounding rectangle supplies Tide's compact visual treatment.
component TideButton inherits Rectangle {
    in property <string> label;
    in property <string> caption;
    in property <string> leading-icon;
    in property <color> surface-color;
    in property <color> text-color;
    in property <color> accent-color;
    in property <color> accent-text-color;
    in property <color> outline-color;
    in property <color> focus-color;
    in property <color> pressed-color;
    in property <bool> active: false;
    in property <bool> round: false;
    in property <bool> quiet: false;
    in property <bool> enabled: true;
    in property <length> caption-size: 14px;
    callback clicked;
    forward-focus: control;

    private property <string> icon-kind:
        root.caption == "⏮" ? "previous" : root.caption == "⏭" ? "next"
        : root.caption == "▶" ? "play" : root.caption == "Ⅱ" ? "pause"
        : root.caption == "↻" ? "repeat" : root.caption == "⌄" ? "collapse"
        : root.caption == "↗" ? "expand" : root.caption == "☼" ? "sun" : root.caption == "☾" ? "moon" : root.caption == "◐" ? "mode"
        : root.caption == "⌫" ? "clear" : root.caption == "＋" ? "add"
        : root.caption == "⇄" ? "shuffle" : root.caption == "→" ? "send"
        : root.caption == "..." ? "more" : root.caption == "×" ? "close" : "";
    private property <color> icon-color: root.active ? root.accent-text-color : root.text-color;

    border-radius: root.round ? self.height / 2 : 9px;
    border-width: control.has-focus ? 2px : root.active || root.quiet ? 0px : 1px;
    border-color: control.has-focus ? root.focus-color : root.outline-color;
    background: root.active ? root.accent-color
        : control.pressed || hover-area.has-hover ? root.pressed-color : root.quiet ? Colors.transparent : root.surface-color;
    opacity: root.enabled ? 1 : 0.45;

    hover-area := TouchArea {
        width: parent.width; height: parent.height; enabled: root.enabled;
        mouse-cursor: pointer;
        control := Button {
            width: parent.width; height: parent.height;
            text: ""; opacity: 0;
            accessible-label: root.label; enabled: root.enabled;
            clicked => { root.clicked(); }
        }
    }

    Text {
        x: root.leading-icon == "" ? 0px : 28px;
        width: parent.width - self.x;
        height: parent.height;
        text: root.icon-kind == "" ? root.caption : "";
        color: root.active ? root.accent-text-color : root.text-color;
        font-size: root.caption-size;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.leading-icon != "" : Path {
        x: 12px; y: (root.height - 18px) / 2;
        width: 18px; height: 18px; viewbox-width: 24; viewbox-height: 24;
        fill: transparent; stroke: root.icon-color; stroke-width: 1.5px;
        commands: root.leading-icon;
    }
    if root.icon-kind != "" : Path {
        x: (root.width - 20px) / 2;
        y: (root.height - 20px) / 2;
        width: 20px;
        height: 20px;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.icon-kind == "play" || root.icon-kind == "pause" || root.icon-kind == "previous" || root.icon-kind == "next" ? root.icon-color : Colors.transparent;
        stroke: root.icon-color;
        stroke-width: 1.5px;
        commands: root.icon-kind == "play" ? "M 7 4 L 20 12 L 7 20 Z"
            : root.icon-kind == "pause" ? "M 6 5 L 9 5 L 9 19 L 6 19 Z M 15 5 L 18 5 L 18 19 L 15 19 Z"
            : root.icon-kind == "previous" ? "M 6 5 L 6 19 M 18 5 L 9 12 L 18 19 Z"
            : root.icon-kind == "next" ? "M 18 5 L 18 19 M 6 5 L 15 12 L 6 19 Z"
            : root.icon-kind == "repeat" ? "M 17 3 L 21 7 L 17 11 M 21 7 L 7 7 C 4 7 3 9 3 12 M 7 21 L 3 17 L 7 13 M 3 17 L 17 17 C 20 17 21 15 21 12"
            : root.icon-kind == "shuffle" ? "M 3 6 L 7 6 C 11 6 13 18 17 18 L 21 18 M 17 14 L 21 18 L 17 22 M 3 18 L 7 18 C 11 18 13 6 17 6 L 21 6 M 17 2 L 21 6 L 17 10"
            : root.icon-kind == "collapse" ? "M 5 9 L 12 16 L 19 9"
            : root.icon-kind == "expand" ? "M 14 4 L 20 4 L 20 10 M 20 4 L 10 14 M 10 5 L 5 5 L 5 19 L 19 19 L 19 14"
            : root.icon-kind == "sun" ? "M 12 8 A 4 4 0 1 0 12 16 A 4 4 0 1 0 12 8 Z M 12 2 L 12 4 M 12 20 L 12 22 M 2 12 L 4 12 M 20 12 L 22 12 M 5 5 L 6.5 6.5 M 17.5 17.5 L 19 19 M 5 19 L 6.5 17.5 M 17.5 6.5 L 19 5"
            : root.icon-kind == "moon" ? "M 19 15 A 8 8 0 0 1 9 5 A 8 8 0 1 0 19 15 Z"
            : root.icon-kind == "mode" ? "M 12 3 A 9 9 0 1 0 12 21 A 9 9 0 1 0 12 3 Z M 12 3 L 12 21 M 12 6 L 17 6 M 12 9 L 19 9 M 12 12 L 20 12 M 12 15 L 19 15 M 12 18 L 17 18"
            : root.icon-kind == "clear" ? "M 6 7 L 18 7 L 17 21 L 7 21 Z M 4 7 L 20 7 M 9 7 L 9 3 L 15 3 L 15 7 M 10 10 L 10 18 M 14 10 L 14 18"
            : root.icon-kind == "add" ? "M 12 5 L 12 19 M 5 12 L 19 12"
            : root.icon-kind == "close" ? "M 6 6 L 18 18 M 18 6 L 6 18"
            : root.icon-kind == "more" ? "M 5 11 A 1 1 0 1 0 5 13 A 1 1 0 1 0 5 11 Z M 12 11 A 1 1 0 1 0 12 13 A 1 1 0 1 0 12 11 Z M 19 11 A 1 1 0 1 0 19 13 A 1 1 0 1 0 19 11 Z"
            : "M 4 12 L 20 12 M 14 6 L 20 12 L 14 18";
    }
}

// Code-native abstract cover art avoids loading and retaining large artwork in
// the lightweight layouts. The parent can replace this component once artwork
// becomes part of the shared track model.
component TransportButtons inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> paused;
    in property <bool> repeat-enabled;
    in property <bool> light-mode: false;
    in property <bool> show-repeat: true;
    in property <bool> show-shuffle: true;
    callback previous-track;
    callback toggle-pause;
    callback next-track;
    callback toggle-repeat;
    callback shuffle-queue;

    private property <color> surface: root.light-mode ? #eaded9 : #1c2027;
    private property <color> foreground: root.light-mode ? #432d45 : #f3eff2;
    private property <color> accent: root.light-mode ? #b45448 : #b33d60;
    private property <color> accent-foreground: #fff8f6;
    private property <color> outline: root.light-mode ? #cfbdb7 : #2d333d;
    private property <color> focus-ring: root.light-mode ? #6e4b61 : #e1768b;
    private property <color> pressed: root.light-mode ? #dbc9c2 : #2c2730;

    HorizontalLayout {
        spacing: 9px;
        alignment: center;

        if root.show-shuffle : TideButton {
            enabled: root.enabled;
            width: 36px;
            height: 36px;
            label: "Shuffle upcoming tracks";
            caption: "⇄";
            surface-color: root.surface;
            text-color: root.foreground;
            accent-color: root.accent;
            accent-text-color: root.accent-foreground;
            outline-color: root.outline;
            focus-color: root.focus-ring;
            pressed-color: root.pressed;
            clicked => { root.shuffle-queue(); }
        }

        TideButton {
            enabled: root.enabled;
            width: 42px;
            height: 40px;
            label: "Previous track";
            caption: "⏮";
            surface-color: root.surface;
            text-color: root.foreground;
            accent-color: root.accent;
            accent-text-color: root.accent-foreground;
            outline-color: root.outline;
            focus-color: root.focus-ring;
            pressed-color: root.pressed;
            clicked => { root.previous-track(); }
        }

        TideButton {
            enabled: root.enabled;
            width: 48px;
            height: 44px;
            label: root.paused ? "Play" : "Pause";
            caption: root.paused ? "▶" : "Ⅱ";
            active: true;
            round: true;
            caption-size: 17px;
            surface-color: root.surface;
            text-color: root.foreground;
            accent-color: root.accent;
            accent-text-color: root.accent-foreground;
            outline-color: root.outline;
            focus-color: root.focus-ring;
            pressed-color: root.pressed;
            clicked => { root.toggle-pause(); }
        }

        TideButton {
            enabled: root.enabled;
            width: 42px;
            height: 40px;
            label: "Next track";
            caption: "⏭";
            surface-color: root.surface;
            text-color: root.foreground;
            accent-color: root.accent;
            accent-text-color: root.accent-foreground;
            outline-color: root.outline;
            focus-color: root.focus-ring;
            pressed-color: root.pressed;
            clicked => { root.next-track(); }
        }

        if root.show-repeat : TideButton {
            width: 38px;
            height: 38px;
            label: root.repeat-enabled ? "Turn repeat off" : "Turn repeat on";
            caption: "↻";
            active: root.repeat-enabled;
            surface-color: root.surface;
            text-color: root.foreground;
            accent-color: root.accent;
            accent-text-color: root.accent-foreground;
            outline-color: root.outline;
            focus-color: root.focus-ring;
            pressed-color: root.pressed;
            clicked => { root.toggle-repeat(); }
        }
    }
}

component LibraryButton inherits TideButton {
    quiet: true;
    in property <bool> light-mode: false;
    height: 36px;
    caption-size: 12px;
    surface-color: root.light-mode ? #f4ede5 : #1c2027;
    text-color: root.light-mode ? #432d45 : #e7e8ec;
    accent-color: root.light-mode ? #b45448 : #b33d60;
    accent-text-color: #fff8f6;
    outline-color: root.light-mode ? #ded0c4 : #2d333d;
    focus-color: root.light-mode ? #68465d : #e1768b;
    pressed-color: root.light-mode ? #d4bfb8 : #2c2730;
}

// A quiet selected navigation treatment keeps the playback action dominant.
component NavigationButton inherits Rectangle {
    in property <bool> light-mode;
    in property <bool> active;
    in property <bool> library;
    in property <bool> jam: false;
    in property <bool> jam-active: false;
    in property <bool> enabled: true;
    callback clicked;
    height: 40px;
    border-radius: 9px;
    background: root.active ? (root.light-mode ? #e8d5cb : #30232e)
        : control.pressed || row-hover.has-hover ? (root.light-mode ? #e5dbd2 : #242831) : Colors.transparent;
    border-width: control.has-focus ? 2px : 0px;
    border-color: root.light-mode ? #8e594e : #db7f9d;
    private property <color> ink: root.active ? (root.light-mode ? #88463e : #edb5c6)
        : (root.light-mode ? #716773 : #a1a5ae);
    row-hover := TouchArea {
        width: parent.width; height: parent.height;
        enabled: root.enabled; mouse-cursor: pointer;
        control := Button {
            width: parent.width;
            height: parent.height;
            opacity: 0;
            enabled: root.enabled;
            accessible-label: root.jam ? "Open Jams to listen together with friends" : root.library ? "Open your Library" : "Open Home";
            clicked => { root.clicked(); }
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;
        cross-axis-alignment: center;
        Path {
            width: 16px;
            height: 16px;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: Colors.transparent;
            stroke: root.ink;
            stroke-width: 1.7px;
            commands: root.jam ? "M 9 3 A 3 3 0 1 0 9 9 A 3 3 0 1 0 9 3 Z M 3 21 L 3 18 C 3 11 15 11 15 18 L 15 21 M 17 4 C 22 4 22 10 17 10 M 18 13 C 22 13 23 17 22 21" : root.library ? "M 4 4 L 4 20 M 9 4 L 9 20 M 14 5 L 19 4 L 22 19 L 17 20 Z"
                : "M 3 10 L 12 3 L 21 10 M 5 9 L 5 21 L 10 21 L 10 14 L 14 14 L 14 21 L 19 21 L 19 9";
        }
        Text {
            horizontal-stretch: 1;
            text: root.jam ? (root.jam-active ? "Jams •" : "Jams") : root.library ? "Library" : "Home";
            color: root.ink;
            font-size: 13px;
            font-weight: root.active ? 600 : 500;
        }
    }
}

// Artwork is provided by the music source. An absent cover is a small music note.
component Cover inherits Rectangle {
    in property <image> artwork;
    in property <bool> light-mode;
    border-radius: 7px;
    background: root.light-mode ? #e0d1c9 : #29262d;
    clip: true;
    if root.artwork.width > 0 && root.artwork.height > 0 : Image {
        width: parent.width;
        height: parent.height;
        source: root.artwork;
        image-fit: cover;
    }
    if root.artwork.width == 0 || root.artwork.height == 0 : Path {
        x: (parent.width - 22px) / 2;
        y: (parent.height - 22px) / 2;
        width: 22px;
        height: 22px;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: Colors.transparent;
        stroke: root.light-mode ? #956a61 : #bd8496;
        stroke-width: 1.5px;
        commands: "M 9 18 L 9 5 L 20 3 L 20 16 M 9 8 L 20 6 M 9 18 C 9 22 3 22 3 19 C 3 16 9 15 9 18 Z M 20 16 C 20 20 14 20 14 17 C 14 14 20 13 20 16 Z";
    }
}

component EmptyState inherits Rectangle {
    in property <bool> light-mode;
    in property <string> heading;
    in property <string> detail;
    background: Colors.transparent;
    border-radius: 10px;
    border-color: root.light-mode ? #ded0c4 : #292e37;
    border-width: 0px;
    VerticalLayout {
        padding: 28px;
        spacing: 10px;
        alignment: center;
        Text { text: root.heading; color: root.light-mode ? #392e33 : #f0eeef; font-size: 20px; font-weight: 650; horizontal-alignment: center; }
        Text { text: root.detail; color: root.light-mode ? #716773 : #a1a5ae; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
    }
}

export struct MenuAction {
    title: string,
    code: int,
    enabled: bool,
}

// Draw inside Slint rather than delegating to the OS context-menu renderer,
// whose theme and font can differ from the player's current appearance.
component ActionMenu inherits PopupWindow {
    in property <[MenuAction]> items;
    in property <bool> light-mode;
    in property <int> separator-after: -1;
    private property <int> selected: -1;
    callback chosen(int);
    width: 252px;
    height: root.items.length * 42px + 12px + (root.separator-after >= 0 ? 9px : 0px);
    close-policy: close-on-click-outside;
    forward-focus: menu-focus;
    function activate(index: int) {
        if index >= 0 && index < root.items.length && root.items[index].enabled {
            let code = root.items[index].code;
            root.close();
            root.chosen(code);
        }
    }
    menu-focus := FocusScope {
        width: parent.width; height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape || event.text == Key.Tab { root.close(); return accept; }
            if event.text == Key.DownArrow { root.selected = root.selected < root.items.length - 1 ? root.selected + 1 : 0; return accept; }
            if event.text == Key.UpArrow { root.selected = root.selected > 0 ? root.selected - 1 : root.items.length - 1; return accept; }
            if event.text == Key.Return || event.text == " " { root.activate(root.selected); return accept; }
            return reject;
        }
        Rectangle {
            width: parent.width; height: parent.height;
            background: root.light-mode ? #f9f4ee : #191c22;
            border-width: 1px; border-color: root.light-mode ? #ded0c4 : #292e37;
            border-radius: 10px;
            if root.separator-after >= 0 : Rectangle {
                x: 12px; y: 9px + (root.separator-after + 1) * 42px;
                width: parent.width - 24px; height: 1px;
                background: root.light-mode ? #ded0c4 : #292e37;
            }
            for item[index] in root.items : Rectangle {
                x: 6px; y: 6px + index * 42px + (index > root.separator-after && root.separator-after >= 0 ? 9px : 0px);
                width: parent.width - 12px; height: 40px; border-radius: 6px;
                opacity: item.enabled ? 1 : 0.45;
                background: item.enabled && (hit.has-hover || root.selected == index) ? (root.light-mode ? #e9e0d6 : #30232e) : Colors.transparent;
                hit := TouchArea {
                    enabled: item.enabled; mouse-cursor: pointer;
                    Button { width: parent.width; height: parent.height; text: ""; opacity: 0; enabled: item.enabled; accessible-label: item.title; clicked => { root.activate(index); } }
                }
                Path {
                    x: 12px; y: 11px; width: 18px; height: 18px; viewbox-width: 24; viewbox-height: 24;
                    stroke: root.light-mode ? #956a61 : #bd8496; stroke-width: 1.5px; fill: Colors.transparent;
                    commands: item.code == 0 ? "M 5 5 L 14 12 L 5 19 Z M 19 5 L 19 19"
                        : item.code == 1 ? "M 3 6 L 17 6 M 3 11 L 17 11 M 3 16 L 10 16 M 18 14 L 18 22 M 14 18 L 22 18"
                        : item.code == 2 ? "M 12 10 A 2 2 0 1 0 12 14 A 2 2 0 1 0 12 10 Z M 8 7 C 5 10 5 14 8 17 M 16 7 C 19 10 19 14 16 17 M 5 4 C 1 8 1 16 5 20 M 19 4 C 23 8 23 16 19 20"
                        : item.code == 4 ? "M 3 6 L 7 6 C 11 6 13 18 17 18 L 21 18 M 17 14 L 21 18 L 17 22 M 3 18 L 7 18 C 11 18 13 6 17 6 L 21 6 M 17 2 L 21 6 L 17 10"
                        : item.code == 6 ? "M 3 5 L 17 5 M 3 10 L 17 10 M 3 15 L 10 15 M 18 13 L 18 21 M 14 17 L 22 17"
                        : item.code == 7 ? "M 3 5 L 20 5 M 3 10 L 20 10 M 3 15 L 10 15 M 14 17 L 22 17"
                        : "M 6 7 L 18 7 L 17 21 L 7 21 Z M 4 7 L 20 7 M 9 7 L 9 3 L 15 3 L 15 7 M 10 10 L 10 18 M 14 10 L 14 18";
                }
                Text { x: 42px; width: parent.width - 50px; height: parent.height; text: item.title; color: root.light-mode ? #392e33 : #f0eeef; font-size: 13px; font-weight: 500; vertical-alignment: center; overflow: elide; }
            }
        }
    }
}

component ArtistLink inherits Rectangle {
    in property <string> artist;
    in property <bool> enabled: false;
    in property <bool> light-mode;
    in property <length> label-size: 12px;
    callback activated();
    min-width: 0px; height: 18px; clip: true;
    border-width: action.has-focus && root.enabled ? 1px : 0px;
    border-color: root.light-mode ? #985955 : #d16b89;
    border-radius: 3px;
    Text { width: parent.width; height: parent.height; text: root.artist;
        color: root.enabled && (hover.has-hover || action.has-focus) ? (root.light-mode ? #985955 : #e493ad) : (root.light-mode ? #716773 : #a1a5ae);
        font-size: root.label-size; overflow: elide; vertical-alignment: center;
    }
    hover := TouchArea {
        width: parent.width; height: parent.height; enabled: root.enabled; mouse-cursor: pointer;
        action := Button { width: parent.width; height: parent.height; opacity: 0;
            enabled: root.enabled; accessible-label: "Open artist " + root.artist;
            clicked => { root.activated(); }
        }
    }
}

component SongRow inherits Rectangle {
    in property <bool> collection-enabled: false;
    in property <bool> playlist-removable: false;
    callback add-playlist();
    callback remove-playlist();
    in property <bool> shared-queue: false;
    in property <TrackRow> track;
    in property <int> index;
    in property <bool> current: false;
    in property <bool> light-mode;
    in property <bool> removable: false;
    in property <bool> draggable: false;
    in property <bool> dragging: false;
    in property <bool> drag-in-progress: false;
    in property <bool> show-menu: true;
    in property <bool> enabled: true;
    in property <bool> show-duration: true;
    callback select();
    callback remove();
    callback queue(bool);
    callback radio();
    callback artist();
    height: root.removable ? LayoutMetrics.queue-row-height : LayoutMetrics.browse-row-height;
    opacity: root.dragging ? 0.55 : 1;
    changed drag-in-progress => { if root.drag-in-progress { song-menu.close(); } }
    changed enabled => { if !root.enabled { song-menu.close(); } }
    changed track => { song-menu.close(); }
    changed index => { song-menu.close(); }
    changed current => { song-menu.close(); }
    border-radius: 7px;
    background: root.current ? (root.light-mode ? #e8d5cb : #30232e)
        : action.pressed || row-hover.has-hover ? (root.light-mode ? #e9e0d6 : #20252d) : Colors.transparent;
    border-width: action.has-focus ? 2px : 0px;
    border-color: root.light-mode ? #985955 : #d16b89;
    row-hover := TouchArea {
        width: parent.width; height: root.height;
        enabled: root.enabled && !root.drag-in-progress; mouse-cursor: pointer;
        action := Button {
            width: parent.width;
            height: root.height;
            text: "";
            opacity: 0;
            enabled: root.enabled && !root.drag-in-progress;
            accessible-label: (root.shared-queue ? "Add to shared queue: " : "Play ") + root.track.title + " by " + root.track.artist;
            clicked => { root.select(); }
        }
    }
    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 0px;
        HorizontalLayout {
            height: root.height;
            spacing: 10px;
            cross-axis-alignment: center;
            if root.removable : Rectangle {
                width: 20px;
                height: 40px;
                if root.draggable : Rectangle {
                    accessible-role: text;
                    accessible-label: "Drag handle for " + root.track.title;
                    for dot in 6 : Rectangle {
                        x: (dot - floor(dot / 2) * 2) * 6px + 5px;
                        y: floor(dot / 2) * 6px + 12px;
                        width: 3px;
                        height: 3px;
                        border-radius: 1.5px;
                        background: root.light-mode ? #956a61 : #bd8496;
                    }
                }
            }
            Cover { width: root.removable ? 42px : 48px; height: self.width; artwork: root.track.artwork; light-mode: root.light-mode; }
            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                height: root.removable ? 36px : 42px;
                // Mixed-direction glyphs can paint outside an elided Text's
                // bounds. Clip metadata only, keeping row focus/actions intact.
                clip: true;
                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    spacing: 4px;
                    Text { min-width: 0px; text: root.track.title; color: root.light-mode ? #392e33 : #f0eeef; font-size: root.removable ? 14px : 16px; font-weight: root.current ? 600 : 500; overflow: elide; }
                    ArtistLink { height: root.removable ? 14px : 18px; artist: root.track.artist; enabled: root.enabled && !root.drag-in-progress && root.track.artist-enabled; light-mode: root.light-mode; label-size: root.removable ? 12px : 13px; activated => { root.artist(); } }
                }
            }
            if root.show-duration && root.track.duration != "" && root.track.duration != "—" : Text { width: 42px; text: root.track.duration; color: root.light-mode ? #716773 : #a1a5ae; font-size: 11px; horizontal-alignment: right; }
            if root.show-menu && root.shared-queue : LibraryButton { width: 30px; height: 30px; caption: "＋"; label: "Add to shared queue: " + root.track.title; light-mode: root.light-mode; enabled: root.enabled && !root.drag-in-progress; clicked => { root.queue(false); } }
            if root.show-menu : LibraryButton { width: 30px; height: 30px; caption: "..."; label: "Actions for " + root.track.title; light-mode: root.light-mode; enabled: root.enabled && !root.drag-in-progress; clicked => { song-menu.show(); } }
        }
    }
    song-menu := ActionMenu {
        x: max(0px, root.width - self.width - 10px); y: 52px;
        light-mode: root.light-mode;
        separator-after: root.shared-queue || (root.removable && !root.current) ? 0 : 1;
        items: root.shared-queue && root.playlist-removable ? [
            { title: "Add to shared queue", code: 1, enabled: root.enabled },
            { title: "Add to playlist…", code: 6, enabled: root.collection-enabled },
            { title: "Remove from playlist", code: 7, enabled: root.collection-enabled },
        ] : root.shared-queue ? [
            { title: "Add to shared queue", code: 1, enabled: root.enabled },
            { title: "Add to playlist…", code: 6, enabled: root.collection-enabled },
        ] : root.removable && !root.current ? [
            { title: "Start song radio", code: 2, enabled: root.enabled },
            { title: "Add to playlist…", code: 6, enabled: root.collection-enabled },
            { title: "Remove from queue", code: 3, enabled: root.enabled },
        ] : root.removable ? [
            { title: "Repeat next", code: 0, enabled: root.enabled },
            { title: "Repeat later", code: 1, enabled: root.enabled },
            { title: "Start song radio", code: 2, enabled: root.enabled },
            { title: "Add to playlist…", code: 6, enabled: root.collection-enabled },
            { title: "Remove from queue", code: 3, enabled: root.enabled },
        ] : root.playlist-removable ? [
            { title: "Play next", code: 0, enabled: root.enabled },
            { title: "Add to queue", code: 1, enabled: root.enabled },
            { title: "Start song radio", code: 2, enabled: root.enabled },
            { title: "Add to playlist…", code: 6, enabled: root.collection-enabled },
            { title: "Remove from playlist", code: 7, enabled: root.collection-enabled },
        ] : [
            { title: "Play next", code: 0, enabled: root.enabled },
            { title: "Add to queue", code: 1, enabled: root.enabled },
            { title: "Start song radio", code: 2, enabled: root.enabled },
            { title: "Add to playlist…", code: 6, enabled: root.collection-enabled },
        ];
        chosen(code) => {
            if root.enabled && !root.drag-in-progress {
                if code == 0 { root.queue(true); }
                if code == 1 { root.queue(false); }
                if code == 2 { root.radio(); }
                if code == 3 && root.removable { root.remove(); }
                if code == 6 && root.collection-enabled { root.add-playlist(); }
                if code == 7 && root.collection-enabled && root.playlist-removable { root.remove-playlist(); }
            }
        }
    }
    if !root.current : Rectangle {
        x: root.removable ? 72px : 68px;
        y: parent.height - 1px;
        height: 1px;
        width: max(0px, parent.width - self.x - 10px);
        background: root.light-mode ? #e1d7ce : #242932;
    }
}

component LibraryEntry inherits Rectangle {
    in property <bool> add-target: false;
    in property <image> artwork;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> light-mode;
    in property <bool> enabled: true;
    in property <bool> navigable: true;
    in property <string> unavailable-label: "Unavailable";
    callback open();
    height: LayoutMetrics.browse-row-height;
    border-radius: 9px;
    background: action.pressed || row-hover.has-hover ? (root.light-mode ? #e9e0d6 : #20252d) : Colors.transparent;
    border-width: action.has-focus ? 2px : 0px;
    border-color: root.light-mode ? #985955 : #d16b89;
    row-hover := TouchArea {
        width: parent.width; height: parent.height;
        enabled: root.enabled && root.navigable; mouse-cursor: pointer;
        action := Button { width: parent.width; height: parent.height; text: ""; opacity: 0; enabled: root.enabled && root.navigable; accessible-label: root.add-target ? "Add the selected song to " + root.title : root.navigable ? "Open " + root.title : root.title + ", " + root.unavailable-label; clicked => { root.open(); } }
    }
    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        cross-axis-alignment: center;
        Cover { width: 48px; height: 48px; artwork: root.artwork; light-mode: root.light-mode; }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            spacing: 4px;
            Text { text: root.title; color: root.light-mode ? #392e33 : #f0eeef; font-size: 16px; font-weight: 500; overflow: elide; }
            Text { text: root.subtitle; color: root.light-mode ? #716773 : #a1a5ae; font-size: 13px; overflow: elide; }
        }
        if root.navigable : Text { width: 20px; text: root.add-target ? "+" : "›"; color: root.light-mode ? #716773 : #a1a5ae; font-size: 20px; horizontal-alignment: center; }
        if !root.navigable : Text { width: 116px; text: root.unavailable-label; color: root.light-mode ? #716773 : #a1a5ae; font-size: 11px; horizontal-alignment: right; }
    }
    Rectangle {
        x: 68px;
        y: parent.height - 1px;
        height: 1px;
        width: max(0px, parent.width - 78px);
        background: root.light-mode ? #e1d7ce : #242932;
    }
}

// Each row tests the captured pointer against its actual bounds, including section
// headings. Coordinates are window-relative so scrolling does not shift the pointer.
component QueueItem inherits Rectangle {
    in property <bool> collection-enabled: false;
    callback add-playlist();
    in property <bool> enabled: true;
    in property <TrackRow> track;
    in property <int> index;
    in property <int> current-index;
    in property <bool> heading;
    in property <bool> light-mode;
    in property <int> drag-source: -1;
    in property <bool> drag-recommended;
    in property <bool> drag-in-list;
    in property <length> drag-x;
    in property <length> drag-y;
    in property <int> drag-revision;
    in property <bool> press-active;
    in property <length> press-x;
    in property <length> press-y;
    callback select();
    callback remove();
    callback requeue(bool);
    callback radio();
    callback artist();
    callback hit(int, bool);
    callback hover(int, int);
    private property <bool> press-hit: root.press-active && root.index > root.current-index
        && root.press-x >= song.absolute-position.x && root.press-x < song.absolute-position.x + 44px
        && root.press-y >= song.absolute-position.y && root.press-y < song.absolute-position.y + LayoutMetrics.queue-row-height;
    changed press-hit => { if root.press-hit { root.hit(root.index, root.track.recommended); } }
    private property <int> hover-half: root.drag-in-list && root.drag-source >= 0 && root.index > root.current-index && root.track.recommended == root.drag-recommended
        && root.drag-x >= self.absolute-position.x && root.drag-x < self.absolute-position.x + self.width
        && root.drag-y >= self.absolute-position.y && root.drag-y < self.absolute-position.y + self.height
        ? (root.drag-y < song.absolute-position.y + LayoutMetrics.queue-row-height / 2 ? 0 : 1) : -1;
    private property <int> insertion-index: root.index + root.hover-half;
    private property <int> final-index: root.insertion-index - (root.insertion-index > root.drag-source ? 1 : 0);
    private property <{ revision: int, half: int }> hover-state: { revision: root.drag-revision, half: root.hover-half };
    changed hover-state => { root.hover(root.index, root.hover-half); }
    height: song.height + (root.heading ? LayoutMetrics.queue-heading-height : 0px);
    VerticalLayout {
        spacing: 0px;
        if root.heading : Text {
            height: LayoutMetrics.queue-heading-height;
            text: root.index == root.current-index ? "Now playing" : root.track.recommended ? "Autoplay" : "Up next";
            color: root.light-mode ? #956a61 : #bd8496;
            font-size: 10px;
            font-weight: 650;
            vertical-alignment: center;
        }
        song := SongRow {
            collection-enabled: root.collection-enabled;
            enabled: root.enabled;
            track: root.track;
            index: root.index;
            current: root.index == root.current-index;
            light-mode: root.light-mode;
            removable: true;
            draggable: root.index > root.current-index;
            dragging: root.drag-source == root.index;
            drag-in-progress: root.drag-source >= 0;
            show-duration: true;
            select => { root.select(); }
            remove => { root.remove(); }
            queue(next) => { root.requeue(next); }
            radio => { root.radio(); }
            artist => { root.artist(); }
            add-playlist => { root.add-playlist(); }
        }
    }
    if root.hover-half >= 0 && root.final-index != root.drag-source : Rectangle {
        y: root.hover-half == 0 ? song.y : parent.height - 3px;
        height: 3px;
        background: root.light-mode ? #985955 : #e493ad;
        border-radius: 1.5px;
    }
}

component QueueDrawer inherits Rectangle {
    in property <bool> collection-enabled: false;
    callback add-playlist(int);
    in-out property <length> artwork-scroll-y;
    in-out property <length> artwork-view-height;
    in property <bool> enabled: true;
    in property <[TrackRow]> rows;
    in property <int> current-index;
    in property <bool> light-mode;
    in property <bool> autoplay-enabled;
    in property <bool> repeat-enabled;
    callback close();
    callback select(int);
    callback remove(int);
    callback requeue(int, bool);
    callback reorder(int, int);
    callback radio(int);
    callback artist(int);
    callback toggle-autoplay();
    callback toggle-repeat();
    callback shuffle();
    callback clear();
    private property <int> drag-source: -1;
    private property <bool> drag-recommended: false;
    private property <length> drag-x;
    private property <length> drag-y;
    private property <int> hover-row: -1;
    private property <int> hover-half: -1;
    private property <bool> release-pending: false;
    private property <bool> press-active: false;
    private property <length> press-x;
    private property <length> press-y;
    private property <int> drag-revision: 0;
    function cancel-drag() {
        root.drag-source = -1;
        root.release-pending = false;
        root.hover-row = -1;
        root.hover-half = -1;
        root.press-active = false;
    }
    function update-drag-pointer(x: length, y: length) {
        root.drag-x = x;
        root.drag-y = y;
        root.hover-row = -1;
        root.hover-half = -1;
        root.drag-revision += 1;
    }
    changed rows => { root.cancel-drag(); }
    changed current-index => { root.cancel-drag(); root.artwork-scroll-y = 0px; }
    changed visible => { if !root.visible { root.cancel-drag(); } }
    background: root.light-mode ? #eee5db : #15181d;
    border-width: 1px;
    border-color: root.light-mode ? #ded0c4 : #292e37;
    TouchArea { }
    changed enabled => { if !root.enabled { root.cancel-drag(); queue-menu.close(); } }
    queue-menu := ActionMenu {
        x: max(0px, root.width - self.width - 14px); y: 48px;
        light-mode: root.light-mode; separator-after: 0;
        items: [
            { title: "Shuffle upcoming", code: 4, enabled: root.enabled && root.rows.length > 1 },
            { title: "Clear queue", code: 3, enabled: root.enabled && root.rows.length > 0 },
        ];
        chosen(code) => { if root.enabled { if code == 4 { root.shuffle(); } if code == 3 { root.clear(); } } }
    }

    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        HorizontalLayout {
            height: 34px;
            spacing: 7px;
            cross-axis-alignment: center;
            Text { horizontal-stretch: 1; text: "Queue"; color: root.light-mode ? #392e33 : #f0eeef; font-size: 20px; font-weight: 600; }
            LibraryButton { width: 30px; height: 30px; enabled: root.enabled; caption: "..."; label: "More queue actions"; light-mode: root.light-mode; clicked => { queue-menu.show(); } }
            LibraryButton { width: 30px; height: 30px; enabled: root.enabled; caption: "×"; label: "Close queue drawer"; light-mode: root.light-mode; clicked => { root.cancel-drag(); root.close(); } }
        }
        // The fixed rail owns pointer capture while ListView recycles song rows.
        if root.rows.length > 0 : queue-area := Rectangle {
            vertical-stretch: 1;
            private property <bool> drag-in-list: root.drag-x >= self.absolute-position.x && root.drag-x < self.absolute-position.x + queue-list.visible-width
                && root.drag-y >= self.absolute-position.y && root.drag-y < self.absolute-position.y + queue-list.visible-height;
            Timer {
                interval: 30ms;
                running: root.drag-source >= 0 && queue-area.drag-in-list && !root.release-pending;
                triggered => {
                    if root.drag-y < queue-list.absolute-position.y + 40px {
                        queue-list.content-y = min(0px, queue-list.content-y + 14px);
                    } else if root.drag-y > queue-list.absolute-position.y + queue-list.visible-height - 40px {
                        queue-list.content-y = max(min(0px, queue-list.visible-height - queue-list.content-height), queue-list.content-y - 14px);
                    }
                    root.update-drag-pointer(root.drag-x, root.drag-y);
                }
            }
            Timer {
                interval: 1ms;
                running: root.release-pending;
                triggered => {
                    let source = root.drag-source;
                    let insertion = root.hover-row + root.hover-half;
                    let target = insertion - (insertion > source ? 1 : 0);
                    let valid = source >= 0 && queue-area.drag-in-list && root.hover-row >= 0 && root.hover-half >= 0;
                    root.cancel-drag();
                    if valid && target != source { root.reorder(source, target); }
                }
            }
            queue-list := ListView {
                content-y <=> root.artwork-scroll-y;
                changed visible-height => { root.artwork-view-height = self.visible-height; }
                width: parent.width;
                height: parent.height;
                accessible-label: "Playback queue including manual choices and autoplay";
                mouse-drag-pan-enabled: false;
                horizontal-scrollbar-policy: always-off;
                for visible-index in max(0, root.rows.length - max(0, root.current-index)) : QueueItem {
                    collection-enabled: root.collection-enabled;
                    width: queue-list.visible-width;
                    enabled: root.enabled;
                    index: visible-index + max(0, root.current-index);
                    track: root.rows[self.index];
                    current-index: root.current-index;
                    light-mode: root.light-mode;
                    heading: self.index == max(0, root.current-index) || self.index == root.current-index + 1 || self.track.recommended != root.rows[max(0, self.index - 1)].recommended;
                    drag-source: root.drag-source;
                    drag-recommended: root.drag-recommended;
                    drag-in-list: queue-area.drag-in-list;
                    drag-x: root.drag-x;
                    drag-y: root.drag-y;
                    drag-revision: root.drag-revision;
                    press-active: root.press-active;
                    press-x: root.press-x;
                    press-y: root.press-y;
                    select => { root.select(self.index); }
                    remove => { root.remove(self.index); }
                    requeue(next) => { root.requeue(self.index, next); }
                    radio => { root.radio(self.index); }
                    artist => { root.artist(self.index); }
                    add-playlist => { root.add-playlist(self.index); }
                    hover(row-index, half) => {
                        if half >= 0 { root.hover-row = row-index; root.hover-half = half; }
                        else if root.hover-row == row-index { root.hover-row = -1; root.hover-half = -1; }
                    }
                    hit(row-index, recommended) => {
                        if root.press-active && root.drag-source < 0 {
                            root.drag-source = row-index;
                            root.drag-recommended = recommended;
                            root.press-active = false;
                        }
                    }
                }
            }
            rail := TouchArea {
                enabled: root.enabled;
                x: 0px;
                y: 0px;
                width: min(44px, parent.width);
                height: queue-list.visible-height;
                mouse-cursor: self.pressed && root.drag-source >= 0 ? grabbing : grab;
                accessible-role: button;
                accessible-label: "Drag upcoming songs by their handles to reorder within their queue section";
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        root.cancel-drag();
                        root.press-x = self.absolute-position.x + self.mouse-x;
                        root.press-y = self.absolute-position.y + self.mouse-y;
                        root.update-drag-pointer(root.press-x, root.press-y);
                        root.press-active = true;
                    } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                        root.update-drag-pointer(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        root.release-pending = true;
                    } else if event.kind == PointerEventKind.cancel {
                        root.cancel-drag();
                    }
                }
                moved => {
                    if self.pressed { root.update-drag-pointer(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
                }
                scroll-event(event) => {
                    if root.drag-source < 0 {
                        queue-list.content-y = max(min(0px, queue-list.visible-height - queue-list.content-height), min(0px, queue-list.content-y + event.delta-y));
                    }
                    return accept;
                }
            }
        }
        if root.rows.length == 0 : EmptyState { vertical-stretch: 1; light-mode: root.light-mode; heading: "Queue is empty"; detail: "Choose a song or playlist to start listening."; }
        HorizontalLayout {
            height: 34px;
            spacing: 8px;
            cross-axis-alignment: center;
            Text { horizontal-stretch: 1; text: "Autoplay"; color: root.light-mode ? #716773 : #a1a5ae; font-size: 12px; }
            LibraryButton { width: 58px; light-mode: root.light-mode; enabled: root.enabled; caption: root.autoplay-enabled ? "On" : "Off"; label: root.autoplay-enabled ? "Turn autoplay off" : "Turn autoplay on"; active: root.autoplay-enabled; clicked => { root.toggle-autoplay(); } }
            LibraryButton { width: 82px; light-mode: root.light-mode; enabled: root.enabled; caption: "Repeat"; label: root.repeat-enabled ? "Turn repeat off" : "Turn repeat on"; active: root.repeat-enabled; clicked => { root.toggle-repeat(); } }
        }
    }
}

component RatingButton inherits Rectangle {
    in property <bool> negative: false;
    in property <bool> enabled: true;
    in property <bool> light-mode: false;
    in property <bool> active: false;
    in property <string> label;
    callback clicked();
    LibraryButton { width: parent.width; height: parent.height; enabled: root.enabled; light-mode: root.light-mode; active: root.active; caption: ""; label: root.label; clicked => { root.clicked(); } }
    Path {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: 18px; height: 18px; viewbox-width: 24; viewbox-height: 24;
        fill: root.active ? (root.light-mode ? #c48776 : #a94164) : Colors.transparent;
        stroke: root.light-mode ? #716773 : #b6bac3; stroke-width: 1.5px;
        commands: root.negative ? "M 17 14 L 13 21 Q 10 21 11 16 L 11 15 L 5 15 Q 3 15 3.5 13 L 5.5 5 Q 6 3 8 3 L 17 3 Z M 21 14 L 18 14 L 18 3 L 21 3 Z"
            : "M 7 10 L 11 3 Q 14 3 13 8 L 13 9 L 19 9 Q 21 9 20.5 11 L 18.5 19 Q 18 21 16 21 L 7 21 Z M 3 10 L 6 10 L 6 21 L 3 21 Z";
        opacity: root.enabled ? 1 : 0.45;
    }
}

// Actual byte progress in a compact native control; no separate update window.
component UpdateAction inherits Rectangle {
    in property <bool> light-mode;
    in property <bool> busy;
    in property <int> phase: 0;
    in property <float> progress: 0;
