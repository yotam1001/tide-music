    callback reorder-queue-track(int, int);
    callback start-track-radio(int, int);
    callback retry-error();
    private property <color> foreground: root.light-mode ? #392e33 : #f0eeef;
    private property <color> secondary: root.light-mode ? #716773 : #a1a5ae;
    private property <color> surface: root.light-mode ? #f9f4ee : #191c22;
    private property <color> outline: root.light-mode ? #ded0c4 : #292e37;
    private property <image> current-artwork: root.track-artwork;
    private property <bool> wide: true;
    private property <bool> advanced-open: false;
    private property <bool> browsing-enabled: !root.settings-open && !(root.queue-open && !root.wide);
    title: "Tide";
    icon: @image-url("assets/tide-icon.png");
    default-font-family: "Segoe UI";
    default-font-size: 14px;
    preferred-width: root.collapsed ? 700px : root.compact-mode ? 780px : 1140px;
    preferred-height: root.collapsed ? 132px : root.compact-mode ? 720px : 800px;
    min-width: 650px;
    min-height: root.collapsed ? 112px : 420px;
    background: root.light-mode ? #f4eee6 : #111318;
    init => { Palette.color-scheme = root.light-mode ? light : dark; root.wide = root.width >= 1050px; }
    changed width => { root.wide = root.width >= 1050px; }
    changed settings-open => {
        if root.settings-open { app-focus.focus(); }
        else { root.advanced-open = false; }
    }
    changed queue-open => { if root.queue-open && !root.wide { app-focus.focus(); } }
    changed wide => { if !root.wide && root.queue-open { app-focus.focus(); } }
    changed light-mode => { Palette.color-scheme = root.light-mode ? light : dark; }

    // Windows may discard the software-rendered window contents on minimize
