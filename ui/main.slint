                            if root.account-busy : LibraryButton { height: 36px; light-mode: root.light-mode; caption: "Cancel connection"; label: "Cancel account request"; clicked => { root.cancel-account(); } }
                            Rectangle { height: 1px; background: root.outline; }
                            LibraryButton { height: 36px; light-mode: root.light-mode; caption: root.advanced-open ? "Advanced connection options  ⌃" : "Advanced connection options  ⌄"; label: root.advanced-open ? "Hide advanced account options" : "Show advanced account options"; clicked => { root.advanced-open = !root.advanced-open; } }
                            if root.advanced-open : VerticalLayout {
                                spacing: 12px;
                                Text { text: "Google account slot"; color: root.foreground; font-size: 13px; font-weight: 600; }
                                Text { text: "Use this only if the imported session opened the wrong Google account. Select your YouTube profile in the browser before importing."; color: root.secondary; font-size: 12px; wrap: word-wrap; }
                                HorizontalLayout { height: 36px; spacing: 8px; ComboBox { horizontal-stretch: 1; model: ["Account 1", "Account 2", "Account 3", "Account 4", "Account 5", "Account 6", "Account 7", "Account 8", "Account 9", "Account 10"]; current-index <=> root.account-index; enabled: root.account-connected && !root.account-busy; } LibraryButton { width: 76px; quiet: false; light-mode: root.light-mode; caption: "Switch"; label: "Connect selected Google account"; enabled: root.account-connected && !root.account-busy; clicked => { root.switch-account(root.account-index); } } }
                                LibraryButton { height: 36px; quiet: false; light-mode: root.light-mode; caption: "Import Zen profile"; label: "Select an existing Zen cookie database for advanced import"; enabled: !root.account-busy; clicked => { root.connect-account(); } }
                                LibraryButton { height: 36px; quiet: false; light-mode: root.light-mode; caption: "Import session file"; label: "Import session from a local file"; enabled: !root.account-busy; clicked => { root.import-account(); } }
                            }
                            if root.account-connected : LibraryButton { height: 36px; quiet: false; light-mode: root.light-mode; caption: "Disconnect account"; label: "Disconnect YouTube Music account"; enabled: !root.account-busy; clicked => { root.disconnect-account(); } }

                            }
                        }
                    }
                }
                if root.artist-picker-open : Rectangle {
                    width: parent.width; height: parent.height; background: #00000060;
                    TouchArea { clicked => { root.back-detail(); } }
                    Rectangle {
                        width: min(360px, parent.width - 24px); height: min(parent.height - 24px, 94px + root.artist-choices.length * 48px);
                        x: (parent.width - self.width) / 2; y: max(12px, (parent.height - self.height) / 2);
                        background: root.surface; border-width: 1px; border-color: root.outline; border-radius: 12px;
                        TouchArea { }
                        VerticalLayout {
                            padding: 16px; spacing: 10px;
                            HorizontalLayout { height: 32px; Text { horizontal-stretch: 1; text: "Choose an artist"; font-weight: 600; color: root.foreground; } LibraryButton { width: 30px; height: 30px; caption: "×"; label: "Cancel artist selection"; light-mode: root.light-mode; clicked => { root.back-detail(); } } }
                            ScrollView { horizontal-scrollbar-policy: always-off; vertical-stretch: 1;
                                VerticalLayout { spacing: 8px; alignment: start;
                                    for artist[index] in root.artist-choices : LibraryButton { height: 40px; caption: artist.name; label: "Open artist " + artist.name; active: root.artist-choice-index == index; light-mode: root.light-mode; clicked => { root.choose-artist(index); } }
                                }
                            }
                        }
                    }
                }
                if root.jam-available && root.jam-open : Rectangle {
                    width: parent.width;
                    height: parent.height;
                    Rectangle { width: max(0px, parent.width - 420px); height: parent.height; background: transparent; TouchArea { clicked => { root.jam-open = false; } } }
                    Rectangle {
                        x: max(0px, parent.width - 420px); width: 420px; height: parent.height;
                        background: root.surface; border-width: 1px; border-color: root.outline;
                        TouchArea { }
                        ScrollView {
                            width: parent.width; height: parent.height; horizontal-scrollbar-policy: always-off;
                            VerticalLayout {
                                padding: 20px; spacing: 12px; alignment: start;
                                HorizontalLayout { height: 34px; Text { horizontal-stretch: 1; text: "Listen together"; color: root.foreground; font-size: 20px; font-weight: 650; vertical-alignment: center; } LibraryButton { width: 30px; height: 30px; light-mode: root.light-mode; caption: "×"; label: "Close Jam controls"; clicked => { root.jam-open = false; } } }
                                Text { height: 48px; text: root.jam-status; color: root.foreground; font-size: 12px; wrap: word-wrap; accessible-live-region: polite; }
                                if root.jam-active && root.jam-queue-notice != "" : Text { height: 48px; text: root.jam-queue-notice; color: root.foreground; font-size: 12px; wrap: word-wrap; accessible-live-region: polite; }
                                if root.jam-active && !root.jam-guest : Text { text: "Invite your friends"; color: root.foreground; font-weight: 600; }
                                if root.jam-active && !root.jam-guest && root.jam-invite-code != "" : LineEdit { text: root.jam-invite-code; read-only: true; accessible-label: "Private guest invite code"; }
                                if root.jam-active && !root.jam-guest : LibraryButton { height: 36px; light-mode: root.light-mode; quiet: false; leading-icon: "M 9 9 L 20 9 L 20 21 L 9 21 Z M 6 16 L 3 16 L 3 3 L 14 3 L 14 6"; caption: "Copy invite"; enabled: root.jam-invite-code != ""; label: "Copy the guest invite code"; clicked => { root.jam-copy-invite(); } }
                                if root.jam-active && !root.jam-guest : HorizontalLayout {
                                    height: 34px; spacing: 8px;
                                    LibraryButton { horizontal-stretch: 1; light-mode: root.light-mode; quiet: false; leading-icon: root.jam-locked ? "M 5 10 L 19 10 L 19 21 L 5 21 Z M 8 10 L 8 6 A 4 4 0 0 1 16 6 L 16 10" : "M 5 10 L 19 10 L 19 21 L 5 21 Z M 8 10 L 8 6 A 4 4 0 0 1 16 6"; caption: root.jam-locked ? "Allow joining" : "Lock room"; label: root.jam-locked ? "Allow new listeners to join" : "Prevent new listeners from joining"; clicked => { root.jam-toggle-lock(); } }
                                    LibraryButton { horizontal-stretch: 1; light-mode: root.light-mode; quiet: false; leading-icon: "M 18 3 L 21 7 L 17 10 M 21 7 L 8 7 C 2 7 2 17 8 17 L 19 17"; caption: "Replace invite"; label: "Replace the invite and invalidate the previous code"; clicked => { root.jam-rotate-invite(); } }
                                }
                                if root.jam-active && !root.jam-guest && root.jam-members.length > 0 : Text { text: "Listeners"; color: root.foreground; font-weight: 600; }
                                if root.jam-active && !root.jam-guest : VerticalLayout {
                                    spacing: 6px;
                                    for member in root.jam-members : HorizontalLayout {
                                        height: 34px; spacing: 8px;
                                        Text { horizontal-stretch: 1; text: member.name; color: root.foreground; vertical-alignment: center; overflow: elide; }
                                        LibraryButton { width: 80px; light-mode: root.light-mode; caption: "Remove"; label: "Remove " + member.name + " and replace the invite"; clicked => { root.jam-remove-member(member.id); } }
                                    }
                                }
                                if root.jam-active && root.jam-guest && root.jam-listener-id > 0 : Text { text: "You are Listener " + root.jam-listener-id; color: root.foreground; font-weight: 600; }
                                if root.jam-active : Text { height: 68px; text: root.jam-guest ? "Browse your music and select a song to add it to the shared queue. The host controls playback. Your volume stays local." : "Send the invite code to friends. They paste it into Join a Jam. Each person plays using their own account."; color: root.secondary; font-size: 12px; wrap: word-wrap; }
                                if root.jam-active : LibraryButton { height: 36px; quiet: false; light-mode: root.light-mode; caption: root.jam-guest ? "Leave Jam" : "End Jam"; label: root.jam-guest ? "Leave Jam and restore your paused local queue" : "Close the hosted room for all guests"; clicked => { root.jam-leave(); } }
                                if !root.jam-active : Text { text: "Start a Jam"; color: root.foreground; font-weight: 600; }
                                if !root.jam-active : Text { height: 44px; text: "Play a song, start a room and invite your friends. Each person uses their own YouTube Music account."; color: root.secondary; font-size: 12px; wrap: word-wrap; }
                                if !root.jam-active : LibraryButton { height: 36px; light-mode: root.light-mode; caption: "Start Jam"; label: "Host the current YouTube queue with an invite code"; active: true; clicked => { root.jam-host-code(); } }
                                if !root.jam-active : Rectangle { height: 1px; background: root.outline; }
                                if !root.jam-active : Text { text: "Join a Jam"; color: root.foreground; font-weight: 600; }
                                if !root.jam-active : LineEdit { text <=> root.jam-code-input; placeholder-text: "Paste your friend's invite code"; accessible-label: "Guest Jam invite code"; }
                                if !root.jam-active : LibraryButton { height: 36px; light-mode: root.light-mode; caption: "Join Jam"; label: "Join using the pasted private invite code"; clicked => { root.jam-join-code(); } }
                                if !root.jam-active : LibraryButton { height: 32px; light-mode: root.light-mode; caption: root.jam-advanced ? "Hide advanced setup" : "Advanced setup"; label: "Show or hide private server file setup"; clicked => { root.jam-advanced = !root.jam-advanced; } }
                                if !root.jam-active && root.jam-advanced : Text { text: "Jam server"; color: root.foreground; font-weight: 600; }
                                if !root.jam-active && root.jam-advanced : LineEdit { text <=> root.jam-endpoint; placeholder-text: "https://your-jam-server.example"; accessible-label: "Trusted Jam relay endpoint"; }
                                if !root.jam-active && root.jam-advanced : Text { height: 48px; text: "Private servers can require an operator key. Use the file flow for those servers or older invitations."; color: root.secondary; font-size: 11px; wrap: word-wrap; }
                                if !root.jam-active && root.jam-advanced : LibraryButton { height: 36px; light-mode: root.light-mode; caption: "Host with operator key…"; label: "Host the current YouTube queue and save a new private guest invite"; clicked => { root.jam-host(); } }
                                if !root.jam-active && root.jam-advanced : LibraryButton { height: 36px; light-mode: root.light-mode; caption: "Open invite file…"; label: "Select a private Jam invite and follow its host"; clicked => { root.jam-join(); } }
                                Rectangle { height: 12px; }
                                Text { height: 58px; text: "The free shared server currently allows two rooms. Use Advanced setup for your own server. Accounts and audio stay on each PC."; color: root.secondary; font-size: 11px; wrap: word-wrap; }
                            }
                        }
                    }
                }
            }
            if root.jam-active : Rectangle {
                height: 34px; background: root.surface;
                HorizontalLayout { padding-left: 18px; padding-right: 18px; spacing: 10px; cross-axis-alignment: center;
                    Text { horizontal-stretch: 1; text: root.jam-queue-notice != "" ? root.jam-queue-notice : root.jam-status; color: root.foreground; font-size: 11px; overflow: elide; }
                    LibraryButton { width: 90px; height: 28px; light-mode: root.light-mode; caption: root.jam-guest ? "Leave Jam" : "End Jam"; label: "Stop participating in this Jam"; clicked => { root.jam-leave(); } }
                }
            }
            PlayerBar {
                window-minimized: root.minimized;
                transport-enabled: !root.jam-guest;
                preferred-height: 110px;
                min-height: 110px;
                max-height: root.collapsed ? 1000px : 110px;
                vertical-stretch: root.collapsed ? 1 : 0;
                track-title: root.track-title;
                track-artist: root.track-artist;
                mini-pinned: root.mini-pinned;
                toggle-mini-pin => { root.toggle-mini-pin(); }
                artist-enabled: root.track-artist-enabled && !root.account-busy && !root.artist-picker-open && !root.settings-open && !root.account-open;
                audio-quality: root.audio-quality;
                playback-hint: root.collapsed && root.feedback-notice != "" ? root.feedback-notice : root.playback-hint;
                rating: root.current-rating;
                rating-enabled: root.rating-enabled;
                rating-busy: root.rating-busy;
                rate(value) => { root.rate-song(value); }
                artist => { root.open-artist(4, 0); }
                artwork: root.current-artwork;
                position: root.position;
                duration: root.duration;
                paused: root.paused;
                volume: root.volume;
                light-mode: root.light-mode;
                compact: root.compact-mode;
                collapsed: root.collapsed;
                queue-open: root.queue-open;
                toggle-pause => { root.toggle-pause(); }
                next-track => { root.next-track(); }
                previous-track => { root.previous-track(); }
                seek(value) => { root.seek(value); }
                change-volume(value) => { root.change-volume(value); }
                restore => { root.collapse-player(); }
                mini => { root.collapse-player(); }
                toggle-queue => { root.queue-open = !root.queue-open; }
            }
        }
        if !root.collapsed && root.playlist-picker-open : Rectangle {
            min-width: 0px; preferred-width: 0px; max-width: 10000px;
            min-height: 0px; preferred-height: 0px; max-height: 10000px;
            background: Colors.transparent;
            y: 64px; width: root.width; height: max(0px, root.height - (root.jam-active ? 208px : 174px));
            Rectangle { width: max(0px, parent.width - 420px); height: parent.height; background: Colors.transparent; TouchArea { clicked => { root.cancel-playlist-picker(); } } }
            Rectangle {
                x: max(0px, parent.width - 420px); width: min(420px, parent.width); height: parent.height;
                background: root.surface; border-width: 1px; border-color: root.outline;
                VerticalLayout {
                    padding: 12px; spacing: 8px;
                    HorizontalLayout { height: 36px;
                        Text { horizontal-stretch: 1; text: "Add to playlist"; color: root.foreground; font-size: 22px; font-weight: 650; }
                        LibraryButton { width: 32px; height: 32px; light-mode: root.light-mode; caption: "×"; label: "Close playlist chooser"; clicked => { root.cancel-playlist-picker(); } }
                    }
                    Text { height: 20px; text: root.playlist-picker-song; color: root.secondary; font-size: 12px; overflow: elide; }
                    if root.playlist-choices.length > 0 : ListView {
                        vertical-stretch: 1; min-height: 40px;
                        content-y <=> root.playlist-picker-artwork-y;
                        changed visible-height => { root.playlist-picker-artwork-height = self.visible-height; }
                        horizontal-scrollbar-policy: always-off;
                        for row[index] in root.playlist-choices : LibraryEntry {
                            light-mode: root.light-mode; add-target: true;
                            title: row.title; subtitle: row.subtitle; artwork: row.artwork;
                            enabled: root.collection-enabled && !root.collection-busy && !root.playlist-choices-busy;
                            open => { root.pick-playlist(index); }
                        }
                    }
                    if root.playlist-choices.length == 0 : Text { vertical-stretch: 1; min-height: 40px; text: root.playlist-choices-busy ? "Refreshing your playlists…" : "No editable playlists loaded. Refresh your playlists, or create one in YouTube Music."; color: root.secondary; font-size: 12px; wrap: word-wrap; }
                    LibraryButton { height: 32px; light-mode: root.light-mode; caption: root.playlist-choices-busy ? "Refreshing…" : "Refresh playlists"; enabled: !root.playlist-choices-busy; label: "Refresh editable playlists from your selected account"; clicked => { root.refresh-playlist-choices(); } }
                    Text { height: 28px; text: "Saved to your selected YouTube Music account. Your playback queue stays separate."; color: root.secondary; font-size: 11px; wrap: word-wrap; }
                }
            }
        }
        if !root.collapsed && root.feedback-notice != "" : Rectangle {
            x: root.width - self.width - 18px; y: root.height - self.height - 122px;
            width: min(360px, root.width - 36px); height: 76px;
            background: root.surface; border-width: 1px; border-color: root.outline; border-radius: 8px;
            HorizontalLayout { padding: 12px; spacing: 10px;
                Text { horizontal-stretch: 1; text: root.feedback-notice; color: root.foreground; font-size: 12px; wrap: word-wrap; overflow: elide; accessible-live-region: polite; }
                LibraryButton { width: 28px; height: 28px; light-mode: root.light-mode; caption: "×"; label: "Dismiss feedback message"; clicked => { root.dismiss-feedback(); } }
            }
        }
    }
}
