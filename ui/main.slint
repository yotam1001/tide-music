import { AboutSlint, ComboBox, ListView, Palette, ScrollView } from "std-widgets.slint";
import { Theme, Icon, Hit, TextButton, IconButton, PlayButton, Toggle, Segmented, LoadingDots, SectionTitle } from "theme.slint";
import { TrackRow, Cover, EmptyState, SongRow, MediaCard, NavigationButton, SidebarPlaylist } from "components.slint";
import { QueueDrawer } from "queue.slint";
import { PlayerBar } from "player.slint";
export { TideJamWindow, JamChoice } from "jams.slint";
export { TrackRow, Theme }

export struct PlaylistRow {
    id: string,
    title: string,
    subtitle: string,
    artwork: image,
}

export struct RecommendationRow {
    id: string,
    title: string,
    subtitle: string,
    artwork: image,
    kind: string,
    shelf: string,
}

// Home recommendations grouped by YouTube Music shelf. `first` is the index of
// the shelf's first card in the flat recommendation list used by callbacks.
export struct HomeShelf {
    title: string,
    first: int,
    items: [RecommendationRow],
}

// The browsing surface is one explicit state. `section` is the navigation root
// (Home or Library) that Back returns to from a playlist or search results.
export enum Page { home, library, playlist, search }

// Derived account presentation. The application supplies the underlying facts;
// the interface renders exactly one of these states.
export enum AccountState { disconnected, saved, verifying, connected }

// What the single error banner offers. Derived from the error facts below.
export enum ErrorAction { dismiss, retry, account }

// Column header for track tables, aligned with SongRow's columns.
component TrackTableHeader inherits Rectangle {
    in property <bool> show-number: true;
    in property <bool> show-album: true;
    height: 34px;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        if root.show-number : SectionTitle { width: 26px; text: "#"; horizontal-alignment: center; }
        SectionTitle { width: 42px; text: ""; }
        SectionTitle { horizontal-stretch: 2; min-width: 0px; preferred-width: 0px; text: "TITLE"; }
        if root.show-album : SectionTitle { horizontal-stretch: 1; min-width: 0px; preferred-width: 0px; text: "ALBUM"; }
        Rectangle { width: 42px; Icon { x: parent.width - self.width; y: (parent.height - self.height) / 2; name: "clock"; ink: Theme.faint; size: 14px; } }
        Rectangle { width: 30px; }
    }
    Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.divider; }
}

export component AppWindow inherits Window {
    in-out property <length> library-artwork-y;
    in-out property <length> library-artwork-height;
    in-out property <length> home-artwork-y;
    in-out property <length> home-artwork-height;
    in-out property <length> queue-artwork-y;
    in-out property <length> queue-artwork-height;
    in-out property <length> detail-artwork-y;
    in-out property <length> detail-artwork-height;
    in-out property <length> search-artwork-y;
    in-out property <length> search-artwork-height;
    private property <bool> restore-repaint: false;
    in-out property <int> account-index;
    callback switch-account(int);
    callback connect-account();
    callback cancel-account();
    callback media-command(int, float);
    in property <[PlaylistRow]> library-playlists;
    in property <[RecommendationRow]> recommendations;
    in property <[HomeShelf]> home-shelves;
    // Account facts. `provider-busy` means any account/library request is in
    // flight; `account-connecting` means that request is an account change.
    in property <bool> account-connected;
    in property <bool> account-verified;
    in property <bool> account-connecting;
    in property <bool> provider-busy;
    in property <string> account-name;
    in property <string> account-status;
    out property <AccountState> account-state:
        root.account-connecting || (root.provider-busy && root.account-connected && !root.account-verified) ? AccountState.verifying
        : root.account-verified ? AccountState.connected
        : root.account-connected ? AccountState.saved
        : AccountState.disconnected;
    // Navigation: `page` is what is shown; `section` is the Home/Library root.
    in-out property <Page> page: Page.home;
    in-out property <Page> section: Page.home;
    in-out property <bool> queue-open: false;
    in-out property <bool> compact-mode: false;
    in property <bool> autoplay-enabled: false;
    callback toggle-compact();
    callback toggle-autoplay();
    callback shuffle-playlist(int);
    // context 0: Library playlist, 1: Home card. Plays without opening it.
    callback play-playlist(int, int);
    callback play-radio();
    callback remove-queue-track(int);
    callback import-account();
    callback refresh-library();
    callback disconnect-account();
    callback select-library-playlist(int);
    callback play-liked();
    callback refresh-recommendations();
    callback select-recommendation(int);
    callback open-account-help();
    in property <[TrackRow]> rows;
    in property <int> current-index;
    in property <string> track-title;
    in property <string> track-artist;
    in property <string> track-album;
    in property <image> track-artwork;
    in property <float> position;
    in property <float> duration;
    in property <bool> paused;
    in property <bool> loading;
    in property <float> volume;
    in property <string> status-text;
    in-out property <string> source-input;
    in property <string> search-query;
    in-out property <bool> light-mode <=> Theme.light;
    in-out property <bool> motion <=> Theme.motion;
    callback toggle-motion();
    // Colors sampled from artwork by the app: the open playlist's cover and
    // the current song's cover. Pages and the player take on these tints.
    in property <color> detail-tint;
    in property <bool> has-detail-tint;
    in property <color> now-tint;
    in property <bool> has-now-tint;
    in property <bool> collapsed;
    in property <bool> repeat-enabled;
    callback add-source(string);
    callback select-track(int);
    callback toggle-pause();
    callback next-track();
    callback previous-track();
    callback seek(float);
    callback change-volume(float);
    callback toggle-repeat();
    callback shuffle-queue();
    callback switch-mode();
    callback collapse-player();
    callback open-file();
    callback open-jam();
    in property <bool> following-jam: false;
    in property <bool> jam-applying: false;
    callback clear-queue();

    in property <string> detail-title;
    in property <string> detail-subtitle;
    in property <image> detail-artwork;
    in property <bool> detail-liked;
    in property <[TrackRow]> detail-rows;
    in property <bool> detail-busy;
    in property <[TrackRow]> search-rows;
    in property <bool> search-busy;
    in property <string> error-message;
    in property <bool> error-is-account;
    in property <bool> error-retryable;
    out property <ErrorAction> error-action: root.error-is-account ? ErrorAction.account
        : root.error-retryable ? ErrorAction.retry : ErrorAction.dismiss;
    in-out property <bool> settings-open: false;
    callback play-detail();
    callback shuffle-detail();
    callback select-detail-track(int);
    callback select-search-track(int);
    callback queue-detail-track(int, bool);
    callback queue-search-track(int, bool);
    callback queue-recommendation(int, bool);
    callback requeue-track(int, bool);
    callback reorder-queue-track(int, int);
    callback start-track-radio(int, int);
    callback retry-error();
    callback dismiss-error();

    private property <image> current-artwork: root.track-artwork;
    private property <bool> has-track: root.current-index >= 0 && root.current-index < root.rows.length;
    // Window-width facts are written from `changed width` rather than bound,
    // because the window's own size depends on its layout.
    private property <length> window-width: 1140px;
    private property <bool> wide: true;
    private property <bool> roomy: true;
    private property <bool> advanced-open: false;
    private property <bool> browsing-enabled: !root.settings-open && !(root.queue-open && !root.wide);
    private property <bool> account-ready: root.account-connected && !root.provider-busy;
    private property <length> sidebar-width: root.roomy ? 232px : 72px;
    private property <length> page-padding: root.compact-mode ? 20px : 28px;
    // Card grid geometry shared by Home and Library, and read by the app to
    // load only the artwork a scrolled grid shows.
    private property <length> grid-gap: 12px;
    private property <length> content-width: root.window-width - root.sidebar-width - 8px
        - (root.queue-open && root.wide ? 340px : 8px) - 2 * root.page-padding - 14px;
    out property <int> grid-columns: max(2, floor((root.content-width + root.grid-gap) / (164px + root.grid-gap)));
    private property <length> card-width: (root.content-width - root.grid-gap * (root.grid-columns - 1)) / root.grid-columns;
    out property <length> card-height: root.card-width + 40px;
    private property <bool> table-album: root.content-width > 620px;
    private property <color> hero-color: root.page == Page.playlist && root.has-detail-tint ? root.detail-tint
        : root.page != Page.playlist && root.has-now-tint ? root.now-tint : Theme.accent;
    animate hero-color { duration: Theme.slow; easing: ease-in-out; }
    // Pages fade and rise in when navigating; the first page simply appears.
    private property <bool> page-motion: false;
    private property <length> enter-offset: root.page-motion && Theme.motion ? 16px : 0px;
    private property <float> enter-opacity: root.page-motion && Theme.motion ? 0 : 1;
    // Transient confirmation ("Added to your queue"). Routine playback states
    // are already visible in the player and are not repeated here.
    private property <string> toast-text;
    private property <bool> toast-visible: false;
    changed status-text => {
        if root.status-text != "" && root.status-text != "Playing" && root.status-text != "Paused"
            && root.status-text != "Loading…" && root.status-text != "Ready" && root.error-message == "" {
            root.toast-text = root.status-text;
            root.toast-visible = true;
        }
    }
    Timer { interval: 500ms; running: !root.page-motion; triggered => { root.page-motion = true; } }
    pure function playing-row(row: TrackRow) -> bool {
        return root.has-track && row.title == root.track-title && row.artist == root.track-artist;
    }
    function navigate(target: Page) {
        root.section = target;
        root.page = target;
    }
    function back() {
        root.page = root.section;
    }
    function measure() {
        root.window-width = root.width;
        root.wide = root.width >= 1050px;
        root.roomy = root.width >= 960px;
    }
    title: "Tide";
    icon: @image-url("assets/tide-icon.png");
    default-font-family: "Segoe UI";
    default-font-size: 14px;
    preferred-width: root.collapsed ? 700px : root.compact-mode ? 780px : 1140px;
    preferred-height: root.collapsed ? 132px : root.compact-mode ? 720px : 800px;
    min-width: 650px;
    min-height: root.collapsed ? 112px : 420px;
    background: Theme.window;
    init => { Palette.color-scheme = root.light-mode ? light : dark; root.measure(); }
    changed width => { root.measure(); }
    changed settings-open => {
        if root.settings-open { app-focus.focus(); }
        else { root.advanced-open = false; }
    }
    changed queue-open => { if root.queue-open && !root.wide { app-focus.focus(); } }
    changed wide => { if !root.wide && root.queue-open { app-focus.focus(); } }
    changed light-mode => { Palette.color-scheme = root.light-mode ? light : dark; }

    // Windows may discard the software-rendered window contents on minimize
    // without reporting a zero-sized surface. A redraw alone then has no dirty
    // pixels to present. Toggle an identical, full-window background on restore
    // to invalidate the entire scene, without resizing or changing its colors.
    changed minimized => {
        if !root.minimized { root.restore-repaint = !root.restore-repaint; }
    }
    Rectangle {
        width: root.width;
        height: root.height;
        background: root.background;
        visible: root.restore-repaint;
    }

    app-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                if root.settings-open { root.settings-open = false; return accept; }
                if root.queue-open { root.queue-open = false; return accept; }
                if root.page != root.section { root.back(); return accept; }
            }
            return reject;
        }
        VerticalLayout {
            spacing: 0px;
            // ───────────── Top bar ─────────────
            if !root.collapsed : Rectangle {
                height: 64px;
                background: Theme.chrome;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 12px;
                    cross-axis-alignment: center;
                    HorizontalLayout {
                        width: root.sidebar-width - 16px - 12px + 8px;
                        spacing: 10px;
                        cross-axis-alignment: center;
                        alignment: root.roomy ? start : center;
                        Image { width: 30px; height: 30px; source: @image-url("assets/tide-icon.png"); image-fit: contain; }
                        if root.roomy : Text { text: "Tide"; color: Theme.text; font-size: 20px; font-weight: 700; vertical-alignment: center; }
                    }
                    IconButton { width: 36px; height: 36px; round: true; quiet: true; enabled: root.browsing-enabled && root.page != root.section; icon: "back"; label: root.section == Page.library ? "Back to Library" : "Back to Home"; clicked => { root.back(); } }
                    search := Rectangle {
                        horizontal-stretch: 1;
                        max-width: 520px;
                        height: 40px;
                        border-radius: 20px;
                        background: input.has-focus ? Theme.surface : search-touch.has-hover ? Theme.hover : Theme.raised;
                        border-width: input.has-focus ? 2px : 1px;
                        border-color: input.has-focus ? Theme.focus : Theme.outline;
                        opacity: root.browsing-enabled ? 1 : 0.6;
                        search-touch := TouchArea { mouse-cursor: text; clicked => { input.focus(); } }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 6px;
                            spacing: 10px;
                            cross-axis-alignment: center;
                            Icon { name: "search"; ink: input.has-focus ? Theme.text : Theme.muted; size: 17px; }
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 40px;
                                clip: true;
                                input := TextInput {
                                    width: parent.width;
                                    height: parent.height;
                                    vertical-alignment: center;
                                    single-line: true;
                                    color: Theme.text;
                                    selection-background-color: Theme.accent-soft;
                                    font-size: 13px;
                                    enabled: root.browsing-enabled;
                                    text <=> root.source-input;
                                    accessible-role: text-input;
                                    accessible-label: "Search music or paste a YouTube link";
                                    accepted => { if self.text != "" { root.add-source(self.text); } }
                                }
                                if root.source-input == "" : Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: "What do you want to listen to?";
                                    color: Theme.faint;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            if root.source-input != "" : IconButton { width: 28px; height: 28px; round: true; quiet: true; icon: "close"; icon-size: 14px; label: "Clear search"; clicked => { root.source-input = ""; input.focus(); } }
                        }
                    }
                    Rectangle { horizontal-stretch: 0.01; }
                    if root.roomy && root.account-state == AccountState.connected && root.account-name != "" : Text {
                        max-width: 180px;
                        text: root.account-name;
                        color: Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        IconButton {
                            width: 40px;
                            height: 40px;
                            round: true;
                            active: root.settings-open;
                            icon: "account";
                            label: "Open account and settings. " + (root.account-state == AccountState.connected ? "YouTube Music connected"
                                : root.account-state == AccountState.verifying ? "Verifying account"
                                : root.account-state == AccountState.saved ? "Saved session not verified" : "Not connected");
                            clicked => { root.settings-open = !root.settings-open; }
                        }
                        Rectangle {
                            x: parent.width - 11px;
                            y: 0px;
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            border-width: 2px;
                            border-color: Theme.chrome;
                            background: root.account-state == AccountState.connected ? Theme.success
                                : root.account-state == AccountState.disconnected ? Theme.faint : Theme.warning;
                        }
                    }
                }
            }
            // ───────────── Body ─────────────
            if !root.collapsed : body := Rectangle {
                vertical-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                max-width: 10000px;
                horizontal-stretch: 1;
                background: Theme.chrome;
                HorizontalLayout {
                    padding-bottom: 8px;
                    padding-right: root.queue-open && root.wide ? 0px : 8px;
                    spacing: 8px;
                    // Sidebar
                    VerticalLayout {
                        width: root.sidebar-width;
                        padding-left: 8px;
                        padding-right: 0px;
                        padding-top: 6px;
                        spacing: 2px;
                        NavigationButton { icon-only: !root.roomy; enabled: root.browsing-enabled; active: root.section == Page.home; icon: "home"; text: "Home"; label: "Open Home"; clicked => { root.navigate(Page.home); } }
                        NavigationButton { icon-only: !root.roomy; enabled: root.browsing-enabled; active: root.section == Page.library; icon: "library"; text: "Your library"; label: "Open your Library"; clicked => { root.navigate(Page.library); } }
                        NavigationButton { icon-only: !root.roomy; enabled: root.browsing-enabled; active: false; icon: "jam"; text: "Shared jam"; label: "Listen together with Tide and Grove friends"; clicked => { root.open-jam(); } }
                        NavigationButton { icon-only: !root.roomy; enabled: root.browsing-enabled; active: false; icon: "file"; text: "Open file"; label: "Open a local audio file"; clicked => { root.open-file(); } }
                        if root.roomy : Rectangle { height: 17px; Rectangle { x: 10px; y: 8px; width: parent.width - 20px; height: 1px; background: Theme.divider; } }
                        if root.roomy && root.account-connected : SectionTitle { height: 26px; text: "   PLAYLISTS"; }
                        if root.roomy && root.account-connected : SidebarPlaylist {
                            title: "Liked Songs";
                            subtitle: "Playlist · Auto";
                            liked: true;
                            active: root.page == Page.playlist && root.detail-liked;
                            enabled: root.browsing-enabled && root.account-ready;
                            open => { root.play-liked(); }
                        }
                        if root.roomy && root.account-connected : ListView {
                            vertical-stretch: 1;
                            accessible-label: "Your playlists";
                            for row[index] in root.library-playlists : SidebarPlaylist {
                                title: row.title;
                                subtitle: row.subtitle;
                                active: root.page == Page.playlist && !root.detail-liked && root.detail-title == row.title;
                                enabled: root.browsing-enabled && root.account-ready;
                                open => { root.select-library-playlist(index); }
                            }
                        }
                        if !root.roomy || !root.account-connected : Rectangle { vertical-stretch: 1; }
                    }
                    // Content panel
                    panel := Rectangle {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        background: Theme.surface;
                        border-radius: 12px;
                        clip: true;
                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: root.page == Page.playlist ? 360px : 300px;
                            background: @linear-gradient(180deg, root.hero-color.with-alpha(Theme.light ? 0.22 : 0.34) 0%, root.hero-color.with-alpha(0) 100%);
                            animate height { duration: Theme.slow; }
                        }

                        // ── Home ──
                        if root.page == Page.home : home-scroll := ScrollView {
                            y: root.enter-offset;
                            opacity: root.enter-opacity;
                            animate y, opacity { duration: Theme.medium; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                            init => { self.y = 0; self.opacity = 1; }
                            width: parent.width;
                            height: parent.height;
                            content-y <=> root.home-artwork-y;
                            changed visible-height => { root.home-artwork-height = self.visible-height; }
                            horizontal-scrollbar-policy: always-off;
                            VerticalLayout {
                                width: home-scroll.visible-width;
                                padding: root.page-padding;
                                spacing: 26px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    cross-axis-alignment: center;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        Text { text: root.account-connected ? "For you" : "Welcome to Tide"; color: Theme.text; font-size: 30px; font-weight: 800; overflow: elide; }
                                        Text { text: root.account-connected ? "Picks from your YouTube Music Home" : "A lightweight player that leaves your PC free for games."; color: Theme.muted; font-size: 13px; overflow: elide; }
                                    }
                                    if root.account-connected : TextButton { pill: true; width: 108px; icon: "refresh"; text: "Refresh"; label: "Show a different selection of recommendations"; enabled: root.browsing-enabled && root.account-ready; clicked => { root.refresh-recommendations(); } }
                                }
                                for shelf in root.home-shelves : VerticalLayout {
                                    spacing: 10px;
                                    Text { text: shelf.title == "" ? "Recommended" : shelf.title; color: Theme.text; font-size: 19px; font-weight: 700; overflow: elide; }
                                    Rectangle {
                                        height: ceil(shelf.items.length / root.grid-columns) * (root.card-height + root.grid-gap) - root.grid-gap;
                                        for item[i] in shelf.items : MediaCard {
                                            x: (i - floor(i / root.grid-columns) * root.grid-columns) * (root.card-width + root.grid-gap) - 10px;
                                            y: floor(i / root.grid-columns) * (root.card-height + root.grid-gap);
                                            width: root.card-width + 20px;
                                            height: root.card-height;
                                            artwork: item.artwork;
                                            title: item.title;
                                            subtitle: item.kind == "song" ? "Song · " + item.subtitle : item.subtitle;
                                            song: item.kind == "song";
                                            playing: item.kind == "song" && root.has-track && item.title == root.track-title;
                                            placeholder: item.kind == "song" ? "note" : item.kind == "album" ? "radio" : "playlist";
                                            available: item.kind == "song" || item.kind == "playlist";
                                            unavailable-label: item.kind == "album" ? "Album · coming soon" : "Not playable yet";
                                            enabled: root.browsing-enabled && root.account-ready;
                                            open => { root.select-recommendation(shelf.first + i); }
                                            play => {
                                                if item.kind == "song" { root.select-recommendation(shelf.first + i); }
                                                else { root.play-playlist(1, shelf.first + i); }
                                            }
                                            queue(next) => { root.queue-recommendation(shelf.first + i, next); }
                                            radio => { root.start-track-radio(3, shelf.first + i); }
                                        }
                                    }
                                }
                                if root.home-shelves.length == 0 : EmptyState {
                                    min-height: 360px;
                                    loading: root.account-connected && root.provider-busy;
                                    icon: root.account-connected ? "radio" : "note";
                                    heading: !root.account-connected ? "Start listening"
                                        : root.provider-busy ? "Loading your music…" : "No recommendations yet";
                                    detail: !root.account-connected ? "Search above, paste a YouTube link or open a file. Connect YouTube Music for your playlists and personal picks."
                                        : root.provider-busy ? "Your YouTube Music picks will appear here shortly." : "Refresh to load picks from your YouTube Music Home, or search above.";
                                    action: !root.account-connected ? "Connect YouTube Music" : root.provider-busy ? "" : "Refresh";
                                    secondary-action: !root.account-connected ? "Open audio file" : "";
                                    act => { if root.account-connected { root.refresh-recommendations(); } else { root.settings-open = true; } }
                                    act-secondary => { root.open-file(); }
                                }
                            }
                        }

                        // ── Library ──
                        if root.page == Page.library : library-scroll := ScrollView {
                            y: root.enter-offset;
                            opacity: root.enter-opacity;
                            animate y, opacity { duration: Theme.medium; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                            init => { self.y = 0; self.opacity = 1; }
                            width: parent.width;
                            height: parent.height;
                            content-y <=> root.library-artwork-y;
                            changed visible-height => { root.library-artwork-height = self.visible-height; }
                            horizontal-scrollbar-policy: always-off;
                            VerticalLayout {
                                width: library-scroll.visible-width;
                                padding: root.page-padding;
                                spacing: 22px;
                                HorizontalLayout {
                                    height: 60px;
                                    spacing: 12px;
                                    cross-axis-alignment: center;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        alignment: center;
                                        Text { text: "Your library"; color: Theme.text; font-size: 30px; font-weight: 800; overflow: elide; }
                                        Text {
                                            text: root.account-state == AccountState.connected
                                                ? (root.library-playlists.length == 1 ? "1 playlist" : root.library-playlists.length + " playlists") + " · Liked Songs"
                                                : root.account-state == AccountState.verifying ? "Checking your account…" : "Playlists from YouTube Music";
                                            color: Theme.muted;
                                            font-size: 13px;
                                        }
                                    }
                                    if root.account-connected : TextButton { pill: true; width: 108px; icon: "refresh"; text: "Refresh"; label: "Refresh your playlists"; enabled: root.browsing-enabled && root.account-ready; clicked => { root.refresh-library(); } }
                                }
                                if root.account-connected : Rectangle {
                                    height: ceil((root.library-playlists.length + 1) / root.grid-columns) * (root.card-height + root.grid-gap) - root.grid-gap;
                                    MediaCard {
                                        x: -10px;
                                        y: 0px;
                                        width: root.card-width + 20px;
                                        height: root.card-height;
                                        title: "Liked Songs";
                                        subtitle: "Playlist · Auto";
                                        brand: true;
                                        placeholder: "heart";
                                        enabled: root.browsing-enabled && root.account-ready;
                                        open => { root.play-liked(); }
                                        play => { root.play-liked(); }
                                    }
                                    for row[index] in root.library-playlists : MediaCard {
                                        x: (index + 1 - floor((index + 1) / root.grid-columns) * root.grid-columns) * (root.card-width + root.grid-gap) - 10px;
                                        y: floor((index + 1) / root.grid-columns) * (root.card-height + root.grid-gap);
                                        width: root.card-width + 20px;
                                        height: root.card-height;
                                        artwork: row.artwork;
                                        title: row.title;
                                        subtitle: row.subtitle;
                                        enabled: root.browsing-enabled && root.account-ready;
                                        open => { root.select-library-playlist(index); }
                                        play => { root.play-playlist(0, index); }
                                    }
                                }
                                if !root.account-connected : EmptyState {
                                    min-height: 360px;
                                    icon: "library";
                                    heading: "Connect to see your library";
                                    detail: "Connect your YouTube Music account to browse your playlists and Liked Songs.";
                                    action: "Connect YouTube Music";
                                    act => { root.settings-open = true; }
                                }
                                if root.account-connected && root.library-playlists.length == 0 && root.provider-busy : HorizontalLayout { alignment: center; LoadingDots { } }
                            }
                        }

                        // ── Playlist ──
                        if root.page == Page.playlist : VerticalLayout {
                            y: root.enter-offset;
                            opacity: root.enter-opacity;
                            animate y, opacity { duration: Theme.medium; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                            init => { self.y = 0; self.opacity = 1; }
                            width: parent.width;
                            height: parent.height;
                            padding-left: root.page-padding;
                            padding-right: root.page-padding;
                            padding-top: root.page-padding;
                            spacing: 18px;
                            HorizontalLayout {
                                height: root.compact-mode ? 150px : 184px;
                                spacing: 24px;
                                Cover {
                                    width: root.compact-mode ? 150px : 184px;
                                    height: self.width;
                                    border-radius: 10px;
                                    artwork: root.detail-artwork;
                                    brand: root.detail-liked;
                                    seed: root.detail-title;
                                    placeholder: root.detail-liked ? "heart" : "playlist";
                                    drop-shadow-blur: 24px;
                                    drop-shadow-offset-y: 8px;
                                    drop-shadow-color: Theme.shadow;
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    spacing: 6px;
                                    alignment: end;
                                    SectionTitle { text: "PLAYLIST"; font-size: 11px; color: Theme.muted; }
                                    Text { text: root.detail-title; color: Theme.text; font-size: root.compact-mode ? 28px : 38px; font-weight: 800; overflow: elide; }
                                    Text {
                                        text: (root.detail-subtitle == "" ? "" : root.detail-subtitle + " · ")
                                            + (root.detail-busy ? "Loading tracks…" : root.detail-rows.length == 1 ? "1 song" : root.detail-rows.length + " songs");
                                        color: Theme.muted;
                                        font-size: 13px;
                                        overflow: elide;
                                    }
                                    Rectangle { height: 6px; }
                                    HorizontalLayout {
                                        spacing: 14px;
                                        alignment: start;
                                        cross-axis-alignment: center;
                                        PlayButton { width: 52px; height: 52px; label: "Play " + root.detail-title; enabled: root.browsing-enabled && !root.detail-busy && root.detail-rows.length > 0; clicked => { root.play-detail(); } }
                                        IconButton { width: 40px; height: 40px; round: true; quiet: true; icon: "shuffle"; icon-size: 22px; label: "Shuffle " + root.detail-title; enabled: root.browsing-enabled && !root.detail-busy && root.detail-rows.length > 0; clicked => { root.shuffle-detail(); } }
                                    }
                                }
                            }
                            if root.detail-rows.length > 0 : VerticalLayout {
                                vertical-stretch: 1;
                                spacing: 4px;
                                TrackTableHeader { show-album: root.table-album; }
                                ListView {
                                    vertical-stretch: 1;
                                    content-y <=> root.detail-artwork-y;
                                    changed visible-height => { root.detail-artwork-height = self.visible-height; }
                                    accessible-label: "Tracks in " + root.detail-title;
                                    for row[index] in root.detail-rows : SongRow {
                                        enabled: root.browsing-enabled;
                                        track: row;
                                        index: index;
                                        number: index + 1;
                                        show-album: root.table-album;
                                        playing: root.playing-row(row);
                                        live: !root.paused;
                                        select => { root.select-detail-track(index); }
                                        queue(next) => { root.queue-detail-track(index, next); }
                                        radio => { root.start-track-radio(1, index); }
                                    }
                                }
                            }
                            if root.detail-rows.length == 0 : EmptyState {
                                vertical-stretch: 1;
                                loading: root.detail-busy;
                                icon: "playlist";
                                heading: root.detail-busy ? "Loading tracks…" : "No playable songs";
                                detail: root.detail-busy ? "Your playlist will appear here shortly." : "This playlist has no songs Tide can play. Choose another one.";
                                action: root.detail-busy ? "" : "Go back";
                                act => { root.back(); }
                            }
                        }

                        // ── Search ──
                        if root.page == Page.search : VerticalLayout {
                            y: root.enter-offset;
                            opacity: root.enter-opacity;
                            animate y, opacity { duration: Theme.medium; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                            init => { self.y = 0; self.opacity = 1; }
                            width: parent.width;
                            height: parent.height;
                            padding-left: root.page-padding;
                            padding-right: root.page-padding;
                            padding-top: root.page-padding;
                            spacing: 16px;
                            VerticalLayout {
                                spacing: 4px;
                                SectionTitle { text: "SEARCH RESULTS"; font-size: 11px; color: Theme.muted; }
                                Text { text: root.search-query == "" ? "Songs" : "“" + root.search-query + "”"; color: Theme.text; font-size: 30px; font-weight: 800; overflow: elide; }
                                Text { text: root.search-busy ? "Searching YouTube…" : root.search-rows.length == 1 ? "1 song" : root.search-rows.length + " songs"; color: Theme.muted; font-size: 13px; }
                            }
                            if root.search-rows.length > 0 : VerticalLayout {
                                vertical-stretch: 1;
                                spacing: 4px;
                                TrackTableHeader { show-album: false; }
                                ListView {
                                    vertical-stretch: 1;
                                    content-y <=> root.search-artwork-y;
                                    changed visible-height => { root.search-artwork-height = self.visible-height; }
                                    accessible-label: "Music search results";
                                    for row[index] in root.search-rows : SongRow {
                                        enabled: root.browsing-enabled;
                                        track: row;
                                        index: index;
                                        number: index + 1;
                                        playing: root.playing-row(row);
                                        live: !root.paused;
                                        select => { root.select-search-track(index); }
                                        queue(next) => { root.queue-search-track(index, next); }
                                        radio => { root.start-track-radio(2, index); }
                                    }
                                }
                            }
                            if root.search-rows.length == 0 : EmptyState {
                                vertical-stretch: 1;
                                loading: root.search-busy;
                                icon: "search";
                                heading: root.search-busy ? "Searching…" : "No songs found";
                                detail: root.search-busy ? "Finding music for your search." : "Try a different song title or artist, or paste a link.";
                            }
                        }

                        // Error banner floats over the page so it never shifts content.
                        if root.error-message != "" : Rectangle {
                            x: 16px;
                            y: Theme.motion ? -64px : 16px;
                            init => { self.y = 16px; }
                            animate y { duration: Theme.medium; easing: cubic-bezier(0.2, 0.9, 0.3, 1.2); }
                            width: parent.width - 32px;
                            height: 56px;
                            border-radius: 12px;
                            background: Theme.notice;
                            border-width: 1px;
                            border-color: Theme.outline;
                            drop-shadow-blur: 18px;
                            drop-shadow-offset-y: 4px;
                            drop-shadow-color: Theme.shadow;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 10px;
                                spacing: 12px;
                                cross-axis-alignment: center;
                                Icon { name: "warning"; ink: Theme.selected-ink; size: 20px; }
                                Text { horizontal-stretch: 1; text: root.error-message; color: Theme.text; font-size: 13px; vertical-alignment: center; wrap: word-wrap; overflow: elide; accessible-live-region: assertive; }
                                if root.error-action != ErrorAction.dismiss : TextButton {
                                    pill: true;
                                    primary: true;
                                    text: root.error-action == ErrorAction.account ? "Account settings" : "Retry";
                                    enabled: !root.settings-open;
                                    label: root.error-action == ErrorAction.account ? "Open account settings to resolve the connection problem" : "Retry interrupted playback or recommendations";
                                    clicked => { root.retry-error(); }
                                }
                                IconButton { round: true; quiet: true; icon: "close"; icon-size: 16px; label: "Dismiss this message"; clicked => { root.dismiss-error(); } }
                            }
                        }

                        // Toast for brief confirmations.
                        if root.toast-visible : Rectangle {
                            property <length> rise: Theme.motion ? 24px : 0px;
                            init => { self.rise = 0; self.opacity = 1; }
                            animate rise, opacity { duration: Theme.medium; easing: cubic-bezier(0.2, 0.9, 0.3, 1.2); }
                            opacity: Theme.motion ? 0 : 1;
                            x: (parent.width - self.width) / 2;
                            y: parent.height - self.height - 20px + self.rise;
                            width: min(parent.width - 40px, toast-label.preferred-width + 40px);
                            height: 40px;
                            border-radius: 20px;
                            background: Theme.light ? #2f2529 : #f4f2f3;
                            drop-shadow-blur: 18px;
                            drop-shadow-offset-y: 4px;
                            drop-shadow-color: Theme.shadow;
                            Timer { interval: 3200ms; running: true; triggered => { root.toast-visible = false; } }
                            toast-label := Text {
                                x: 20px;
                                width: parent.width - 40px;
                                height: parent.height;
                                text: root.toast-text;
                                color: Theme.light ? #fbf8f3 : #17151a;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                overflow: elide;
                                accessible-live-region: polite;
                            }
                        }
                    }
                    if root.queue-open && root.wide : QueueDrawer {
                        artwork-scroll-y <=> root.queue-artwork-y;
                        artwork-view-height <=> root.queue-artwork-height;
                        enabled: !root.settings-open;
                        width: 340px;
                        rows: root.rows;
                        current-index: root.current-index;
                        autoplay-enabled: root.autoplay-enabled;
                        repeat-enabled: root.repeat-enabled;
                        live: !root.paused;
                        close => { root.queue-open = false; }
                        select(index) => { root.select-track(index); }
                        remove(index) => { root.remove-queue-track(index); }
                        requeue(index, next) => { root.requeue-track(index, next); }
                        reorder(source, target) => { root.reorder-queue-track(source, target); }
                        radio(index) => { root.start-track-radio(0, index); }
                        toggle-autoplay => { root.toggle-autoplay(); }
                        toggle-repeat => { root.toggle-repeat(); }
                        shuffle => { root.shuffle-queue(); }
                        clear => { root.clear-queue(); }
                    }
                }
                // Narrow windows: the queue overlays the content with a scrim.
                if root.queue-open && !root.wide : Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    Rectangle {
                        x: 0px; y: 0px; width: max(0px, parent.width - 340px); height: parent.height; background: Theme.scrim;
                        opacity: Theme.motion ? 0 : 1;
                        init => { self.opacity = 1; }
                        animate opacity { duration: Theme.medium; }
                        TouchArea { clicked => { root.queue-open = false; } }
                    }
                    QueueDrawer {
                        property <length> slide: Theme.motion ? 340px : 0px;
                        init => { self.slide = 0; }
                        animate slide { duration: Theme.medium; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
                        artwork-scroll-y <=> root.queue-artwork-y;
                        artwork-view-height <=> root.queue-artwork-height;
                        enabled: !root.settings-open;
                        x: max(0px, parent.width - 340px) + self.slide;
                        y: 0px;
                        width: 340px;
                        height: parent.height;
                        rows: root.rows;
                        current-index: root.current-index;
                        autoplay-enabled: root.autoplay-enabled;
                        repeat-enabled: root.repeat-enabled;
                        live: !root.paused;
                        close => { root.queue-open = false; }
                        select(index) => { root.select-track(index); }
                        remove(index) => { root.remove-queue-track(index); }
                        requeue(index, next) => { root.requeue-track(index, next); }
                        reorder(source, target) => { root.reorder-queue-track(source, target); }
                        radio(index) => { root.start-track-radio(0, index); }
                        toggle-autoplay => { root.toggle-autoplay(); }
                        toggle-repeat => { root.toggle-repeat(); }
                        shuffle => { root.shuffle-queue(); }
                        clear => { root.clear-queue(); }
                    }
                }
                // Account & settings sheet.
                if root.settings-open : Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    Rectangle {
                        x: 0px; y: 0px; width: max(0px, parent.width - 420px); height: parent.height; background: Theme.scrim;
                        opacity: Theme.motion ? 0 : 1;
                        init => { self.opacity = 1; }
                        animate opacity { duration: Theme.medium; }
                        TouchArea { clicked => { root.settings-open = false; } }
                    }
                    Rectangle {
                        property <length> slide: Theme.motion ? 420px : 0px;
                        init => { self.slide = 0; }
                        animate slide { duration: Theme.medium; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
                        drop-shadow-blur: 30px;
                        drop-shadow-color: Theme.shadow;
                        x: max(0px, parent.width - 420px) + self.slide;
                        y: 0px;
                        width: 420px;
                        height: parent.height;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.outline;
                        TouchArea { }
                        ScrollView {
                            width: parent.width;
                            height: parent.height;
                            horizontal-scrollbar-policy: always-off;
                            VerticalLayout {
                                padding: 20px;
                                spacing: 14px;
                                HorizontalLayout {
                                    height: 36px;
                                    cross-axis-alignment: center;
                                    Text { horizontal-stretch: 1; text: "Account & settings"; color: Theme.text; font-size: 20px; font-weight: 700; vertical-alignment: center; }
                                    IconButton { width: 32px; height: 32px; round: true; quiet: true; icon: "close"; icon-size: 16px; label: "Close account and settings"; clicked => { root.settings-open = false; } }
                                }

                                // YouTube Music connection
                                Rectangle {
                                    border-radius: 12px;
                                    background: Theme.window;
                                    border-width: 1px;
                                    border-color: Theme.outline;
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 10px;
                                        SectionTitle { height: 14px; text: "YOUTUBE MUSIC"; }
                                        HorizontalLayout {
                                            height: 44px;
                                            spacing: 12px;
                                            cross-axis-alignment: center;
                                            Rectangle {
                                                width: 40px;
                                                height: 40px;
                                                border-radius: 20px;
                                                background: root.account-state == AccountState.connected ? Theme.brand : Theme.cover;
                                                Icon { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; name: "account"; ink: root.account-state == AccountState.connected ? #ffffff : Theme.cover-ink; size: 20px; }
                                            }
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                min-width: 0px;
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: root.account-state == AccountState.verifying ? "Verifying account…"
                                                        : root.account-state == AccountState.connected ? (root.account-name == "" ? "Connected" : root.account-name)
                                                        : root.account-state == AccountState.saved ? "Saved session" : "Not connected";
                                                    color: Theme.text;
                                                    font-size: 14px;
                                                    font-weight: 600;
                                                    overflow: elide;
                                                }
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    cross-axis-alignment: center;
                                                    Rectangle {
                                                        width: 8px;
                                                        height: 8px;
                                                        border-radius: 4px;
                                                        background: root.account-state == AccountState.connected ? Theme.success
                                                            : root.account-state == AccountState.disconnected ? Theme.faint : Theme.warning;
                                                    }
                                                    Text {
                                                        horizontal-stretch: 1;
                                                        text: root.account-state == AccountState.connected ? "Connected"
                                                            : root.account-state == AccountState.verifying ? "Checking access"
                                                            : root.account-state == AccountState.saved ? "Not verified yet" : "Optional · for playlists and picks";
                                                        color: Theme.muted;
                                                        font-size: 12px;
                                                    }
                                                }
                                            }
                                            if root.account-state == AccountState.verifying : LoadingDots { }
                                        }
                                        Text { text: root.account-status; color: Theme.muted; font-size: 11px; wrap: word-wrap; accessible-live-region: polite; }
                                        HorizontalLayout {
                                            height: 38px;
                                            spacing: 8px;
                                            TextButton { horizontal-stretch: 1; height: 38px; pill: true; icon: root.account-connected ? "refresh" : "account"; text: root.account-connected ? "Reconnect" : "Connect YouTube Music"; label: "Connect your local YouTube Music session"; enabled: !root.provider-busy; primary: !root.account-connected; clicked => { root.connect-account(); } }
                                            if root.provider-busy : TextButton { width: 88px; height: 38px; pill: true; text: "Cancel"; label: "Cancel the account request"; clicked => { root.cancel-account(); } }
                                        }
                                        if root.account-connected : HorizontalLayout {
                                            height: 34px;
                                            spacing: 8px;
                                            cross-axis-alignment: center;
                                            Text { text: "Google account"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                            ComboBox { horizontal-stretch: 1; model: ["Account 1", "Account 2", "Account 3", "Account 4", "Account 5", "Account 6", "Account 7", "Account 8", "Account 9", "Account 10"]; current-index <=> root.account-index; enabled: root.account-ready; }
                                            TextButton { width: 74px; text: "Switch"; label: "Use the selected Google account"; enabled: root.account-ready; clicked => { root.switch-account(root.account-index); } }
                                        }
                                    }
                                }

                                // Appearance
                                Rectangle {
                                    border-radius: 12px;
                                    background: Theme.window;
                                    border-width: 1px;
                                    border-color: Theme.outline;
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 12px;
                                        SectionTitle { height: 14px; text: "APPEARANCE"; }
                                        HorizontalLayout {
                                            height: 32px;
                                            cross-axis-alignment: center;
                                            Text { horizontal-stretch: 1; text: "Theme"; color: Theme.text; font-size: 13px; vertical-alignment: center; }
                                            Segmented { first: "Dark"; second: "Light"; label: "Color theme"; second-selected: root.light-mode; choose(light) => { if light != root.light-mode { root.switch-mode(); } } }
                                        }
                                        HorizontalLayout {
                                            height: 32px;
                                            cross-axis-alignment: center;
                                            Text { horizontal-stretch: 1; text: "Window size"; color: Theme.text; font-size: 13px; vertical-alignment: center; }
                                            Segmented { first: "Full"; second: "Compact"; label: "Window size"; second-selected: root.compact-mode; choose(compact) => { if compact != root.compact-mode { root.toggle-compact(); } } }
                                        }
                                        Toggle { text: "Animations"; on: root.motion; toggled => { root.toggle-motion(); } }
                                    }
                                }

                                // Playback
                                Rectangle {
                                    border-radius: 12px;
                                    background: Theme.window;
                                    border-width: 1px;
                                    border-color: Theme.outline;
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 6px;
                                        SectionTitle { height: 18px; text: "PLAYBACK"; }
                                        Toggle { text: "Autoplay similar songs when the queue ends"; on: root.autoplay-enabled; toggled => { root.toggle-autoplay(); } }
                                        Toggle { text: "Repeat the queue"; on: root.repeat-enabled; toggled => { root.toggle-repeat(); } }
                                    }
                                }

                                TextButton { height: 34px; quiet: true; icon: root.advanced-open ? "back" : "chevron"; text: root.advanced-open ? "Hide advanced options" : "Advanced options"; label: root.advanced-open ? "Hide advanced account options" : "Show advanced account options"; clicked => { root.advanced-open = !root.advanced-open; } }
                                if root.advanced-open : VerticalLayout {
                                    spacing: 8px;
                                    Text { text: "Import a session file if browser connection is unavailable. Disconnect removes the saved session from this computer."; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                                    HorizontalLayout {
                                        height: 34px;
                                        spacing: 8px;
                                        TextButton { horizontal-stretch: 1; text: "Import session"; label: "Import session from a local file"; enabled: !root.provider-busy; clicked => { root.import-account(); } }
                                        TextButton { horizontal-stretch: 1; text: "Disconnect"; label: "Disconnect YouTube Music account and remove the saved session"; enabled: root.account-ready; clicked => { root.disconnect-account(); } }
                                        TextButton { width: 70px; text: "Help"; label: "Help connecting your account"; clicked => { root.open-account-help(); } }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.divider; }
                                Text { text: "Tide 0.1.0 preview · not affiliated with YouTube"; color: Theme.faint; font-size: 11px; }
                                AboutSlint { height: 112px; horizontal-stretch: 0; }
                            }
                        }
                    }
                }
            }
            PlayerBar {
                following-jam: root.following-jam;
                window-minimized: root.minimized;
                preferred-height: root.collapsed ? 110px : 88px;
                min-height: root.collapsed ? 110px : 88px;
                max-height: root.collapsed ? 1000px : 88px;
                vertical-stretch: root.collapsed ? 1 : 0;
                has-track: root.has-track;
                loading: root.loading;
                tint: root.has-now-tint ? root.now-tint : Theme.accent;
                repeat-enabled: root.repeat-enabled;
                track-title: root.track-title;
                track-artist: root.track-artist;
                artwork: root.current-artwork;
                position: root.position;
                duration: root.duration;
                paused: root.paused;
                volume: root.volume;
                compact: root.compact-mode;
                collapsed: root.collapsed;
                queue-open: root.queue-open;
                toggle-pause => { root.toggle-pause(); }
                next-track => { root.next-track(); }
                previous-track => { root.previous-track(); }
                toggle-repeat => { root.toggle-repeat(); }
                shuffle-queue => { root.shuffle-queue(); }
                seek(value) => { root.seek(value); }
                change-volume(value) => { root.change-volume(value); }
                restore => { root.collapse-player(); }
                mini => { root.collapse-player(); }
                toggle-queue => { root.queue-open = !root.queue-open; }
            }
        }
    }
}
