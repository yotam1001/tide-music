                            horizontal-scrollbar-policy: always-off;
                            VerticalLayout {
                            padding: 24px;
                            spacing: 16px;
                            alignment: start;
                            HorizontalLayout { height: 42px; cross-axis-alignment: center; Text { horizontal-stretch: 1; text: "Account"; color: root.foreground; font-size: 25px; font-weight: 650; } LibraryButton { width: 32px; height: 32px; light-mode: root.light-mode; caption: "×"; label: "Close account"; clicked => { root.account-open = false; } } }
                            HorizontalLayout {
                                height: 64px; spacing: 14px; cross-axis-alignment: center;
                                Rectangle {
                                    width: 48px; height: 48px; border-radius: 24px;
                                    background: Theme.selected;
                                    Path { x: 12px; y: 10px; width: 24px; height: 28px; viewbox-width: 24; viewbox-height: 28; fill: Colors.transparent; stroke: Theme.cover-ink; stroke-width: 1.6px; commands: "M 17 7 A 5 5 0 1 0 7 7 A 5 5 0 1 0 17 7 Z M 3 25 L 3 22 C 3 12 21 12 21 22 L 21 25"; }
                                }
                                VerticalLayout {
                                    min-width: 0px; horizontal-stretch: 1; spacing: 5px; alignment: center;
                                    Text { text: root.account-name != "" ? root.account-name : "YouTube Music"; color: root.foreground; font-size: 18px; font-weight: 600; overflow: elide; }
                                    Text { text: root.account-busy ? "Connecting…" : root.account-verified ? "Connected to YouTube Music" : root.account-connected ? "Saved session · verification needed" : "Not connected"; color: root.secondary; font-size: 12px; overflow: elide; }
                                }
                            }
                            if root.account-status != "" : Text { max-height: 72px; overflow: elide; text: root.account-status; color: root.secondary; font-size: 12px; wrap: word-wrap; accessible-live-region: polite; }
                            if root.native-login-status != "" : Text { text: root.native-login-status; color: root.secondary; font-size: 12px; wrap: word-wrap; accessible-live-region: polite; }
                            if !root.account-verified : Text { text: root.native-login-available ? "Sign in with Google, then choose the YouTube Music profile you listen with." : "Import your signed-in YouTube Music tab with Tide’s browser companion to use your playlists and recommendations."; color: root.secondary; font-size: 13px; wrap: word-wrap; }
                            if root.native-login-available : LibraryButton { height: 42px; quiet: false; light-mode: root.light-mode; caption: root.native-login-busy ? "Sign-in window open…" : root.account-verified ? "Reconnect YouTube Music" : "Sign in with Google"; label: "Open the temporary Google sign-in window"; enabled: !root.account-busy && !root.native-login-busy; active: !root.account-verified; clicked => { root.native-sign-in(); } }
                            LibraryButton { height: root.native-login-available ? 36px : 42px; quiet: root.native-login-available; light-mode: root.light-mode; caption: root.native-login-available ? "Use browser companion instead" : root.account-verified ? "Manage connection" : "Connect YouTube Music"; label: "Open browser companion connection guide"; enabled: !root.account-busy && !root.native-login-busy; active: !root.native-login-available && !root.account-verified; clicked => { root.open-account-help(); } }
                            if root.native-login-busy : LibraryButton { height: 36px; light-mode: root.light-mode; caption: "Close sign-in window"; label: "Close the owned temporary sign-in window"; clicked => { root.cancel-native-sign-in(); } }
                            if root.account-busy : LibraryButton { height: 36px; light-mode: root.light-mode; caption: "Cancel connection"; label: "Cancel account request"; clicked => { root.cancel-account(); } }
                            Rectangle { height: 1px; background: root.outline; }
                            LibraryButton { height: 36px; light-mode: root.light-mode; caption: root.advanced-open ? "Advanced connection options  ⌃" : "Advanced connection options  ⌄"; label: root.advanced-open ? "Hide advanced account options" : "Show advanced account options"; clicked => { root.advanced-open = !root.advanced-open; } }
                            if root.advanced-open : VerticalLayout {
                                spacing: 12px;
                                Text { text: "Google account slot"; color: root.foreground; font-size: 13px; font-weight: 600; }
                                Text { text: "Use this only if the imported session opened the wrong Google account. Select your YouTube profile in the browser before importing."; color: root.secondary; font-size: 12px; wrap: word-wrap; }
                                HorizontalLayout { height: 36px; spacing: 8px; ComboBox { horizontal-stretch: 1; model: ["Account 1", "Account 2", "Account 3", "Account 4", "Account 5", "Account 6", "Account 7", "Account 8", "Account 9", "Account 10"]; current-index <=> root.account-index; enabled: root.account-connected && !root.account-busy && !root.native-login-busy; } LibraryButton { width: 76px; quiet: false; light-mode: root.light-mode; caption: "Switch"; label: "Connect selected Google account"; enabled: root.account-connected && !root.account-busy && !root.native-login-busy; clicked => { root.switch-account(root.account-index); } } }
                                LibraryButton { height: 36px; quiet: false; light-mode: root.light-mode; caption: "Import Zen profile"; label: "Select an existing Zen cookie database for advanced import"; enabled: !root.account-busy && !root.native-login-busy; clicked => { root.connect-account(); } }
                                LibraryButton { height: 36px; quiet: false; light-mode: root.light-mode; caption: "Import session file"; label: "Import session from a local file"; enabled: !root.account-busy && !root.native-login-busy; clicked => { root.import-account(); } }
                            }
                            if root.account-connected : LibraryButton { height: 36px; quiet: false; light-mode: root.light-mode; caption: "Disconnect account"; label: "Disconnect YouTube Music account"; enabled: !root.account-busy && !root.native-login-busy; clicked => { root.disconnect-account(); } }

                            }
                        }
                    }
                }
                if root.artist-picker-open : Rectangle {
                    width: parent.width; height: parent.height; background: #00000060;
                    TouchArea { clicked => { root.back-detail(); } }
                    Rectangle {
                        width: min(360px, parent.width - 24px); height: min(parent.height - 24px, 94px + root.artist-choices.length * 48px);
                        x: (parent.width - self.width) / 2; y: max(12px, (parent.height - self.height) / 2);
                        background: root.surface; border-width: 1px; border-color: root.outline; border-radius: 12px;
                        TouchArea { }
                        VerticalLayout {
                            padding: 16px; spacing: 10px;
                            HorizontalLayout { height: 32px; Text { horizontal-stretch: 1; text: "Choose an artist"; font-weight: 600; color: root.foreground; } LibraryButton { width: 30px; height: 30px; caption: "×"; label: "Cancel artist selection"; light-mode: root.light-mode; clicked => { root.back-detail(); } } }
                            ScrollView { horizontal-scrollbar-policy: always-off; vertical-stretch: 1;
                                VerticalLayout { spacing: 8px; alignment: start;
                                    for artist[index] in root.artist-choices : LibraryButton { height: 40px; caption: artist.name; label: "Open artist " + artist.name; active: root.artist-choice-index == index; light-mode: root.light-mode; clicked => { root.choose-artist(index); } }
                                }
                            }
                        }
                    }
                }
                if root.jam-available && root.jam-open : Rectangle {
                    x: LayoutMetrics.navigation-wide; width: max(0px, parent.width - self.x);
                    height: parent.height;
                    // Same raised panel as the other pages.
                    background: Theme.surface;
                    border-top-left-radius: 14px;
                    Rectangle {
                        x: root.jam-queue-visible ? 0px : max(0px, (parent.width - self.width) / 2); width: root.jam-queue-visible ? parent.width * 0.59 : min(820px, parent.width); height: parent.height;
                        background: transparent;
                        TouchArea { }
                        ScrollView {
                            width: parent.width; height: parent.height; horizontal-scrollbar-policy: always-off;
                            VerticalLayout {
                                padding: root.sidebar-profile ? 28px : 18px; spacing: root.sidebar-profile ? 16px : 10px; alignment: start;
                                HorizontalLayout {
                                    height: root.sidebar-profile ? 42px : 36px; spacing: 8px; cross-axis-alignment: center;
                                    Text { horizontal-stretch: 1; text: root.jam-active ? "Listening together" : "Jams"; color: root.foreground; font-size: 28px; font-weight: 650; overflow: elide; }
                                    if root.jam-active && !root.jam-guest : LibraryButton {
                                        width: 126px; height: 36px; light-mode: root.light-mode; active: true;
                                        leading-icon: "M 9 9 L 20 9 L 20 21 L 9 21 Z M 6 16 L 3 16 L 3 3 L 14 3 L 14 6";
                                        caption: "Copy invite"; enabled: root.jam-invite-code != "";
                                        label: "Copy the private guest invite code"; clicked => { root.jam-copy-invite(); }
                                    }
                                    LibraryButton { width: 30px; height: 30px; light-mode: root.light-mode; caption: "×"; label: "Close Jam controls"; clicked => { root.jam-open = false; } }
                                }
