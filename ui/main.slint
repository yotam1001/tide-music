                                Text { horizontal-stretch: 1; text: "Songs everyone is listening to"; font-size: 12px; color: root.secondary; overflow: elide; }
                                if !root.jam-guest : LibraryButton {
                                    width: 84px; height: 28px; light-mode: root.light-mode; caption: "Edit queue";
                                    label: "Open shared queue editing controls";
                                    clicked => { root.jam-open = false; root.queue-open = true; }
                                }
