                                            height: LayoutMetrics.browse-row-height; quick: true; item: card; source-index: index;
                                            light-mode: root.light-mode; enabled: root.browsing-enabled && !root.account-busy;
                                            select => { root.select-search-card(index); }
                                        }
                                    }
                                }
                                if root.search-busy && root.search-result-count == 0 : LoadingTracks { placeholder-color: root.outline; }
                                if !root.search-busy && root.search-result-count == 0 : EmptyState {
