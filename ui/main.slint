                        LibraryButton { width: 64px; height: 28px; light-mode: root.light-mode; caption: "Clear"; label: "Clear recent searches"; clicked => { root.clear-recent-searches(); } }
                    }
                    for query in root.recent-searches : LibraryButton {
                        height: 36px; light-mode: root.light-mode; caption: query; label: "Search again for " + query;
                        leading-icon: "M 21 12 A 9 9 0 1 0 3 12 A 9 9 0 1 0 21 12 Z M 12 7 L 12 12 L 15 14";
                        clicked => { root.source-input = query; root.submit-source(query); }
