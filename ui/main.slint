import { AboutSlint, Button, ComboBox, LineEdit, ListView, Palette, ScrollView } from "std-widgets.slint";
import { TrackRow, JamMemberRow, ArtistRow, PlaylistRow, RecommendationRow, LyricRow, HomeBrowseRow } from "model.slint";
import { ControlMotion, Theme, LayoutMetrics, PreferenceRow, SettingsLink, TideSlider, LibraryButton, LibraryTab, NavigationButton, EqualizerBars } from "theme.slint";
import { Cover, PlaylistTile, LoadingTracks, EmptyState, ArtistLink, SongRow, LibraryEntry, HomeCard, ShortcutRow, UpdateAction, SidebarCollection, QuickTile } from "components.slint";
import { QueueDrawer } from "queue.slint";
import { PlayerBar } from "player.slint";
import { LyricsPage } from "lyrics.slint";

export { TrackRow, JamMemberRow, ArtistRow, PlaylistRow, RecommendationRow, LyricRow, HomeBrowseRow, MenuAction } from "model.slint";
export { ControlMotion, Theme, LayoutMetrics } from "theme.slint";

export component AppWindow inherits Window {
    in property <bool> jam-available: false;
    in property <bool> jam-active: false;
    in property <bool> jam-guest: false;
    in property <string> jam-queue-notice;
    in property <string> jam-status;
    in-out property <bool> jam-open: false;
    in-out property <string> jam-endpoint;
    in property <string> jam-invite-code;
    in property <[JamMemberRow]> jam-members;
    in property <bool> jam-locked: false;
    in property <int> jam-listener-id;
    callback jam-toggle-lock();
    callback jam-rotate-invite();
    callback jam-remove-member(int);
    in-out property <string> jam-code-input;
    private property <bool> jam-advanced: false;
    callback jam-host-code();
    callback jam-join-code();
    callback jam-copy-invite();
    callback jam-host();
    callback jam-join();
    callback jam-leave();
    in-out property <length> library-artwork-y;
    in-out property <length> library-artwork-height;
    in-out property <bool> library-grid: true;
    out property <bool> library-tiles: root.library-grid && root.sidebar-profile;
    out property <int> library-columns: root.library-tiles ? root.home-columns : 1;
    out property <int> library-browse-columns: root.library-section == 3 ? 1 : root.library-columns;
    in property <int> library-section: 0;
    in property <[RecommendationRow]> library-cards;
    in property <string> library-note;
    in property <[string]> explore-categories;
    in property <int> explore-category;
    callback select-explore-category(int);
    callback select-library-section(int);
    callback create-playlist(string);
    in-out property <bool> playlist-create-open: false;
    in-out property <string> playlist-create-title;

    callback select-library-card(int);
    callback queue-library-card(int, bool);
    callback toggle-library-view();
    out property <bool> home-artwork-visible: !root.library-open && !root.detail-open && !root.search-open
        && !root.jam-open && !root.lyrics-open && !root.collapsed && !root.minimized;
    in-out property <length> home-artwork-y;
    in-out property <length> home-artwork-height;
    in-out property <length> queue-artwork-y;
    in-out property <length> queue-artwork-height;
    in-out property <length> detail-artwork-y;
    in-out property <length> detail-artwork-height;
    out property <length> detail-row-height: root.detail-is-artist ? LayoutMetrics.artist-track-height : root.detail-has-cover ? LayoutMetrics.collection-row-height : LayoutMetrics.browse-row-height;
    in-out property <length> jam-queue-y;
    in-out property <length> jam-queue-height;
    out property <bool> jam-queue-visible: root.jam-open && root.jam-active && root.wide && !root.collapsed;
    in-out property <length> search-artwork-y;
    in-out property <length> search-artwork-height;
    private property <bool> restore-repaint: false;
    in-out property <int> account-index;
    callback switch-account(int);
    callback connect-account();
    callback native-sign-in();
    callback cancel-native-sign-in();
    callback cancel-account();
    callback media-command(int, float);
    in property <[PlaylistRow]> library-playlists;
    in property <[RecommendationRow]> recommendations;
    in property <[HomeBrowseRow]> home-browse-rows;
    // Derive columns directly from the window, including navigation, padding,
    // queue and scrollbar. A deferred ListView width callback can retain the
    // previous screen's column count when navigating after a resize.
    private property <length> browse-width: max(0px, (root.width - (root.compact-mode || root.width < 900px ? LayoutMetrics.navigation-narrow : LayoutMetrics.navigation-wide) - (root.queue-open && root.width >= 1050px ? 340px : 0px)) - (root.compact-mode ? 36px : 56px) - 16px);
    out property <int> home-columns: max(1, min(6, floor(root.browse-width / 164px)));
    in property <bool> account-connected;
    in property <bool> account-verified;
    in property <bool> error-retryable;
    in property <bool> account-busy;
    in property <bool> native-login-available;
    in property <bool> native-login-busy;
    in property <string> native-login-status;
    in property <string> account-name;
    in property <string> account-status;
    in-out property <bool> library-open: false;
    in-out property <bool> home-open: true;
    in property <string> queue-source;
    in-out property <bool> queue-open: false;
    in-out property <bool> lyrics-open: false;
    out property <bool> lyrics-presented: root.lyrics-open && !root.collapsed && !root.minimized
        && !root.settings-open && !root.account-open && !root.jam-open
        && !root.artist-picker-open && !root.playlist-picker-open;
    in property <bool> lyrics-effects-active: false;
    in property <image> lyrics-backdrop;
    in-out property <bool> lyrics-motion-enabled: true;
    callback lyrics-visibility-changed(bool);
    // Lyrics load for the lyrics page and for Now Playing's live preview.
    out property <bool> lyrics-wanted: root.lyrics-presented || root.now-playing-presented;
    changed lyrics-wanted => { root.lyrics-visibility-changed(root.lyrics-wanted); }
    in property <[LyricRow]> lyrics-lines;
    in property <string> lyrics-sung-prefix;
    in property <int> lyrics-active: -1;
    in property <bool> lyrics-synced;
    in property <string> lyrics-status: "Play a YouTube Music song to see its lyrics.";
    in property <string> lyrics-source;
    in-out property <string> lyrics-generation;
    callback reload-lyrics;
    callback seek-lyric(int);

    in-out property <bool> compact-mode: false;
    in property <bool> autoplay-enabled: false;
    callback toggle-compact();
    callback toggle-autoplay();
    callback shuffle-playlist(int);
    in-out property <bool> related-open: false;
    in property <[TrackRow]> related-rows;
    in property <string> related-note;
    callback load-related();
    callback queue-related(int);
    changed lyrics-generation => { root.related-open = false; }
    changed account-verified => { root.related-open = false; }
    callback play-radio();
    callback remove-queue-track(int);
    callback import-account();
    callback refresh-library();
    callback disconnect-account();
    callback select-library-playlist(int);
    callback play-liked();
    callback open-supermix();
    callback refresh-recommendations();
    callback select-recommendation(int);
    callback open-account-help();
    in property <string> app-version: "0.1.1";
    in-out property <bool> update-panel-open: false;
    in property <[string]> search-suggestions;
    in-out property <bool> suggestions-open: false;
    private property <int> suggestion-index: -1;
    private property <bool> search-field-focused: false;
    private property <bool> suggestions-visible: root.suggestions-open && root.search-suggestions.length > 0
        && !root.collapsed && !root.lyrics-open && !root.settings-open && !root.account-open
        && !root.jam-open && !root.update-panel-open;
    function select-suggestion(value: string) {
        root.suggestions-open = false;
        root.source-input = value;
        root.choose-suggestion(value);
    }
    callback suggest-search(string);
    callback choose-suggestion(string);
    function submit-source(value: string) {
        root.suggestions-open = false;
        if value != "" { root.add-source(value); }
    }
    in property <string> update-status: "Check for a new version of Tide";
    in property <bool> update-busy: false;
    in property <bool> update-available: false;
    in property <bool> update-installable: false;
    in property <bool> auto-update-checks: true;
    callback check-updates();
    callback install-update();
    callback cancel-update();
    in property <int> update-phase: 0;
    in property <float> update-progress: 0;
    callback toggle-update-checks();
    in property <bool> skip-disliked: true;
    callback toggle-skip-disliked();
    in property <bool> media-controls-enabled: true;
    in-out property <string> shortcut-toggle;
    in-out property <string> shortcut-next;
    in-out property <string> shortcut-previous;
    in property <string> shortcut-status: "";
    callback toggle-media-controls();
    in property <bool> close-to-tray: false;
    callback toggle-close-to-tray();
    in property <bool> discord-presence-enabled: false;
    in-out property <string> discord-application-id;
    in property <string> discord-status: "Off — listening activity stays private";
    callback toggle-discord-presence();
    in property <bool> mini-pinned: false;
    in property <float> mini-opacity: 100;
    callback toggle-mini-pin();
    callback change-mini-opacity(float);
    in property <bool> history-feedback-enabled: false;
    in property <string> history-feedback-status;
    callback toggle-history-feedback();
    in property <int> current-rating: 0;
    in property <bool> rating-enabled: false;
    in property <bool> rating-busy: false;
    in property <string> feedback-notice;
    callback rate-song(int);
    callback dismiss-feedback();
    in property <bool> detail-editable: false;
    in property <bool> detail-manageable: false;
    in-out property <int> playlist-manage-mode;
    in-out property <string> playlist-manage-title;
    callback manage-playlist(int, string);
    in property <[bool]> detail-editable-entries;
    in property <bool> detail-playlist-known: false;
    in property <bool> collection-enabled: false;
    in property <bool> collection-busy: false;
    in-out property <bool> playlist-picker-open: false;
    in property <string> playlist-picker-song;
    in property <[PlaylistRow]> playlist-choices;
    in-out property <length> playlist-picker-artwork-y;
    in-out property <length> playlist-picker-artwork-height;
    in property <bool> playlist-choices-busy: false;
    callback add-to-playlist(int, int);
    callback pick-playlist(int);
    callback cancel-playlist-picker();
    callback refresh-playlist-choices();
    callback remove-playlist-song(int);
    callback refresh-detail-playlist();
    in-out property <int> shortcut-recording-index: -1;
    in-out property <bool> settings-audio-open: false;
    in property <bool> normalize-volume: false;
    in property <[string]> audio-device-names;
    in property <int> audio-device-index;
    in property <string> audio-status;
    callback toggle-normalization();
    callback choose-audio-device(int);
    in-out property <bool> settings-shortcuts-open: false;
    in-out property <bool> settings-more-open: false;
    in-out property <length> settings-scroll-y: 0px;
    changed settings-shortcuts-open => { root.settings-scroll-y = 0px; }
    changed settings-audio-open => { root.settings-scroll-y = 0px; }
    callback begin-shortcut(int);
    callback cancel-shortcut();
    callback clear-shortcut(int);
    callback record-shortcut(string, bool, bool, bool, bool);
    in-out property <string> queue-filter;
    in property <[int]> queue-matches;
    callback filter-queue();

    in-out property <string> detail-filter;
    in property <[int]> detail-matches;
    callback filter-detail();

    changed detail-title => { root.detail-filter = ""; root.artist-all-tracks = false; root.artist-release-filter = ""; }
    in property <[TrackRow]> rows;
    in property <int> current-index;
    in property <int> next-queue-index: root.current-index + 1 < root.rows.length ? root.current-index + 1 : -1;
    in property <bool> has-radio-seed;
    out property <bool> can-skip: root.jam-guest || (root.rows.length > 0
        && (root.next-queue-index >= 0
        || (root.has-radio-seed && root.autoplay-enabled && root.account-verified)));
    in property <string> track-title;
    in property <string> track-artist;
    in property <bool> track-artist-enabled;
    in property <string> audio-quality;
    in property <string> playback-hint;
    in property <string> playback-error-action;
    callback open-artist(int, int);
    callback choose-artist(int);
    callback back-detail();
    in property <[ArtistRow]> artist-choices;
    in-out property <bool> artist-picker-open;
    private property <int> artist-choice-index: 0;
    changed artist-picker-open => { root.artist-choice-index = 0; if root.artist-picker-open { app-focus.focus(); } }
    in property <string> track-album;
    in property <image> track-artwork;
    in property <float> position;
    in property <float> duration;
    in property <bool> paused;
    in property <float> volume;
    in property <string> status-text;
    in-out property <string> source-input;
    private property <int> search-focus-revision: 0;
    in-out property <bool> light-mode <=> Theme.light;
    // Most recent searches, newest first, shown under the empty search field.
    in property <[string]> recent-searches;
    callback clear-recent-searches();
    private property <bool> recents-visible: root.search-field-focused && root.source-input == ""
        && root.recent-searches.length > 0 && root.account-connected
        && !root.collapsed && !root.lyrics-open && !root.settings-open && !root.account-open
        && !root.jam-open && !root.update-panel-open;
    // The large, artwork-first view of the current song.
    in-out property <bool> now-playing-open: false;
    out property <bool> now-playing-presented: root.now-playing-open && !root.collapsed && !root.minimized
        && !root.lyrics-open && !root.settings-open && !root.account-open && !root.jam-open;
    // Short fade between browsing pages; runs only when Windows animations are on.
    private property <int> page-key: root.detail-open ? 3 : root.search-open ? 2 : root.library-open ? 1 : 0;
    private property <bool> page-curtain: false;
    changed page-key => { if ControlMotion.enabled { root.page-curtain = true; } }
    // Colours sampled from artwork by the app: the open collection's cover and
    // the current song's cover. The content glow and player take these tints.
    in property <color> detail-tint;
    in property <bool> has-detail-tint: false;
    in property <color> now-tint;
    in property <bool> has-now-tint: false;
    private property <color> hero-color: root.detail-open && root.has-detail-tint ? root.detail-tint
        : !root.detail-open && root.has-now-tint ? root.now-tint : Theme.accent;
    animate hero-color { duration: ControlMotion.enabled ? 420ms : 0ms; easing: ease-in-out; }
    in property <bool> collapsed;
    in property <bool> repeat-enabled;
    callback add-source(string);
    callback select-track(int);
    callback toggle-pause();
    callback next-track();
    callback previous-track();
    callback seek(float);
    in property <int> volume-step-index: 1;
    callback set-volume-step(int);
    callback change-volume(float);
    callback toggle-repeat();
    callback shuffle-queue();
    callback switch-mode();
    in property <bool> follow-windows-theme: false;
    in property <bool> windows-theme-supported: false;
    callback toggle-follow-windows-theme();
    callback poll-windows-theme();
    Timer {
        interval: 1000ms;
        running: root.windows-theme-supported && root.follow-windows-theme;
        triggered => { root.poll-windows-theme(); }
    }
    callback collapse-player();
    callback clear-queue();

    in-out property <bool> detail-open;
    in property <string> detail-title;
    in property <bool> detail-is-artist;
    in property <image> artist-portrait;
    in property <[RecommendationRow]> artist-releases;
    private property <bool> artist-all-tracks: false;
    private property <string> artist-release-filter: "";
    callback open-artist-release(int);
    in property <string> detail-navigation;
    in property <image> detail-cover;
    in property <int> detail-cover-variant;
    in property <bool> detail-has-cover;
    private property <bool> detail-cover-visible: (root.detail-has-cover || root.detail-navigation == "liked" || root.detail-navigation == "radio")
        && !root.detail-is-artist && root.sidebar-profile;
    out property <string> active-navigation: root.jam-open ? "jams" : root.detail-open ? (root.detail-is-artist ? "" : root.detail-navigation) : root.search-open ? "" : root.library-open ? "library" : "home";
    in property <string> detail-note;
    in property <[TrackRow]> detail-rows;
    in property <bool> detail-busy;
    in-out property <bool> search-open;
    in property <[TrackRow]> search-rows;
    in property <[RecommendationRow]> search-cards;
    in-out property <int> search-kind: 0;
    in property <string> search-note;
    callback select-search-kind(int);
    callback select-search-card(int);
    in property <bool> search-busy;
    in property <bool> search-retryable;
    in property <bool> home-refreshing;
    private property <int> search-result-count: root.search-kind == 0 ? root.search-rows.length : root.search-cards.length;
    in property <string> error-message;
    in property <bool> error-is-account;
    in-out property <bool> settings-open: false;
    in-out property <bool> account-open: false;
    in-out property <bool> forward-collection: false;
    private property <bool> forward-search: false;
    changed detail-open => { if root.detail-open { root.forward-collection = false; root.forward-search = false; } }
    changed search-open => { root.forward-collection = false; if root.search-open { root.forward-search = false; } }
    changed source-input => { root.forward-search = false; }
    changed account-busy => { if root.account-busy { root.forward-search = false; } }
    changed library-open => { root.forward-collection = false; root.forward-search = false; }
    changed library-section => { root.forward-collection = false; root.forward-search = false; }
    public function navigate-browse(forward: bool) -> bool {
        if !root.browsing-enabled || root.collapsed || root.playlist-picker-open
            || root.account-open || root.settings-open || root.update-panel-open
            || root.artist-picker-open || root.lyrics-open || root.jam-open
            || root.playlist-manage-mode != 0 || root.playlist-create-open {
            return false;
        }
        if forward {
            if root.detail-open || root.account-busy { return false; }
            if root.forward-collection {
                root.detail-open = true;
                return true;
            }
            if root.forward-search && !root.search-open {
                root.forward-search = false;
                root.search-open = true;
                return true;
            }
        } else if root.detail-open {
            if root.detail-is-artist { root.back-detail(); } else { root.close-detail(); }
            return true;
        } else if root.search-open {
            root.forward-collection = false;
            root.forward-search = !root.search-busy;
            root.close-search();
            return true;
        }
        return false;
    }
    callback close-detail();
    callback close-search();
    callback play-detail();
    callback shuffle-detail();
    callback select-detail-track(int);
    callback select-search-track(int);
    callback queue-detail-track(int, bool);
    callback queue-search-track(int, bool);
    callback queue-recommendation(int, bool);
    callback requeue-track(int, bool);
    callback reorder-queue-track(int, int);
    callback start-track-radio(int, int);
    callback retry-error();
    callback skip-error();
    callback dismiss-error();
    private property <color> foreground: Theme.text;
    private property <color> secondary: Theme.muted;
    private property <color> surface: Theme.surface;
    private property <color> outline: Theme.outline;
    private property <image> current-artwork: root.track-artwork;
    private property <bool> wide: true;
    private property <bool> narrow-navigation: false;
    // The full sidebar shows labels and your playlists; small windows use the rail.
    private property <bool> full-sidebar: !root.compact-mode && !root.narrow-navigation;
    // Time-of-day greeting for Home, supplied by the app.
    in property <string> greeting: "Home";
    // Interface animations (on by default). The app persists the choice.
    in property <bool> animations-enabled: true;
    callback toggle-animations();
    private property <bool> header-branding: true;
    private property <bool> sidebar-profile: false;
    private property <bool> advanced-open: false;
    private property <bool> music-search-enabled: root.account-connected && root.browsing-enabled;
    private property <bool> collection-navigation-enabled: root.account-connected && !root.account-busy
        && !root.settings-open && !root.account-open && !root.artist-picker-open && !root.lyrics-open
        && !(root.queue-open && !root.wide);
    private property <bool> browsing-enabled: !root.settings-open && !root.account-open && !root.artist-picker-open && !root.jam-open && !root.lyrics-open && !(root.queue-open && !root.wide);

    title: "Tide";
    icon: @image-url("assets/tide-icon.png");
    default-font-family: "Segoe UI";
    default-font-size: 14px;
    preferred-width: root.collapsed ? 700px : root.compact-mode ? 780px : 1140px;
    preferred-height: root.collapsed ? 132px : root.compact-mode ? 720px : 800px;
    min-width: 650px;
    min-height: root.collapsed ? (root.jam-active ? 146px : 112px) : 420px;
    background: Theme.window;
    forward-focus: app-focus;
    changed height => { root.sidebar-profile = root.height >= 650px; }
    init => { root.sidebar-profile = root.height >= 650px; Palette.color-scheme = root.light-mode ? light : dark; root.wide = root.width >= 1050px; root.narrow-navigation = root.width < 900px; root.header-branding = root.width >= 780px; }
    changed width => { root.wide = root.width >= 1050px; root.narrow-navigation = root.width < 900px; root.header-branding = root.width >= 780px; }
    changed collapsed => { if root.collapsed { root.suggestions-open = false; root.update-panel-open = false; } }
    changed settings-open => {
        root.settings-scroll-y = 0px;
        if root.settings-open { root.suggestions-open = false; root.playlist-picker-open = false; root.account-open = false; root.jam-open = false; app-focus.focus(); }
        else { root.cancel-shortcut(); root.settings-shortcuts-open = false; root.settings-audio-open = false; root.settings-more-open = false; }
    }
    changed account-open => {
        if root.account-open { root.suggestions-open = false; root.playlist-picker-open = false; root.settings-open = false; root.jam-open = false; app-focus.focus(); }

        else { root.advanced-open = false; }
    }
    changed jam-open => { if root.jam-open { root.suggestions-open = false; root.playlist-picker-open = false; root.settings-open = false; root.account-open = false; app-focus.focus(); } }
    changed playlist-picker-open => { if root.playlist-picker-open { root.settings-open = false; root.account-open = false; root.jam-open = false; root.artist-picker-open = false; app-focus.focus(); } }
    changed queue-open => { if !root.queue-open { root.related-open = false; } if root.queue-open { root.lyrics-open = false; if !root.wide { app-focus.focus(); } } }
    changed lyrics-open => { if root.lyrics-open { root.now-playing-open = false; root.suggestions-open = false; root.update-panel-open = false; root.queue-open = false; root.settings-open = false; root.account-open = false; root.jam-open = false; root.artist-picker-open = false; root.playlist-picker-open = false; app-focus.focus(); } }
    changed wide => { if !root.wide && (root.queue-open || root.lyrics-open) { app-focus.focus(); } }
    changed light-mode => { Palette.color-scheme = root.light-mode ? light : dark; }

    // Windows may discard the software-rendered window contents on minimize
    // without reporting a zero-sized surface. A redraw alone then has no dirty
    // pixels to present. Toggle an identical, full-window background on restore
    // to invalidate the entire scene, without resizing or changing its colors.
    changed minimized => {
        if !root.minimized { root.restore-repaint = !root.restore-repaint; }
    }
    Rectangle {
        width: root.width;
        height: root.height;
        background: root.background;
        visible: root.restore-repaint;
    }

    app-focus := FocusScope {
        // The window provides its sizing rules. Descendant responsive branches
        // must not become a constraint on the window width they inspect.
        min-width: 0px; preferred-width: 0px; max-width: 10000px;
        min-height: 0px; preferred-height: 0px; max-height: 10000px;
        focus-lost(reason) => { if root.shortcut-recording-index >= 0 { root.cancel-shortcut(); } }
        capture-key-pressed(event) => {
            if root.shortcut-recording-index >= 0 {
                if event.text == Key.Escape { root.cancel-shortcut(); }
                else { root.record-shortcut(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta); }
                return accept;
            }
            if root.search-field-focused && root.suggestions-visible {
                if event.text == Key.DownArrow {
                    root.suggestion-index = (root.suggestion-index + 1) < root.search-suggestions.length ? root.suggestion-index + 1 : 0;
                    return accept;
                }
                if event.text == Key.UpArrow {
                    root.suggestion-index = root.suggestion-index > 0 ? root.suggestion-index - 1 : root.search-suggestions.length - 1;
                    return accept;
                }
                if event.text == Key.Return && root.suggestion-index >= 0 && root.suggestion-index < root.search-suggestions.length {
                    root.select-suggestion(root.search-suggestions[root.suggestion-index]);
                    return accept;
                }
            }
            if event.modifiers.alt && !event.modifiers.control && !event.modifiers.shift && !event.modifiers.meta {
                if event.text == Key.LeftArrow && root.navigate-browse(false) { return accept; }
                if event.text == Key.RightArrow && root.navigate-browse(true) { return accept; }
            }
            if event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta {
                if (event.text == "k" || event.text == "K") && root.music-search-enabled { root.search-focus-revision += 1; return accept; }
                if (event.text == "l" || event.text == "L") && !root.settings-open && !root.account-open && !root.artist-picker-open && !root.collapsed { root.lyrics-open = !root.lyrics-open; return accept; }
            }
            return reject;
        }
        key-pressed(event) => {
            if root.artist-picker-open {
                if event.text == Key.Escape { root.back-detail(); return accept; }
                if event.text == Key.DownArrow || event.text == Key.Tab { root.artist-choice-index = root.artist-choice-index < root.artist-choices.length - 1 ? root.artist-choice-index + 1 : 0; return accept; }
                if event.text == Key.UpArrow { root.artist-choice-index = root.artist-choice-index > 0 ? root.artist-choice-index - 1 : max(0, root.artist-choices.length - 1); return accept; }
                if event.text == Key.Return || event.text == " " { root.choose-artist(root.artist-choice-index); return accept; }
            }
            if event.text == Key.Escape {
                if root.update-panel-open { root.update-panel-open = false; return accept; }
                if root.suggestions-open { root.suggestions-open = false; return accept; }
                if root.playlist-picker-open { root.cancel-playlist-picker(); return accept; }
                if root.jam-open { root.jam-open = false; return accept; }
                if root.settings-open { root.settings-open = false; return accept; }
                if root.account-open { root.account-open = false; return accept; }
                if root.lyrics-open { root.lyrics-open = false; return accept; }
                if root.now-playing-open { root.now-playing-open = false; return accept; }
                if root.queue-open { root.queue-open = false; return accept; }
                if root.playlist-manage-mode != 0 { root.playlist-manage-mode = 0; return accept; }
                if root.detail-open {
                    if root.detail-is-artist { root.back-detail(); } else { root.close-detail(); }
                    return accept;
                }
                if root.search-open { root.close-search(); return accept; }
            }
            if !event.modifiers.control && !event.modifiers.alt
                && !event.modifiers.shift && !event.modifiers.meta
                && root.current-index >= 0 && !root.search-field-focused && !root.jam-guest && !root.settings-open
                && !root.account-open && !root.update-panel-open && !root.playlist-picker-open
                && !root.playlist-create-open && root.playlist-manage-mode == 0 {
                if event.text == " " {
                    if !event.repeat { root.toggle-pause(); }
                    return accept;
                }
                if root.duration > 0 && (event.text == "j" || event.text == "l") {
                    if !event.repeat {
                        root.seek(clamp(root.position + (event.text == "j" ? -10 : 10), 0, root.duration));
                    }
                    return accept;
                }
            }
            return reject;
        }
        VerticalLayout {
            spacing: 0px;
            if !root.collapsed && !root.lyrics-open : Rectangle {
                height: 64px;
                // The window owns its minimum width. Header breakpoints must
                // not feed the current window width back into layout hints.
                min-width: 0px; preferred-width: 0px; max-width: 10000px;
                background: Theme.window;
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    spacing: 10px;
                    cross-axis-alignment: center;
                    Image { width: 32px; height: 32px; source: @image-url("assets/tide-icon.png"); image-fit: contain; }
                    if root.header-branding : Text { width: 56px; text: "Tide"; color: root.foreground; font-size: 21px; font-weight: 700; }
                    if root.account-connected : search-pill := Rectangle {
                        in property <int> focus-revision: root.search-focus-revision;
                        changed focus-revision => { search-input.focus(); }
                        horizontal-stretch: 1;
                        height: 38px;
                        border-radius: self.height / 2;
                        background: search-input.has-focus ? Theme.surface : search-hover.has-hover ? Theme.hover : Theme.raised;
                        border-width: search-input.has-focus ? 2px : 1px;
                        border-color: search-input.has-focus ? Theme.focus : Theme.outline;
                        opacity: root.browsing-enabled ? 1 : 0.6;
                        animate background { duration: ControlMotion.feedback; easing: ease-out; }
                        search-hover := TouchArea { mouse-cursor: MouseCursor.text; clicked => { search-input.focus(); } }
                        Path {
                            x: 14px; y: (parent.height - self.height) / 2; width: 17px; height: 17px;
                            viewbox-width: 24; viewbox-height: 24; fill: transparent;
                            stroke: search-input.has-focus ? Theme.text : Theme.muted; stroke-width: 1.8px;
                            commands: "M 10.5 3 A 7.5 7.5 0 1 0 10.5 18 A 7.5 7.5 0 1 0 10.5 3 Z M 16 16 L 22 22";
                        }
                        Rectangle {
                            x: 42px; width: max(0px, parent.width - self.x - (root.source-input != "" ? 40px : 14px)); height: parent.height;
                            clip: true;
                            search-input := TextInput {
                                width: parent.width; height: parent.height;
                                vertical-alignment: center; single-line: true;
                                color: Theme.text; selection-background-color: Theme.accent.with-alpha(0.3);
                                font-size: 13px;
                                enabled: root.browsing-enabled;
                                text <=> root.source-input;
                                accessible-role: text-input;
                                accessible-label: "Search music or paste a YouTube link";
                                changed has-focus => { root.search-field-focused = self.has-focus; }
                                edited => { root.suggestion-index = -1; root.suggestions-open = true; root.suggest-search(self.text); }
                                accepted => { root.submit-source(self.text); }
                            }
                            if root.source-input == "" : Text {
                                width: parent.width; height: parent.height;
                                text: "What do you want to listen to?"; color: Theme.muted; font-size: 13px;
                                vertical-alignment: center; overflow: elide;
                            }
                        }
                        if root.source-input != "" : LibraryButton {
                            x: parent.width - self.width - 5px; y: (parent.height - self.height) / 2;
                            width: 28px; height: 28px; round: true; caption: "×"; label: "Clear search";
                            light-mode: root.light-mode;
                            clicked => { root.source-input = ""; root.suggestions-open = false; search-input.focus(); }
                        }
                    }
                    if !root.account-connected : Rectangle { horizontal-stretch: 1; }
                    if root.account-connected : LibraryButton { width: 36px; height: 36px; show-tooltip: true; light-mode: root.light-mode; enabled: root.music-search-enabled; icon-path: "M 10.5 3 A 7.5 7.5 0 1 0 10.5 18 A 7.5 7.5 0 1 0 10.5 3 Z M 16 16 L 22 22"; label: "Search for music or open the pasted link"; clicked => { root.submit-source(root.source-input); } }
                    LibraryButton { width: 36px; height: 36px; show-tooltip: true; enabled: !root.artist-picker-open; light-mode: root.light-mode; icon-kind: root.light-mode ? "moon" : "sun"; label: root.light-mode ? "Switch to dark theme" : "Switch to light theme"; clicked => { root.switch-mode(); } }
                    LibraryButton { width: 36px; height: 36px; show-tooltip: true; quiet: true; enabled: !root.artist-picker-open; light-mode: root.light-mode; icon-path: "M 9 4 L 9.5 2 L 14.5 2 L 15 4 L 17 5 L 19 4.5 L 21.5 9 L 20 10.5 L 20 13.5 L 21.5 15 L 19 19.5 L 17 19 L 15 20 L 14.5 22 L 9.5 22 L 9 20 L 7 19 L 5 19.5 L 2.5 15 L 4 13.5 L 4 10.5 L 2.5 9 L 5 4.5 L 7 5 Z M 12 8 A 4 4 0 1 0 12 16 A 4 4 0 1 0 12 8 Z"; label: "Open settings"; active: root.settings-open; clicked => { root.settings-open = !root.settings-open; } }
                    LibraryButton { width: 36px; height: 36px; show-tooltip: true; quiet: true; enabled: !root.artist-picker-open && !root.jam-guest; light-mode: root.light-mode; icon-path: "M 12 2 A 10 10 0 1 0 12 22 A 10 10 0 1 0 12 2 Z M 12 6 A 3 3 0 1 0 12 12 A 3 3 0 1 0 12 6 Z M 5 19 C 5 12 19 12 19 19"; label: "Open YouTube Music account"; active: root.account-open; clicked => { root.account-open = !root.account-open; } }

                }
            }
            if !root.collapsed : content-area := Rectangle {
                vertical-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                max-width: 10000px;
                horizontal-stretch: 1;
                HorizontalLayout {
                    visible: !root.lyrics-open;
                    spacing: 0px;
                    Rectangle {
                        width: root.full-sidebar ? LayoutMetrics.navigation-wide : LayoutMetrics.navigation-narrow;
                        background: transparent;
                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 18px;
                            spacing: 8px;
                            NavigationButton { wide: root.full-sidebar; light-mode: root.light-mode; enabled: root.browsing-enabled || root.jam-open; active: root.active-navigation == "home"; library: false; clicked => { root.jam-open = false; root.playlist-picker-open = false; root.library-open = false; root.home-open = true; root.close-detail(); root.close-search(); root.forward-collection = false; } }
                            NavigationButton { wide: root.full-sidebar; light-mode: root.light-mode; enabled: root.browsing-enabled || root.jam-open; active: root.active-navigation == "library"; library: true; clicked => { root.jam-open = false; root.playlist-picker-open = false; root.library-open = true; root.home-open = false; root.close-detail(); root.close-search(); root.forward-collection = false; } }
                            if root.jam-available : NavigationButton { wide: root.full-sidebar; light-mode: root.light-mode; jam: true; jam-active: root.jam-active; active: root.jam-open; enabled: !root.artist-picker-open; clicked => { root.jam-open = !root.jam-open; } }
                            // Icon rail: Liked and Supermix as rail items.
                            if !root.full-sidebar && root.sidebar-profile && !root.compact-mode : VerticalLayout {
                                spacing: 8px; padding-top: 16px;
                                NavigationButton { liked: true; active: root.active-navigation == "liked"; light-mode: root.light-mode; enabled: root.collection-navigation-enabled; clicked => { root.play-liked(); } }
                                NavigationButton { mix: true; active: root.active-navigation == "supermix"; light-mode: root.light-mode; enabled: root.collection-navigation-enabled; clicked => { root.open-supermix(); } }
                            }
                            // Full sidebar: your music, with playlists as a scrolling list.
                            if root.full-sidebar && root.account-connected : VerticalLayout {
                                vertical-stretch: 1;
                                spacing: 2px;
                                Rectangle { height: 17px; Rectangle { x: 10px; y: 8px; width: parent.width - 20px; height: 1px; background: Theme.divider; } }
                                Text { height: 26px; x: 12px; text: "YOUR MUSIC"; color: Theme.muted; font-size: 10px; font-weight: 700; letter-spacing: 0.8px; vertical-alignment: center; }
                                SidebarCollection { title: "Liked Songs"; subtitle: "Auto playlist"; kind: "liked"; active: root.active-navigation == "liked"; enabled: root.collection-navigation-enabled; light-mode: root.light-mode; open => { root.play-liked(); } }
                                SidebarCollection { title: "My Supermix"; subtitle: "Made for you"; kind: "mix"; active: root.active-navigation == "supermix"; enabled: root.collection-navigation-enabled; light-mode: root.light-mode; open => { root.open-supermix(); } }
                                if root.library-playlists.length > 0 : ListView {
                                    vertical-stretch: 1;
                                    accessible-label: "Your playlists";
                                    horizontal-scrollbar-policy: always-off;
                                    for row[index] in root.library-playlists : SidebarCollection {
                                        title: row.title; subtitle: row.subtitle; kind: "playlist"; variant: row.cover-variant; artwork: row.artwork;
                                        active: root.detail-open && !root.detail-is-artist && root.detail-title == row.title;
                                        enabled: root.collection-navigation-enabled; light-mode: root.light-mode;
                                        open => { root.select-library-playlist(index); }
                                    }
                                }
                            }
                            if !(root.full-sidebar && root.account-connected) : Rectangle { vertical-stretch: 1; }
                            HorizontalLayout {
                                height: 40px; alignment: root.full-sidebar ? stretch : center;
                                LibraryButton {
                                    width: root.full-sidebar ? parent.width : 48px; height: 40px;
                                    caption-start: root.full-sidebar; caption-size: root.full-sidebar ? 14px : 12px;
                                    show-tooltip: true; quiet: !root.update-available && root.update-phase == 0;
                                    light-mode: root.light-mode; active: root.update-panel-open || root.update-phase == 2;
                                    notification: root.update-available && root.update-phase == 0;
                                    caption: root.update-phase == 1 ? root.update-progress.to-fixed(0) + "%"
                                        : root.full-sidebar ? (root.update-phase == 2 ? "Restart to update" : root.update-available ? "Update available" : "Updates") : "";
                                    leading-icon: root.full-sidebar && root.update-phase != 1 ? (root.update-phase == 2 ? "M5 12 L10 17 L19 7" : "M12 3 V15 M7 10 L12 15 L17 10 M5 17 V21 H19 V17") : "";
                                    icon-path: root.full-sidebar || root.update-phase == 1 ? "" : root.update-phase == 2 ? "M5 12 L10 17 L19 7" : "M12 3 V15 M7 10 L12 15 L17 10 M5 17 V21 H19 V17";
                                    label: root.update-phase == 2 ? "Tide update ready" : (root.update-available ? "Tide update available" : "Tide updates");
                                    clicked => {
                                        root.suggestions-open = false; root.update-panel-open = true;
                                        app-focus.focus();
                                    }
                                }
                            }
                            Rectangle { height: 4px; }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.surface;
                        border-top-left-radius: 14px;
                        clip: true;
                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: 300px;
                            background: @linear-gradient(180deg, root.hero-color.with-alpha(Theme.light ? 0.2 : 0.3) 0%, root.hero-color.with-alpha(0) 100%);
                        }
                        // Covers the panel for one frame when the page changes, then
                        // fades away so the new page appears smoothly. No input.
                        Timer { interval: 16ms; running: root.page-curtain; triggered => { root.page-curtain = false; } }
                        VerticalLayout {
                            x: 0px;
                            width: parent.width;
                            height: parent.height;
                            padding: root.compact-mode || !root.sidebar-profile ? 18px : 28px;
                            spacing: 12px;
                            if root.error-message != "" : Rectangle {
                                height: root.narrow-navigation ? 92px : 58px;
                                border-radius: 8px;
                                background: root.light-mode ? #ecd7cc : #39252a;
                                HorizontalLayout {
                                    padding: 10px;
                                    spacing: 10px;
                                    cross-axis-alignment: center;
                                    Text { horizontal-stretch: 1; text: root.error-message; color: root.foreground; font-size: 12px; wrap: word-wrap; overflow: elide; accessible-live-region: assertive; }
                                    LibraryButton { width: root.error-is-account || root.playback-error-action != "" ? 128px : 70px; light-mode: root.light-mode; caption: root.error-is-account ? "Account settings" : root.error-retryable ? (root.playback-error-action != "" ? root.playback-error-action : "Retry") : "Dismiss"; enabled: root.browsing-enabled; label: root.error-is-account ? "Open account settings to resolve the connection problem" : root.error-retryable ? "Retry interrupted playback or recommendations" : "Dismiss this error"; clicked => { root.retry-error(); } }
                                    if root.playback-error-action != "" && !root.jam-guest : LibraryButton { width: 56px; caption: "Skip"; label: "Skip this failed song"; light-mode: root.light-mode; enabled: root.browsing-enabled && root.can-skip; clicked => { root.skip-error(); } }
                                    LibraryButton { width: 28px; caption: "×"; label: "Dismiss error"; light-mode: root.light-mode; clicked => { root.dismiss-error(); } }
                                }
                            }
                            if root.detail-open : VerticalLayout {
                                spacing: 12px;
                                if root.detail-is-artist : Rectangle {
                                    height: root.browse-width >= 650px && root.height >= 680px ? 172px : 118px;
                                    border-radius: 12px;
                                    background: @linear-gradient(110deg, root.light-mode ? #e9d9d4 : #392936, root.light-mode ? #f5eeea : #12151a);
                                    HorizontalLayout {
                                        padding: 18px; spacing: 18px; cross-axis-alignment: center;
                                        Cover { width: parent.height - 36px; height: self.width; border-radius: self.width / 2; artwork: root.artist-portrait; light-mode: root.light-mode; }
                                        VerticalLayout {
                                            horizontal-stretch: 1; min-width: 0px; spacing: 5px; alignment: center;
                                            Text { text: "Artist"; color: root.secondary; font-size: 13px; }
                                            Text { text: root.detail-title; color: root.foreground; font-size: root.browse-width >= 650px ? 46px : 28px; font-weight: 700; overflow: elide; }
                                        }
                                        LibraryButton { width: 36px; show-tooltip: true; light-mode: root.light-mode; enabled: root.browsing-enabled; icon-path: "M 20 12 L 4 12 M 10 6 L 4 12 L 10 18"; label: "Back from artist page"; clicked => { root.back-detail(); } }
                                    }
                                }
                                if !root.detail-is-artist : HorizontalLayout {
                                    height: root.detail-cover-visible ? 180px : 48px;
                                    spacing: 16px;
                                    cross-axis-alignment: center;
                                    if root.detail-cover-visible && root.detail-navigation != "liked" : Cover { width: 168px; height: 168px; artwork: root.detail-cover; variant: root.detail-cover-variant; playlist: true; light-mode: root.light-mode; drop-shadow-blur: 24px; drop-shadow-offset-y: 8px; drop-shadow-color: Theme.shadow; }
                                    if root.detail-cover-visible && root.detail-navigation == "liked" : Rectangle {
                                        width: 168px; height: 168px; border-radius: 7px;
                                        background: @linear-gradient(135deg, #c43f68 0%, #6a3fb5 100%);
                                        drop-shadow-blur: 24px; drop-shadow-offset-y: 8px; drop-shadow-color: Theme.shadow;
                                        Path {
                                            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                            width: 64px; height: 64px; viewbox-width: 24; viewbox-height: 24;
                                            fill: #ffffff; stroke: #ffffff;
                                            commands: "M 12 20 C 4 14 2 10 4 7 C 6 4 10 4 12 8 C 14 4 18 4 20 7 C 22 10 20 14 12 20 Z";
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1; min-width: 0px; spacing: 10px; alignment: center;
                                        Text { text: root.detail-title; color: root.foreground; font-size: root.detail-cover-visible ? 48px : 26px; font-weight: 800; overflow: elide; } Text { text: root.detail-busy ? (root.detail-is-artist ? "Loading top songs…" : root.detail-navigation == "supermix" ? "Finding your mix on YouTube Music…" : "Loading tracks…") : root.detail-is-artist ? "Top songs · " + root.detail-rows.length + " songs" : root.detail-filter != "" ? "" + root.detail-matches.length + " of " + root.detail-rows.length + " tracks" : "" + root.detail-rows.length + " tracks"; color: root.secondary; font-size: 13px; }
                                        if root.detail-cover-visible : HorizontalLayout {
                                            height: 52px; spacing: 14px; alignment: start; cross-axis-alignment: center;
                                            LibraryButton { width: 52px; height: 52px; round: true; show-tooltip: true; light-mode: root.light-mode; icon-path: "M 7 4 L 20 12 L 7 20 Z"; label: "Play " + root.detail-title; active: true; enabled: !root.jam-guest && root.browsing-enabled && !root.detail-busy && root.detail-rows.length > 0; clicked => { root.play-detail(); } }
                                            LibraryButton { width: 44px; height: 44px; round: true; quiet: true; show-tooltip: true; light-mode: root.light-mode; icon-path: "M 3 6 L 7 6 C 11 6 13 18 17 18 L 21 18 M 17 14 L 21 18 L 17 22 M 3 18 L 7 18 C 11 18 13 6 17 6 L 21 6 M 17 2 L 21 6 L 17 10"; label: "Shuffle " + root.detail-title; enabled: !root.jam-guest && root.browsing-enabled && !root.detail-busy && root.detail-rows.length > 0; clicked => { root.shuffle-detail(); } }
                                        }
                                    }
                                    LibraryButton { width: 36px; show-tooltip: true; light-mode: root.light-mode; enabled: root.browsing-enabled; icon-path: "M 20 12 L 4 12 M 10 6 L 4 12 L 10 18"; label: root.detail-is-artist ? "Back from artist page" : "Back from collection details"; clicked => { if root.detail-is-artist { root.back-detail(); } else { root.close-detail(); } } }
                                }
                                if root.detail-is-artist : HorizontalLayout {
                                    height: 48px; spacing: 12px; cross-axis-alignment: center;
                                    LibraryButton { width: 48px; height: 48px; round: true; active: true; light-mode: root.light-mode; show-tooltip: true; icon-path: "M 7 4 L 20 12 L 7 20 Z"; label: "Play top songs"; enabled: !root.jam-guest && root.browsing-enabled && !root.detail-busy && root.detail-rows.length > 0; clicked => { root.play-detail(); } }
                                    Text { horizontal-stretch: 1; text: "Popular"; color: root.foreground; font-size: 23px; font-weight: 650; vertical-alignment: center; }
                                }
                                if !root.detail-is-artist : HorizontalLayout {
                                    height: 36px;
                                    spacing: 8px;
                                    if !root.detail-cover-visible : LibraryButton { width: root.detail-cover-visible ? 100px : 36px; round: !root.detail-cover-visible; show-tooltip: true; light-mode: root.light-mode; caption: root.detail-cover-visible ? "Play" : "▶"; leading-icon: root.detail-cover-visible ? "M 7 4 L 20 12 L 7 20 Z" : ""; label: "Play " + root.detail-title; active: true; enabled: !root.jam-guest && root.browsing-enabled && !root.detail-busy && root.detail-rows.length > 0; clicked => { root.play-detail(); } }
                                    if !root.detail-cover-visible : LibraryButton { width: root.detail-cover-visible ? 104px : 36px; show-tooltip: true; light-mode: root.light-mode; caption: root.detail-cover-visible ? "Shuffle" : "⇄"; leading-icon: root.detail-cover-visible ? "M 3 6 L 7 6 C 11 6 13 18 17 18 L 21 18 M 17 14 L 21 18 L 17 22 M 3 18 L 7 18 C 11 18 13 6 17 6 L 21 6 M 17 2 L 21 6 L 17 10" : ""; label: "Shuffle " + root.detail-title; enabled: !root.jam-guest && root.browsing-enabled && !root.detail-busy && root.detail-rows.length > 0; clicked => { root.shuffle-detail(); } }
                                    if root.detail-playlist-known : LibraryButton { width: 36px; show-tooltip: true; light-mode: root.light-mode; icon-path: "M 20 7 L 20 3 M 20 7 L 16 7 M 20 7 A 9 9 0 1 0 21 14"; label: "Refresh this playlist from YouTube Music"; enabled: root.browsing-enabled && !root.account-busy && !root.collection-busy; clicked => { root.refresh-detail-playlist(); } }
                                    if root.detail-manageable : LibraryButton {
                                        width: 36px; height: 36px; show-tooltip: true; light-mode: root.light-mode;
                                        icon-path: "M 4 16 L 16 4 L 20 8 L 8 20 L 4 20 Z M 13 7 L 17 11";
                                        label: "Rename playlist"; enabled: root.browsing-enabled && root.collection-enabled && !root.collection-busy && !root.detail-busy;
                                        clicked => { root.playlist-manage-title = root.detail-title; root.playlist-manage-mode = 1; }
                                    }
                                    if root.detail-manageable : LibraryButton {
                                        width: 36px; height: 36px; show-tooltip: true; light-mode: root.light-mode;
                                        icon-path: "M 3 6 L 21 6 M 9 6 L 9 3 L 15 3 L 15 6 M 6 6 L 7 21 L 17 21 L 18 6 M 10 10 L 10 17 M 14 10 L 14 17";
                                        label: "Delete playlist"; enabled: root.browsing-enabled && root.collection-enabled && !root.collection-busy && !root.detail-busy;
                                        clicked => { root.playlist-manage-mode = 2; }
                                    }
                                    LineEdit { horizontal-stretch: 1; height: 34px; text <=> root.detail-filter; edited => { root.filter-detail(); } placeholder-text: root.detail-is-artist ? "Find a song" : "Find in this playlist"; accessible-label: "Filter this list by title, artist or album"; }
                                    if root.detail-filter != "" : LibraryButton { width: 30px; height: 30px; caption: "×"; label: "Clear list search"; light-mode: root.light-mode; clicked => { root.detail-filter = ""; root.filter-detail(); } }
                                }
                                if root.detail-manageable && root.playlist-manage-mode != 0 : HorizontalLayout {
                                    height: 36px; spacing: 8px;
                                    if root.playlist-manage-mode == 1 : LineEdit {
                                        horizontal-stretch: 1; text <=> root.playlist-manage-title;
                                        accessible-label: "New name for this playlist";
                                    }
                                    if root.playlist-manage-mode == 2 : Text {
                                        horizontal-stretch: 1; min-width: 0px; wrap: word-wrap; overflow: elide;
                                        vertical-alignment: center; font-size: 12px; color: root.foreground;
                                        text: "Permanently delete this playlist from YouTube Music?";
                                    }
                                    LibraryButton {
                                        width: 76px; height: 36px; active: true; light-mode: root.light-mode;
                                        caption: root.playlist-manage-mode == 1 ? "Save name" : "Delete";
                                        label: root.playlist-manage-mode == 1 ? "Save new playlist name" : "Confirm permanent playlist deletion";
                                        enabled: root.browsing-enabled && root.collection-enabled && !root.collection-busy && !root.detail-busy
                                            && (root.playlist-manage-mode == 2 || root.playlist-manage-title != "");
                                        clicked => { root.manage-playlist(root.playlist-manage-mode, root.playlist-manage-title); }
                                    }
                                    LibraryButton {
                                        width: 72px; height: 36px; light-mode: root.light-mode;
                                        caption: "Cancel"; label: "Cancel playlist change";
                                        clicked => { root.playlist-manage-mode = 0; }
                                    }
                                }
                                if root.detail-note != "" && (!root.detail-is-artist || root.detail-rows.length == 0) : Text { text: root.detail-note; color: root.secondary; font-size: 12px; wrap: word-wrap; }
                                if root.detail-has-cover && !root.detail-is-artist && root.detail-rows.length > 0 : Rectangle {
                                    height: 30px;
                                    HorizontalLayout {
                                        padding-left: 10px; padding-right: 10px; spacing: 10px;
                                        Text { width: 28px; text: "#"; horizontal-alignment: center; color: root.secondary; font-size: 13px; vertical-alignment: center; }
                                        Rectangle { width: 42px; }
                                        Text { horizontal-stretch: 1; text: "Title"; color: root.secondary; font-size: 13px; vertical-alignment: center; }
                                        if parent.width >= 700px : Text { width: parent.width * 0.3; text: "Album"; color: root.secondary; font-size: 13px; vertical-alignment: center; }
                                        Rectangle {
                                            width: 52px;
                                            Path {
                                                x: parent.width - self.width; y: (parent.height - self.height) / 2;
                                                width: 15px; height: 15px; viewbox-width: 24; viewbox-height: 24;
                                                stroke: root.secondary; stroke-width: 1.8px; fill: transparent;
                                                commands: "M 21 12 A 9 9 0 1 1 3 12 A 9 9 0 1 1 21 12 Z M 12 7 L 12 12 L 15 14";
                                            }
                                        }
                                        Rectangle { width: root.jam-guest ? 70px : 30px; }
                                    }
                                    Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: root.outline; }
                                }
                                if !root.detail-is-artist && root.detail-rows.length > 0 && (root.detail-filter == "" || root.detail-matches.length > 0) : ListView {
                                    content-y <=> root.detail-artwork-y;
                                    changed visible-height => { root.detail-artwork-height = self.visible-height; }
                                    vertical-stretch: 1;
                                    accessible-label: "Tracks in " + root.detail-title;
                                    for visible-index in (root.detail-filter == "" ? root.detail-rows.length : root.detail-matches.length) : SongRow {
                                        private property <int> source-index: root.detail-filter == "" ? visible-index : root.detail-matches[visible-index]; collection-row: root.detail-has-cover && !root.detail-is-artist; shared-queue: root.jam-guest; collection-enabled: root.collection-enabled && !root.collection-busy; playlist-removable: root.detail-editable && self.source-index < root.detail-editable-entries.length && root.detail-editable-entries[self.source-index]; enabled: root.browsing-enabled; track: root.detail-rows[self.source-index]; index: self.source-index; light-mode: root.light-mode; now-playing: root.current-index >= 0 && self.track.title == root.track-title && self.track.artist == root.track-artist; live: !root.paused; select => { root.select-detail-track(self.source-index); } queue(next) => { root.queue-detail-track(self.source-index, next); } radio => { root.start-track-radio(1, self.source-index); } artist => { root.open-artist(1, self.source-index); } add-playlist => { root.add-to-playlist(1, self.source-index); } remove-playlist => { root.remove-playlist-song(self.source-index); } }
                                }
                                if root.detail-is-artist && (root.detail-rows.length > 0 || root.artist-releases.length > 0) : ScrollView {
                                    content-y <=> root.detail-artwork-y;
                                    horizontal-scrollbar-policy: always-off;
                                    changed visible-height => { root.detail-artwork-height = self.visible-height; }
                                    vertical-stretch: 1;
                                    VerticalLayout {
                                        width: parent.width;
                                        for visible-index in (root.artist-all-tracks ? root.detail-rows.length : min(5, root.detail-rows.length)) : SongRow {
                                            private property <int> source-index: visible-index; ranked: true; shared-queue: root.jam-guest; collection-enabled: root.collection-enabled && !root.collection-busy; enabled: root.browsing-enabled; track: root.detail-rows[self.source-index]; index: self.source-index; light-mode: root.light-mode; now-playing: root.current-index >= 0 && self.track.title == root.track-title && self.track.artist == root.track-artist; live: !root.paused; select => { root.select-detail-track(self.source-index); } queue(next) => { root.queue-detail-track(self.source-index, next); } radio => { root.start-track-radio(1, self.source-index); } artist => { root.open-artist(1, self.source-index); } add-playlist => { root.add-to-playlist(1, self.source-index); } }
                                        if root.detail-rows.length > 5 : HorizontalLayout {
                                            height: 34px; alignment: start;
                                            LibraryButton { width: 108px; caption: root.artist-all-tracks ? "Show less" : "See more"; label: self.caption; light-mode: root.light-mode; clicked => { root.artist-all-tracks = !root.artist-all-tracks; } }
                                        }
                                        if root.artist-releases.length > 0 : VerticalLayout {
                                            spacing: 8px; padding-top: 12px;
                                            Text { height: 30px; text: "Discography"; color: root.foreground; font-size: 23px; font-weight: 650; }
                                            HorizontalLayout {
                                                height: 34px; spacing: 8px; alignment: start;
                                                for label in ["All", "Albums", "Singles & EPs"] : LibraryButton {
                                                    width: label == "Singles & EPs" ? 116px : 76px; caption: label; label: label; light-mode: root.light-mode;
                                                    active: root.artist-release-filter == (label == "All" ? "" : label);
                                                    clicked => { root.artist-release-filter = label == "All" ? "" : label; release-scroll.content-x = 0px; }
                                                }
                                            }
                                            release-scroll := ScrollView {
                                                vertical-scrollbar-policy: always-off;
                                                height: LayoutMetrics.library-tile-height;
                                                content-width: max(self.visible-width, release-shelf.min-width);
                                                release-shelf := HorizontalLayout {
                                                    width: parent.width; spacing: 12px; alignment: start;
                                                    for release[index] in root.artist-releases : HorizontalLayout {
                                                        if root.artist-release-filter == "" || root.artist-release-filter == release.shelf : PlaylistTile {
                                                            width: 172px; height: LayoutMetrics.library-tile-height; collection-kind: "album";
                                                            title: release.title; subtitle: release.shelf; artwork: release.artwork; light-mode: root.light-mode;
                                                            enabled: root.browsing-enabled && !root.account-busy;
                                                            open => { root.open-artist-release(index); }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if root.detail-filter != "" && root.detail-matches.length == 0 && root.detail-rows.length > 0 : EmptyState { vertical-stretch: 1; light-mode: root.light-mode; heading: "No matching songs"; detail: "Clear the search to see the full list."; }
                                if root.detail-busy && root.detail-rows.length == 0 : LoadingTracks { placeholder-color: root.outline; }
                                if !root.detail-busy && root.detail-rows.length == 0 && (!root.detail-is-artist || root.artist-releases.length == 0) : EmptyState {
                                    vertical-stretch: 1; light-mode: root.light-mode;
                                    heading: root.detail-is-artist ? "No top songs available" : "No tracks to show";
                                    detail: root.detail-is-artist ? "Try another artist, or go back to your music." : "Choose another playlist from your Library.";
                                }
