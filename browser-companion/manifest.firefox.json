{
  "manifest_version": 2,
  "name": "Tide session companion (prototype)",
  "version": "0.1.0",
  "description": "Explicitly import one YouTube Music session into the local Tide native host.",
  "permissions": [
    "activeTab",
    "webRequest",
    "nativeMessaging",
    "https://music.youtube.com/*"
  ],
  "background": {
    "scripts": [
      "background.js",
      "background-firefox.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Tide session companion",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tide-session@tide-music"
    }
  },
  "content_security_policy": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src 'none'",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
